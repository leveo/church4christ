# Copy to .dev.vars (gitignored) and fill in real values.

# HS256 secret for the session JWT cookie. Any long random string locally;
# production uses `npx wrangler secret put SESSION_SECRET`.
SESSION_SECRET=dev-only-secret-change-me

# HMAC key for public Newcomer rate-limit buckets. Never place the value in
# wrangler.jsonc or logs; production uses `npx wrangler secret put`.
NEWCOMER_RATE_LIMIT_SECRET=dev-only-newcomer-rate-limit-secret-change-me

# AES-256-GCM key ring for encrypted Learning provider credentials. The value is
# strict JSON: {"currentVersion":1,"keys":{"1":"<32-byte canonical base64>"}}.
# Generate keys outside the repository and never paste the value into
# wrangler.jsonc, logs, fixtures, or screenshots. Production uses
# `npx wrangler secret put LEARNING_CREDENTIAL_KEYS`.
# LEARNING_CREDENTIAL_KEYS=

# Google OAuth web-server credentials. Keep both value-free in source control;
# production uses the two commands below. The callback URI is the canonical
# APP_ORIGIN plus /admin/learning/google/callback.
# `npx wrangler secret put GOOGLE_CLASSROOM_CLIENT_ID`
# GOOGLE_CLASSROOM_CLIENT_ID=
# `npx wrangler secret put GOOGLE_CLASSROOM_CLIENT_SECRET`
# GOOGLE_CLASSROOM_CLIENT_SECRET=

# Canvas OAuth deployment bindings. CANVAS_ALLOWED_ORIGINS is a bounded JSON array of exact HTTPS origins,
# for example ["https://canvas.example.org"]. It is configuration rather than a credential, but is stored
# as a Worker secret binding so setup-generated Wrangler configuration never contains a real institution URL.
# Private, loopback, local-only, duplicate, non-canonical, or more than 16 origins are rejected.
# `npx wrangler secret put CANVAS_ALLOWED_ORIGINS`
# CANVAS_ALLOWED_ORIGINS=
# `npx wrangler secret put CANVAS_OAUTH_CLIENT_ID`
# CANVAS_OAUTH_CLIENT_ID=
# `npx wrangler secret put CANVAS_OAUTH_CLIENT_SECRET`
# CANVAS_OAUTH_CLIENT_SECRET=

# Pub/Sub push topic and identity/routing allowlists. These are identifiers
# rather than credentials, but remain unset in the tracked example. Set all
# three to enable real-time roster and course-work registrations; leave all
# three unset for explicit scheduled/manual polling-only operation.
# GOOGLE_CLASSROOM_PUBSUB_TOPIC=
# GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PUBSUB_SUBSCRIPTION_NAME=

# When set, outgoing mail (including magic links) is logged to the console
# instead of sent. Leave on for local development.
EMAIL_DEV_LOG=1

# When set, local dev auto-authenticates as this admin address (no magic link).
AUTH_DEV_BYPASS_EMAIL=admin@example.com

# Database backend for local dev: "d1" (default) or "supabase". With "supabase"
# the worker reads/writes Postgres over the HYPERDRIVE binding instead of D1.
# DB_BACKEND=d1

# Stripe keys for the giving module (Supabase backend only). The secret key
# authorizes Checkout/Portal/subscription API calls; the webhook secret verifies
# inbound Stripe events at /api/stripe/webhook. Use test-mode keys locally
# (sk_test_… / whsec_…); production uses `wrangler secret put`. Both unset →
# giving checkout/webhook are inert.
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Local Supabase/Postgres uses the canonical host environment variable below. It is
# consumed by Wrangler before Worker bindings load, so it MUST NOT be placed in
# `.dev.vars`. Export it in the host shell that starts `npm run dev` instead:
# export CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE='postgres://postgres:postgres@localhost:5432/postgres'
# See docs/supabase-setup.md. No assignment is included here intentionally.

# Token for the nightly D1→R2 backup (src/lib/backup.ts). Set this plus the
# CF_ACCOUNT_ID + D1_DATABASE_ID vars in wrangler.jsonc to enable backups; if
# any is unset the backup cron skips gracefully. Production uses
# `wrangler secret put D1_EXPORT_TOKEN`.
# D1_EXPORT_TOKEN=
