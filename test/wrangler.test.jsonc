{
  // Test-only Worker config for the vitest pool. Uses local placeholder values
  // (never the real production database_id from wrangler.jsonc) so the pool spins
  // up an isolated miniflare D1. migrations_dir is relative to this file.
  "name": "church4christ-test",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // Auth + email libs read these off the Worker env; the pool surfaces jsonc
  // vars as `env` in workers tests. EMAIL_DEV_LOG keeps sendEmail off the real
  // provider (there is no send_email binding here) so the devlog path is tested.
  "vars": {
    "SESSION_SECRET": "test-secret-at-least-32-characters-long",
    "NEWCOMER_RATE_LIMIT_SECRET": "test-newcomer-rate-limit-secret-at-least-32-characters",
    "IDENTITY_VERIFICATION_SECRET": "test-identity-verification-secret-at-least-thirty-two-characters",
    "IDENTITY_SOURCE_KEY_SECRET": "test-stable-identity-source-key-secret-at-least-thirty-two-characters",
    "IDENTITY_SOURCE_KEY_ID": "v1",
    "IDENTITY_RECOVERY_KEY_SECRET": "test-stable-identity-recovery-key-secret-at-least-thirty-two-characters",
    "IDENTITY_RECOVERY_KEY_ID": "v1",
    "IDENTITY_RECOVERY_COOLING_HOURS": "24",
    "PLANNING_CENTER_CLIENT_ID": "planning-center-test-client",
    "PLANNING_CENTER_SECRET": "planning-center-test-secret",
    "PLANNING_CENTER_WEBHOOK_SECRET": "planning-center-test-webhook-secret",
    "PLANNING_CENTER_USER_AGENT": "Church CMS <https://church.example/contact>",
    "EMAIL_DEV_LOG": "1",
    "APP_ORIGIN": "http://localhost"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "church4christ-db-test",
      "database_id": "test",
      "migrations_dir": "../migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "church4christ-media-test" }]
}
