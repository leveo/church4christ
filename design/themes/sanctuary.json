{
  "$comment": "Theme: Sanctuary \u2014 warm ivory, forest green and quiet gold. Editorial public pages and purposeful ministry workspaces.",
  "version": 1,
  "name": "sanctuary",
  "label": "Sanctuary",
  "defaultMode": "light",
  "fonts": {
    "display": {
      "family": "Fraunces Variable",
      "fallback": "Georgia, 'Songti SC', 'Noto Serif SC', 'SimSun', serif",
      "fontsource": "@fontsource-variable/fraunces"
    },
    "body": {
      "family": "Inter Variable",
