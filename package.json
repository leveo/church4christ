{
  "name": "church4christ",
  "type": "module",
  "version": "1.2.0",
  "private": true,
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run tokens && astro build && node scripts/check-production-bundle.mjs",
    "build:e2e": "npm run tokens && astro build --mode e2e",
    "prepare": "npm run tokens",
    "preview": "npm run build && astro preview",
    "check": "astro check",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/check-tokens.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "setup": "node scripts/setup/index.mjs",
    "doctor": "node scripts/setup/index.mjs --doctor",
    "release:rehearse": "node scripts/release/rehearse-upgrade.mjs --d1",
    "docs:generate": "node scripts/docs/generate-capabilities.mjs",
    "docs:check": "node scripts/docs/check-capabilities.mjs",
    "test": "vitest run",
    "test:e2e": "npm run build:e2e && vitest run --config vitest.e2e.config.ts",
    "test:e2e:pg": "npm run build:e2e && vitest run --config vitest.e2e.pg.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:supabase": "node scripts/db/migrate-supabase.mjs",
    "db:seed:local": "wrangler d1 execute DB --local --file=./seed/dev-seed.sql",
    "db:seed-media:local": "node scripts/db/seed-media-local.mjs",
    "db:seed:supabase": "node scripts/db/seed-supabase.mjs",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/react": "^6.0.5",
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/nunito": "^5.2.7",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "astro": "^7.3.1",
    "jose": "^6.2.3",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "opencc-data": "^1.4.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20260907.1": true,
    "sharp@0.35.2": true,
    "sharp@0.35.4": true
  }
}
