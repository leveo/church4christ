---
import Icon from '../ui/Icon.astro';
import { publicCopy } from '../../i18n/designPublic';
import type { Locale } from '../../lib/locales';
interface Props { locale: Locale; title: string; backHref?: string; backLabel?: string; print?: boolean; hasArchive?: boolean }
const { locale, title, backHref, backLabel, print = true, hasArchive = Astro.slots.has('archive') } = Astro.props;
---
<div class="printable-reader">
  <div class="reader-tools">
    {backHref && backLabel ? <a href={backHref}>{backLabel}</a> : <p class="section-eyebrow">{title}</p>}
    {print && <button type="button" data-print-reader hidden>{publicCopy(locale).print}<Icon name="book" size={16}/></button>}
  </div>
  <div class:list={['reader-grid', { 'with-archive': hasArchive }]}>
    <div class="reader-paper"><slot /></div>
    {hasArchive && <aside class="reader-archive"><slot name="archive" /></aside>}
  </div>
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-print-reader]').forEach(button => {
    button.hidden = false;
    button.addEventListener('click', () => window.print());
  });
  let savedMode: string | undefined;
  window.addEventListener('beforeprint', () => {
    savedMode = document.documentElement.dataset.mode;
    document.documentElement.dataset.mode = 'light';
  });
  window.addEventListener('afterprint', () => {
    if (savedMode === undefined) delete document.documentElement.dataset.mode;
    else document.documentElement.dataset.mode = savedMode;
  });
</script>
<style>
  .printable-reader { padding-bottom: 4rem; }
  .reader-tools { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 1.25rem; border-top: 1px solid var(--color-border); }
  .reader-tools a { font-size: .88rem; color: var(--color-primary); text-decoration: underline; text-underline-offset: .25rem; }
  .reader-tools button { display: inline-flex; align-items: center; gap: .7rem; min-height: 44px; padding: .65rem 1rem; border: 1px solid var(--color-border-strong); border-radius: var(--radius-md); cursor: pointer; font-size: .82rem; font-weight: 600; }
  .reader-tools button[hidden] { display: none; }
  .reader-tools button:hover { background: var(--color-primary-soft); color: var(--color-on-primary-soft); }
  .reader-grid { display: grid; gap: 2rem; }
  .with-archive { grid-template-columns: minmax(0, 1fr) 260px; align-items: start; }
  .reader-paper { min-width: 0; padding: clamp(1.4rem, 4vw, 3.5rem); border: 1px solid var(--color-border); border-top: 4px solid var(--color-primary); border-radius: var(--radius-lg); background: var(--color-surface-raised); box-shadow: var(--shadow-sm); }
  .reader-archive { min-width: 0; position: sticky; top: 6.5rem; }
  .reader-archive :global(h2) { font-family: var(--font-display); font-size: 1.3rem; }
  .reader-archive :global(p) { margin-top: .5rem; font-size: .85rem; color: var(--color-ink-muted); }
  .reader-archive :global(details) { margin-top: 1rem; border-top: 1px solid var(--color-border); padding-top: .65rem; }
  .reader-archive :global(summary) { cursor: pointer; min-height: 44px; padding-block: .55rem; font-weight: 600; }
  .reader-archive :global(ul) { display: grid; gap: .25rem; }
  .reader-archive :global(a) { display: block; padding: .7rem .5rem; font-size: .8rem; color: var(--color-ink-muted); border-radius: var(--radius-sm); }
  .reader-archive :global(a:hover), .reader-archive :global(a[aria-current]) { background: var(--color-primary-soft); color: var(--color-on-primary-soft); }
  @media (max-width: 850px) { .with-archive { grid-template-columns: 1fr; } .reader-archive { position: static; } }
  @media print {
    :global(body:has(.printable-reader) > header), :global(body:has(.printable-reader) > footer), :global(body:has(.printable-reader) > .skip-link) { display: none !important; }
    .reader-tools, .reader-archive { display: none; }
    .printable-reader { padding: 0; }
    .reader-grid { display: block; }
    .reader-paper { padding: 0; border: 0; box-shadow: none; background: none; }
    .reader-paper :global(h2), .reader-paper :global(h3) { break-after: avoid; }
    .reader-paper :global(tr), .reader-paper :global(li), .reader-paper :global(blockquote) { break-inside: avoid; }
  }
</style>
