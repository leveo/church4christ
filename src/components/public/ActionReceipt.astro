---
import DesignImage from '../ui/DesignImage.astro';
import type { DesignImage as ImageKey } from '../../lib/designAssets';
interface Props { image: ImageKey }
const { image } = Astro.props;
---
<div class="receipt-wrap container-content">
  <section class="action-receipt">
    <DesignImage image={image} eager class="receipt-cover" />
    <div class="receipt-body"><slot /></div>
  </section>
</div>
<style>
  .receipt-wrap { padding-block: 3rem; }
  .action-receipt { max-width: 580px; margin-inline: auto; overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface-raised); }
  .action-receipt :global(.receipt-cover) { width: 100%; height: 180px; object-fit: cover; }
  .receipt-body { padding: 2.25rem; text-align: center; }
  .receipt-body :global(h1) { font-family: var(--font-body); font-size: clamp(1.65rem, 3vw, 2rem); line-height: 1.3; letter-spacing: -.03em; }
  .receipt-body :global(button), .receipt-body :global(a) { border-radius: var(--radius-md); }
  @media (max-width: 600px) { .receipt-wrap { padding-block: 1.5rem; } .receipt-body { padding: 1.5rem; } .action-receipt :global(.receipt-cover) { height: 140px; } }
</style>
