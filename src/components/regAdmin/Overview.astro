---
// The event page's overview: counts by status, seats left, waitlist, people awaiting a decision, door count,
// people by ticket type, revenue (events that collect money) and the tallies of every choice question.
import type { EventOverview } from '../../lib/regAdmin';
import { formatCents } from '../../lib/money';
import { t } from '../../lib/i18n';
import type { Locale } from '../../lib/locales';

interface Props { overview: EventOverview; lang: Locale; eventId: number }
const { overview: o, lang, eventId } = Astro.props;
const base = `/admin/registration/${eventId}`;
const statuses = ['confirmed', 'review', 'waitlist', 'pending', 'declined', 'cancelled'] as const;
const hasMoney = o.revenue.collectedCents > 0 || o.revenue.refundedCents > 0;
const h3 = 'text-xs font-semibold uppercase tracking-caps text-ink-subtle';
---
<section aria-labelledby="reg-overview-heading" data-testid="reg-overview">
  <h2 id="reg-overview-heading" class="sr-only">{t(lang, 'admin.reg.bo.overview')}</h2>
  <dl class="gathering-stats">
    <div><dt>{t(lang, 'admin.reg.bo.seatsTaken')}</dt><dd data-stat="seats">{o.seatsTaken}{o.capacity !== null ? ` / ${o.capacity}` : ''}</dd></div>
    <div><dt>{t(lang, 'admin.reg.bo.seatsLeft')}</dt><dd data-stat="left">{o.seatsLeft === null ? t(lang, 'admin.reg.bo.unlimited') : o.seatsLeft}</dd></div>
    <div><dt>{t(lang, 'admin.reg.bo.waitlistPeople')}</dt><dd data-stat="waitlist">{o.waitlistPeople}</dd></div>
    {(o.requiresApproval || o.reviewPeople > 0) && (
      <div><dt>{t(lang, 'admin.reg.bo.awaitingDecision')}</dt><dd data-stat="review"><a class="hover:underline" href={`${base}?status=review#roster`}>{o.reviewPeople}</a></dd></div>
    )}
    <div><dt>{t(lang, 'admin.reg.bo.checkedIn')}</dt><dd data-stat="checkedin">{o.checkedIn} / {o.expectedPeople}</dd></div>
    {hasMoney && (
      <div><dt>{t(lang, 'admin.reg.bo.revenue')}</dt><dd data-stat="revenue">{formatCents(o.revenue.netCents, o.revenue.currency, lang)}</dd></div>
    )}
  </dl>

  <div class="grid gap-4 lg:grid-cols-2">
    <div class="gathering-panel">
      <h3 class={h3}>{t(lang, 'admin.reg.status')}</h3>
      <ul class="mt-2 flex flex-wrap gap-2 text-sm">
        {statuses.map((s) => (
          <li>
            <a href={`${base}?status=${s}#roster`} class="gathering-roster-status hover:underline" data-status={s}>
              {t(lang, `admin.reg.status.${s}`)}: {o.statuses[s].registrations}
              {o.statuses[s].people !== o.statuses[s].registrations ? ` (${o.statuses[s].people} ${t(lang, 'admin.reg.bo.peopleShort')})` : ''}
            </a>
          </li>
        ))}
      </ul>
      {hasMoney && (
        <p class="mt-3 text-sm text-ink-muted" data-testid="overview-money">
          {t(lang, 'admin.reg.bo.collected')}: {formatCents(o.revenue.collectedCents, o.revenue.currency, lang)} · {t(lang, 'admin.reg.bo.refunded')}: {formatCents(o.revenue.refundedCents, o.revenue.currency, lang)}
        </p>
      )}
    </div>

    {o.byType.length > 0 && (
      <div class="gathering-panel">
        <h3 class={h3}>{t(lang, 'admin.reg.bo.byType')}</h3>
        <table class="mt-2 w-full text-sm" data-testid="overview-types">
          <tbody>
            {o.byType.map((row) => (
              <tr class="border-t border-border first:border-t-0">
                <td class="py-1.5 pr-3">{row.label ?? t(lang, 'admin.reg.bo.noType')}{!row.active && <span class="text-ink-muted"> ({t(lang, 'admin.reg.bo.inactive')})</span>}</td>
                <td class="py-1.5 pr-3 tabular-nums">{row.seats}{row.capacity !== null ? ` / ${row.capacity}` : ''}</td>
                <td class="py-1.5 text-ink-muted tabular-nums">{row.waitlist > 0 ? `${row.waitlist} ${t(lang, 'admin.reg.status.waitlist').toLowerCase()}` : ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>

  {o.tallies.length > 0 && (
    <div class="mt-4 grid gap-4 md:grid-cols-2 xl:grid-cols-3" data-testid="overview-tallies">
      {o.tallies.map((q) => (
        <div class="gathering-panel">
          <h3 class={h3}>{q.label}</h3>
          <ul class="mt-2 space-y-1 text-sm">
            {q.options.map((opt) => (
              <li class="flex items-baseline justify-between gap-3">
                <a class="hover:underline" href={`${base}?ans=${q.questionId}:${encodeURIComponent(opt.key)}#roster`}>{q.type === 'yesno' ? t(lang, opt.key === 'yes' ? 'register.yes' : 'register.no') : opt.label}</a>
                <span class="tabular-nums text-ink-muted">{opt.count}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  )}
</section>
