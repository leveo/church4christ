---
// The Housing tab of the event page: venues, room types and rooms (added by range text, confirmed in bulk), and
// the assignment board: the people with no room yet on the left, the rooms of each venue on the right with their
// occupancy, policy and confirmation. Assigning is two plain controls (a person, a room) and "bring the rest of
// their party" is on by default. A viewer sees the board without any form.
import type { LogisticsBoard } from '../../../lib/regLogisticsPage';
import { boardQuery } from '../../../lib/regLogisticsPage';
import { VENUE_KINDS, ROOM_POLICIES } from '../../../lib/regHousing';
import { capacityRuleKey, roomPolicyKey, venueKindKey } from '../../../lib/regLogisticsView';
import { tin, lab, btn, btnSecondary, btnDanger, rowBtn } from '../../../lib/adminUi';
import { t } from '../../../lib/i18n';
import type { Locale } from '../../../lib/locales';
import LxHidden from './LxHidden.astro';
import LxPeople from './LxPeople.astro';
import LxTags from './LxTags.astro';

interface Props { board: LogisticsBoard; lang: Locale; eventId: number; canManage: boolean }
const { board, lang, eventId, canManage } = Astro.props;
const base = `/admin/registration/${eventId}`;
const back = boardQuery('housing', board.state);
const venues = board.housing;
const nameOf = (id: number) => board.byId.get(id)?.name ?? `#${id}`;
const roomOf = new Map(venues.flatMap((v) => v.rooms.map((r) => [r.id, { room: r, venue: v }] as const)));
const assigned = board.people.filter((p) => p.roomId !== null && roomOf.has(p.roomId)).sort((a, b) => a.name.localeCompare(b.name, lang));
const eligible = board.people.filter((p) => p.eligible).length;
const placed = board.people.filter((p) => p.eligible && p.roomId !== null).length;
const confirmedRooms = venues.flatMap((v) => v.rooms).filter((r) => r.confirmed);
const h3 = 'font-semibold';
const CAPACITY_RULES_FOR_FORM = ['hard', 'soft'] as const;
const badgeBase = 'inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium';
---
<section id="logistics" class="mt-6 scroll-mt-4" aria-labelledby="lx-housing-heading" data-testid="lx-housing">
  <div class="flex flex-wrap items-baseline justify-between gap-3">
    <div>
      <h2 id="lx-housing-heading" class="font-display text-heading-sm font-bold">{t(lang, 'admin.reg.lx.tab.housing')}</h2>
      <p class="text-sm text-ink-muted" data-testid="lx-progress">{t(lang, 'admin.reg.lx.housingProgress', { placed, people: eligible, rooms: confirmedRooms.length })}</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <a href={`${base}/room-list`} class={btnSecondary} target="_blank" rel="noopener">{t(lang, 'admin.reg.lx.print.roomList')}</a>
      <a href={`${base}/door-signs`} class={btnSecondary} target="_blank" rel="noopener">{t(lang, 'admin.reg.lx.print.doorSigns')}</a>
    </div>
  </div>

  <LxTags board={board} tab="housing" lang={lang} back={back} canManage={canManage} />

  {canManage && (
    <details class="gathering-editor mt-4" open={venues.length === 0} data-testid="lx-venues">
      <summary>{t(lang, 'admin.reg.lx.venuesSetup')} ({venues.length})</summary>
      <div class="gathering-editor-inner space-y-6">
        <p class="text-sm text-ink-muted">{t(lang, 'admin.reg.lx.venuesHint')}</p>
        {venues.map((v) => (
          <div class="space-y-3 rounded-lg border border-border p-4" data-venue={v.id}>
            <form method="post" class="flex flex-wrap items-end gap-2">
              <LxHidden action="venue_update" back={back} tab="housing" />
              <input type="hidden" name="venue_id" value={v.id} />
              <label class="block min-w-48 flex-1"><span class={lab}>{t(lang, 'admin.reg.lx.venueName')}</span><input name="name" value={v.name} maxlength="120" required class={tin} /></label>
              <label class="block"><span class={lab}>{t(lang, 'admin.reg.lx.venueKind')}</span>
                <select name="kind" class={tin}>{VENUE_KINDS.map((k) => <option value={k} selected={k === v.kind}>{t(lang, venueKindKey(k))}</option>)}</select>
              </label>
              <label class="block"><span class={lab}>{t(lang, 'admin.reg.lx.capacityRule')}</span>
                <select name="capacity_rule" class={tin}>{CAPACITY_RULES_FOR_FORM.map((r) => <option value={r} selected={r === v.capacityRule}>{t(lang, capacityRuleKey(r))}</option>)}</select>
              </label>
              <button type="submit" class={btnSecondary}>{t(lang, 'admin.form.save')}</button>
            </form>
            <form method="post" data-confirm={t(lang, 'admin.reg.lx.deleteVenueConfirm')}>
              <LxHidden action="venue_delete" back={back} tab="housing" />
              <input type="hidden" name="venue_id" value={v.id} />
              <button type="submit" class={rowBtn}>{t(lang, 'admin.reg.lx.deleteVenue')}</button>
            </form>

            <div>
              <h4 class="text-xs font-semibold uppercase tracking-caps text-ink-subtle">{t(lang, 'admin.reg.lx.roomTypes')}</h4>
              <ul class="mt-2 space-y-2">
                {v.roomTypes.map((rt) => (
                  <li class="flex flex-wrap items-end gap-2">
                    <form method="post" class="flex flex-wrap items-end gap-2">
                      <LxHidden action="room_type_update" back={back} tab="housing" />
                      <input type="hidden" name="room_type_id" value={rt.id} />
                      <label class="block"><span class="sr-only">{t(lang, 'admin.reg.lx.roomTypeName')}</span><input name="name" value={rt.name} maxlength="80" required class={`${tin} w-48`} /></label>
                      <label class="block"><span class="sr-only">{t(lang, 'admin.reg.lx.beds')}</span><input name="beds" type="number" min="1" max="100" value={rt.beds} required class={`${tin} w-20`} /></label>
                      <button type="submit" class={rowBtn}>{t(lang, 'admin.form.save')}</button>
                    </form>
                    <span class="text-xs text-ink-muted">{t(lang, 'admin.reg.lx.roomsOfType', { n: rt.rooms })}</span>
                    {rt.rooms === 0 && (
                      <form method="post">
                        <LxHidden action="room_type_delete" back={back} tab="housing" />
                        <input type="hidden" name="room_type_id" value={rt.id} />
                        <button type="submit" class={rowBtn}>{t(lang, 'admin.reg.lx.delete')}</button>
                      </form>
                    )}
                  </li>
                ))}
              </ul>
              <form method="post" class="mt-2 flex flex-wrap items-end gap-2">
                <LxHidden action="room_type_create" back={back} tab="housing" />
                <input type="hidden" name="venue_id" value={v.id} />
                <label class="block"><span class={lab}>{t(lang, 'admin.reg.lx.newRoomType')}</span><input name="name" maxlength="80" required class={`${tin} w-48`} placeholder={t(lang, 'admin.reg.lx.roomTypePlaceholder')} /></label>
                <label class="block"><span class={lab}>{t(lang, 'admin.reg.lx.beds')}</span><input name="beds" type="number" min="1" max="100" value="2" required class={`${tin} w-20`} /></label>
                <button type="submit" class={rowBtn}>{t(lang, 'admin.reg.bo.add')}</button>
              </form>
            </div>

            <form method="post" class="space-y-2" data-testid="lx-rooms-add">
              <LxHidden action="rooms_add" back={back} tab="housing" />
              <input type="hidden" name="venue_id" value={v.id} />
              <label class="block"><span class={lab}>{t(lang, 'admin.reg.lx.addRooms')}</span>
                <input name="labels" required class={tin} placeholder="101-120, A1-A6, Loft" />
                <span class="text-xs text-ink-subtle">{t(lang, 'admin.reg.lx.addRoomsHint')}</span>
              </label>
              <div class="flex flex-wrap items-end gap-2">
                <label class="block"><span class={lab}>{t(lang, 'admin.reg.lx.roomType')}</span>
                  <select name="room_type_id" class={tin}>
                    {v.roomTypes.map((rt) => <option value={rt.id}>{rt.name} · {t(lang, 'admin.reg.lx.bedsN', { n: rt.beds })}</option>)}
                    <option value="">{t(lang, 'admin.reg.lx.noRoomType')}</option>
                  </select>
                </label>
                <label class="block"><span class={lab}>{t(lang, 'admin.reg.lx.bedsOverride')}</span><input name="beds" type="number" min="1" max="100" class={`${tin} w-24`} /></label>
                <label class="block"><span class={lab}>{t(lang, 'admin.reg.lx.floor')}</span><input name="floor" maxlength="40" class={`${tin} w-24`} /></label>
                <label class="block"><span class={lab}>{t(lang, 'admin.reg.lx.policy')}</span>
                  <select name="policy" class={tin}>{ROOM_POLICIES.map((p) => <option value={p}>{t(lang, roomPolicyKey(p))}</option>)}</select>
                </label>
                <button type="submit" class={btnSecondary}>{t(lang, 'admin.reg.lx.addRoomsButton')}</button>
              </div>
            </form>
          </div>
        ))}

        <form method="post" class="flex flex-wrap items-end gap-2" data-testid="lx-venue-create">
          <LxHidden action="venue_create" back={back} tab="housing" />
          <label class="block min-w-48 flex-1"><span class={lab}>{t(lang, 'admin.reg.lx.newVenue')}</span><input name="name" maxlength="120" required class={tin} placeholder={t(lang, 'admin.reg.lx.venuePlaceholder')} /></label>
          <label class="block"><span class={lab}>{t(lang, 'admin.reg.lx.venueKind')}</span>
            <select name="kind" class={tin}>{VENUE_KINDS.map((k) => <option value={k}>{t(lang, venueKindKey(k))}</option>)}</select>
          </label>
          <label class="block"><span class={lab}>{t(lang, 'admin.reg.lx.capacityRule')}</span>
            <select name="capacity_rule" class={tin}>
              <option value="">{t(lang, 'admin.reg.lx.ruleByKind')}</option>
              {CAPACITY_RULES_FOR_FORM.map((r) => <option value={r}>{t(lang, capacityRuleKey(r))}</option>)}
            </select>
          </label>
          <button type="submit" class={btn}>{t(lang, 'admin.reg.lx.addVenue')}</button>
        </form>
      </div>
    </details>
  )}

  {venues.length === 0 && !canManage && <p class="mt-4 text-sm text-ink-muted">{t(lang, 'admin.reg.lx.noVenues')}</p>}

  {venues.length > 0 && (
    <div class="mt-4 grid gap-4 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)]">
      <div class="space-y-4">
        <LxPeople board={board} tab="housing" lang={lang} eventId={eventId} formId={canManage ? 'lx-assign' : null} />
        {canManage && board.waiting.length > 0 && (
          <form id="lx-assign" method="post" class="gathering-panel space-y-3" data-testid="lx-assign">
            <LxHidden action="room_assign" back={back} tab="housing" />
            <label class="block"><span class={lab}>{t(lang, 'admin.reg.lx.room')}</span>
              <select name="room_id" required class={tin}>
                <option value="">—</option>
                {venues.map((v) => (
                  <optgroup label={v.name}>
                    {v.rooms.filter((r) => r.confirmed).map((r) => <option value={r.id}>{r.label} · {r.occupants.length}/{r.beds}{r.policy !== 'any' ? ` · ${t(lang, roomPolicyKey(r.policy))}` : ''}</option>)}
                  </optgroup>
                ))}
              </select>
            </label>
            <label class="flex min-h-11 items-center gap-2 text-sm">
              <input type="hidden" name="party" value="0" />
              <input type="checkbox" name="party" value="1" checked /> {t(lang, 'admin.reg.lx.bringParty')}
            </label>
            <button type="submit" class={btn}>{t(lang, 'admin.reg.lx.assign')}</button>
            {confirmedRooms.length === 0 && <p class="text-xs text-ink-subtle">{t(lang, 'admin.reg.lx.confirmFirst')}</p>}
          </form>
        )}
        {canManage && assigned.length > 0 && confirmedRooms.length > 0 && (
          <form method="post" class="gathering-panel space-y-3" data-testid="lx-move">
            <LxHidden action="room_assign" back={back} tab="housing" />
            <input type="hidden" name="party" value="0" />
            <h3 class={h3}>{t(lang, 'admin.reg.lx.move')}</h3>
            <label class="block"><span class={lab}>{t(lang, 'admin.reg.lx.person')}</span>
              <select name="attendee_id" required class={tin}>
                <option value="">—</option>
                {assigned.map((p) => <option value={p.attendeeId}>{p.name} · {roomOf.get(p.roomId!)!.room.label}</option>)}
              </select>
            </label>
            <label class="block"><span class={lab}>{t(lang, 'admin.reg.lx.room')}</span>
              <select name="room_id" required class={tin}>
                <option value="">—</option>
                {venues.map((v) => (
                  <optgroup label={v.name}>
                    {v.rooms.filter((r) => r.confirmed).map((r) => <option value={r.id}>{r.label} · {r.occupants.length}/{r.beds}</option>)}
                  </optgroup>
                ))}
              </select>
            </label>
            <button type="submit" class={btnSecondary}>{t(lang, 'admin.reg.lx.moveButton')}</button>
          </form>
        )}
        {canManage && assigned.length > 1 && (
          <form method="post" class="gathering-panel space-y-3" data-testid="lx-swap">
            <LxHidden action="room_swap" back={back} tab="housing" />
            <h3 class={h3}>{t(lang, 'admin.reg.lx.swap')}</h3>
            {(['attendee_a', 'attendee_b'] as const).map((name, i) => (
              <label class="block"><span class={lab}>{t(lang, i === 0 ? 'admin.reg.lx.swapFirst' : 'admin.reg.lx.swapSecond')}</span>
                <select name={name} required class={tin}>
                  <option value="">—</option>
                  {assigned.map((p) => <option value={p.attendeeId}>{p.name} · {roomOf.get(p.roomId!)!.room.label}</option>)}
                </select>
              </label>
            ))}
            <button type="submit" class={btnSecondary}>{t(lang, 'admin.reg.lx.swapButton')}</button>
          </form>
        )}
      </div>

      <div class="min-w-0 space-y-6">
        {canManage && (
          <form id="lx-rooms-bulk" method="post" class="flex flex-wrap items-center gap-2 rounded-lg border border-border bg-surface-raised p-3" data-testid="lx-rooms-bulk">
            <LxHidden action="rooms_bulk" back={back} tab="housing" />
            <span class="text-sm text-ink-muted">{t(lang, 'admin.reg.lx.selectedRooms')}</span>
            <button type="submit" name="op" value="confirm" class={rowBtn}>{t(lang, 'admin.reg.lx.confirmRooms')}</button>
            <button type="submit" name="op" value="unconfirm" class={rowBtn}>{t(lang, 'admin.reg.lx.unconfirmRooms')}</button>
            <button type="submit" name="op" value="delete" class={rowBtn} data-confirm={t(lang, 'admin.reg.lx.deleteRoomsConfirm')}>{t(lang, 'admin.reg.lx.deleteRooms')}</button>
          </form>
        )}
        {venues.map((v) => (
          <section aria-labelledby={`lx-venue-${v.id}`} data-venue-board={v.id}>
            <h3 id={`lx-venue-${v.id}`} class="font-display text-lg font-bold">{v.name} <span class="text-sm font-normal text-ink-muted">· {t(lang, venueKindKey(v.kind))} · {t(lang, capacityRuleKey(v.capacityRule))}</span></h3>
            {v.rooms.length === 0 && <p class="mt-2 text-sm text-ink-muted">{t(lang, 'admin.reg.lx.noRooms')}</p>}
            <ul class="mt-3 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
              {v.rooms.map((r) => {
                const over = r.occupants.length > r.beds;
                return (
                  <li class={`rounded-lg border p-3 text-sm ${r.confirmed ? 'border-border bg-surface-raised' : 'border-dashed border-border-strong bg-surface'}`} data-room={r.id} data-confirmed={r.confirmed ? '1' : '0'}>
                    <div class="flex items-start justify-between gap-2">
                      <label class="flex items-center gap-2 font-semibold">
                        {canManage && <input type="checkbox" name="room_ids" value={r.id} form="lx-rooms-bulk" aria-label={t(lang, 'admin.reg.lx.selectRoom', { room: r.label })} />}
                        <span>{r.label}</span>
                      </label>
                      <span class={`tabular-nums ${over ? 'font-semibold text-danger' : 'text-ink-muted'}`} data-occupancy>{r.occupants.length} / {r.beds}</span>
                    </div>
                    <div class="mt-1 flex flex-wrap gap-1">
                      {!r.confirmed && <span class={`${badgeBase} bg-warn-soft text-warn`} data-unconfirmed>{t(lang, 'admin.reg.lx.unconfirmed')}</span>}
                      {r.policy !== 'any' && <span class={`${badgeBase} bg-info-soft text-info`} data-policy={r.policy}>{t(lang, roomPolicyKey(r.policy))}</span>}
                      {over && <span class={`${badgeBase} bg-danger-soft text-danger`}>{t(lang, 'admin.reg.lx.overCapacity')}</span>}
                      {r.floor && <span class="text-xs text-ink-muted">{t(lang, 'admin.reg.lx.floorN', { floor: r.floor })}</span>}
                    </div>
                    {r.notes && <p class="mt-1 text-xs text-ink-muted">{r.notes}</p>}
                    <ul class="mt-2 space-y-1" data-occupants>
                      {r.occupants.map((id) => (
                        <li class="flex items-center justify-between gap-2">
                          <span>{nameOf(id)}{r.leaderAttendeeId === id && <span class="ml-1 text-xs font-semibold text-primary" data-leader>· {t(lang, 'admin.reg.lx.leader')}</span>}</span>
                          {canManage && (
                            <form method="post">
                              <LxHidden action="room_unassign" back={back} tab="housing" />
                              <input type="hidden" name="attendee_id" value={id} />
                              <button type="submit" class="min-h-9 px-2 text-xs font-semibold text-ink-muted hover:text-danger" aria-label={t(lang, 'admin.reg.lx.removeFrom', { name: nameOf(id), place: r.label })}>{t(lang, 'admin.reg.lx.remove')}</button>
                            </form>
                          )}
                        </li>
                      ))}
                    </ul>
                    {canManage && (
                      <details class="mt-2">
                        <summary class="cursor-pointer text-xs font-semibold text-primary">{t(lang, 'admin.reg.lx.roomOptions')}</summary>
                        <form method="post" class="mt-2 space-y-2">
                          <LxHidden action="room_update" back={back} tab="housing" />
                          <input type="hidden" name="room_id" value={r.id} />
                          <div class="grid grid-cols-2 gap-2">
                            <label class="block"><span class={lab}>{t(lang, 'admin.reg.lx.roomLabel')}</span><input name="label" value={r.label} maxlength="40" required class={tin} /></label>
                            <label class="block"><span class={lab}>{t(lang, 'admin.reg.lx.floor')}</span><input name="floor" value={r.floor ?? ''} maxlength="40" class={tin} /></label>
                            <label class="block"><span class={lab}>{t(lang, 'admin.reg.lx.roomType')}</span>
                              <select name="room_type_id" class={tin}>
                                <option value="">{t(lang, 'admin.reg.lx.noRoomType')}</option>
                                {v.roomTypes.map((rt) => <option value={rt.id} selected={rt.id === r.roomTypeId}>{rt.name}</option>)}
                              </select>
                            </label>
                            <label class="block"><span class={lab}>{t(lang, 'admin.reg.lx.bedsOverride')}</span><input name="beds" type="number" min="1" max="100" value={r.bedsOverride ?? ''} class={tin} /></label>
                          </div>
                          <label class="block"><span class={lab}>{t(lang, 'admin.reg.lx.policy')}</span>
                            <select name="policy" class={tin}>{ROOM_POLICIES.map((p) => <option value={p} selected={p === r.policy}>{t(lang, roomPolicyKey(p))}</option>)}</select>
                          </label>
                          <label class="block"><span class={lab}>{t(lang, 'admin.reg.lx.notes')}</span><textarea name="notes" rows="2" maxlength="500" class={tin}>{r.notes ?? ''}</textarea></label>
                          <button type="submit" class={rowBtn}>{t(lang, 'admin.form.save')}</button>
                        </form>
                        {r.occupants.length > 0 && (
                          <form method="post" class="mt-2 flex flex-wrap items-end gap-2">
                            <LxHidden action="room_leader" back={back} tab="housing" />
                            <input type="hidden" name="room_id" value={r.id} />
                            <label class="block flex-1"><span class={lab}>{t(lang, 'admin.reg.lx.roomLeader')}</span>
                              <select name="attendee_id" class={tin}>
                                <option value="">{t(lang, 'admin.reg.lx.noLeader')}</option>
                                {r.occupants.map((id) => <option value={id} selected={r.leaderAttendeeId === id}>{nameOf(id)}</option>)}
                              </select>
                            </label>
                            <button type="submit" class={rowBtn}>{t(lang, 'admin.form.save')}</button>
                          </form>
                        )}
                        {r.occupants.length > 0 && (
                          <form method="post" class="mt-2" data-confirm={t(lang, 'admin.reg.lx.clearRoomConfirm')}>
                            <LxHidden action="room_clear" back={back} tab="housing" />
                            <input type="hidden" name="room_id" value={r.id} />
                            <button type="submit" class={`${btnDanger} min-h-9 px-3 py-1.5 text-xs`}>{t(lang, 'admin.reg.lx.clearRoom')}</button>
                          </form>
                        )}
                      </details>
                    )}
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </div>
    </div>
  )}
</section>
