---
// Likely double sign-ups: people with the same name, or registrations sharing an email or phone. Each member links
// to its detail panel, where the normal cancel path removes the extra one.
import type { DuplicateGroup } from '../../lib/regAdmin';
import { t } from '../../lib/i18n';
import type { Locale } from '../../lib/locales';

interface Props { groups: DuplicateGroup[]; lang: Locale; eventId: number; open: boolean }
const { groups, lang, eventId, open } = Astro.props;
const base = `/admin/registration/${eventId}`;
---
<details id="duplicates" class="gathering-editor scroll-mt-4" open={open} data-testid="duplicates">
  <summary>{t(lang, 'admin.reg.bo.duplicates')} ({groups.length})</summary>
  <div class="gathering-editor-inner">
    <p class="text-sm text-ink-muted">{t(lang, 'admin.reg.bo.duplicatesHint')}</p>
    {groups.length === 0 ? (
      <p class="mt-3 text-sm text-ink-muted">{t(lang, 'admin.reg.bo.duplicatesNone')}</p>
    ) : (
      <ul class="mt-3 space-y-3">
        {groups.map((g) => (
          <li class="rounded-md border border-border p-3 text-sm" data-duplicate-kind={g.kind}>
            <p class="font-medium">{t(lang, `admin.reg.bo.dup.${g.kind}`)}: <span class="break-all text-ink-muted">{g.key}</span></p>
            <ul class="mt-2 space-y-1">
              {g.members.map((m) => (
                <li class="flex flex-wrap items-center gap-x-3">
                  <a class="font-semibold text-primary hover:underline" href={`${base}?reg=${m.registrationId}#reg-drawer`}>{m.confirmationNo ?? `#${m.registrationId}`}</a>
                  <span>{m.name}</span>
                  <span class="break-all text-xs text-ink-muted">{m.email}</span>
                  <span class="gathering-roster-status" data-status={m.status}>{t(lang, `admin.reg.status.${m.status}`)}</span>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    )}
  </div>
</details>
