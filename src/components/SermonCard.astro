---
import { localePath, type Locale } from '../lib/locales';
import { formatDate } from '../lib/dates';
import { t } from '../lib/i18n';
import type { LatestSermonRow } from '../lib/publicDb';
import DesignImage from './ui/DesignImage.astro';
import Icon from './ui/Icon.astro';
interface Props { sermon: LatestSermonRow; locale: Locale }
const { sermon, locale } = Astro.props;
const meta = [sermon.speaker, sermon.scripture].filter(Boolean).join(' · ');
---
<a href={localePath(locale, '/sermons')} class="featured-sermon">
  <div class="featured-sermon-photo"><DesignImage image="sermons" class="h-full w-full object-cover" /><span class="featured-play"><Icon name="play" size={22}/></span></div>
  <div class="featured-sermon-copy">
    <p class="section-eyebrow">{sermon.series || t(locale, 'home.sermonEyebrow')}</p>
    <h3>{sermon.title}</h3>
    {meta && <p class="text-ink-muted">{meta}</p>}
    <p class="text-sm text-ink-muted">{formatDate(sermon.sermon_date, locale)}</p>
    <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-primary">{t(locale, 'home.watchSermon')} <Icon name="arrow" size={17}/></span>
  </div>
</a>
