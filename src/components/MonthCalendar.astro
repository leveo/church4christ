---
// Server-rendered month grid for /my and /my/calendar: assignment status dots
// (U warn / C success / D danger) and blockout shading per day, plus a legend.
// Ported from the reference stack's src/components/MonthCalendar.astro, restyled with
// design tokens only and given an explicit locale prop (no Astro.locals.lang).
import { t } from '../lib/i18n';
import type { Locale } from '../lib/locales';
import type { DayMark } from '../lib/calendar';

interface Props {
  locale: Locale;
  year: number;
  month: number; // 1-12
  marks: Map<string, DayMark>;
  today: string;
}
const { locale, year, month, marks, today } = Astro.props;

const first = new Date(Date.UTC(year, month - 1, 1));
const daysInMonth = new Date(Date.UTC(year, month, 0)).getUTCDate();
const leading = first.getUTCDay(); // 0 = Sunday
const cells: (number | null)[] = [
  ...Array.from({ length: leading }, () => null),
  ...Array.from({ length: daysInMonth }, (_, i) => i + 1),
];
while (cells.length % 7 !== 0) cells.push(null);

const dayNames =
  locale === 'zh' ? ['日', '一', '二', '三', '四', '五', '六'] : ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const dateStr = (d: number) => `${year}-${String(month).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
const dot = { U: 'bg-warn', C: 'bg-success', D: 'bg-danger' } as const;
---

<div class="calendar-frame">
  <table class="month-calendar">
    <caption class="sr-only">{`${year}-${String(month).padStart(2, '0')}`}</caption>
    <thead><tr>{dayNames.map(day => <th scope="col">{day}</th>)}</tr></thead>
    <tbody>{Array.from({ length: cells.length / 7 }, (_, week) => (
      <tr>{cells.slice(week * 7, week * 7 + 7).map(day => {
        const mark = day ? marks.get(dateStr(day)) : undefined;
        return <td class:list={[mark?.blocked && 'calendar-blocked']}>
          {day && <>
            <time datetime={dateStr(day)} aria-current={dateStr(day) === today ? 'date' : undefined}>{day}</time>
            <ul class="calendar-day-items">
              {mark?.statuses.map(status => <li><span class={`calendar-dot ${dot[status]}`} aria-hidden="true" /><span>{t(locale, `serve.status.${status}`)}</span></li>)}
              {mark?.events?.map(name => <li><span class="calendar-dot bg-info" aria-hidden="true" /><span>{name}</span></li>)}
              {mark?.meetings?.map(name => <li><span class="calendar-dot bg-accent" aria-hidden="true" /><span>{name}</span></li>)}
              {mark?.blocked && <li class="calendar-blocked-label">{t(locale, 'my.cal.blockedOut')}</li>}
            </ul>
          </>}
        </td>;
      })}</tr>
    ))}</tbody>
  </table>
</div>
<div class="mt-3 flex flex-wrap gap-4 text-xs text-ink-muted">
  <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-success" />{t(locale, 'serve.status.C')}</span>
  <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-warn" />{t(locale, 'serve.status.U')}</span>
  <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-danger" />{t(locale, 'serve.status.D')}</span>
  <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-info" />{t(locale, 'portal.calendar.legendEvent')}</span>
  <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-accent" />{t(locale, 'portal.calendar.legendMeeting')}</span>
</div>
<style>
  .calendar-frame { border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; background: var(--color-surface-raised); }
  .month-calendar { width: 100%; table-layout: fixed; border-collapse: collapse; }
  .month-calendar th { padding: .85rem .25rem; font-size: .7rem; font-weight: 600; color: var(--color-ink-muted); background: var(--color-surface-sunken); }
  .month-calendar td { vertical-align: top; height: 105px; padding: .5rem; border: 1px solid var(--color-border); }
  .month-calendar td:first-child { border-left: 0; }
  .month-calendar td:last-child { border-right: 0; }
  .month-calendar tr:last-child td { border-bottom: 0; }
  .month-calendar time { display: inline-flex; align-items: center; justify-content: center; width: 1.75rem; height: 1.75rem; font-size: .8rem; }
  .month-calendar time[aria-current] { border-radius: var(--radius-full); background: var(--color-primary); color: var(--color-on-primary); font-weight: 600; }
  .calendar-day-items { margin-top: .3rem; display: grid; gap: .3rem; }
  .calendar-day-items li { display: flex; gap: .25rem; font-size: .65rem; line-height: 1.4; overflow-wrap: anywhere; }
  .calendar-dot { flex: 0 0 5px; width: 5px; height: 5px; border-radius: var(--radius-full); margin-top: .3rem; }
  .calendar-blocked { background: var(--color-surface-sunken); }
  .calendar-blocked-label { color: var(--color-ink-muted); }
  @media (max-width: 639px) { .month-calendar td { padding: .2rem; height: 85px; } .calendar-day-items li { font-size: .55rem; } .calendar-dot { display: none; } }
</style>
