---
interface Props { mode?: 'admin' | 'public' | 'kiosk' }
const { mode = 'admin' } = Astro.props;
---
<div class={`gathering-surface gathering-${mode}`}><slot /></div>
<style>
  .gathering-surface { width: 100%; min-width: 0; }
  .gathering-surface :global(.gathering-heading) { display: flex; align-items: flex-start; flex-wrap: wrap; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
  .gathering-surface :global(.gathering-eyebrow) { color: var(--color-primary); font-size: .6875rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; margin-bottom: .5rem; }
  .gathering-surface :global(.gathering-heading h1) { font-family: var(--font-body); font-size: clamp(1.5rem, 2.5vw, 1.8rem); line-height: 1.2; font-weight: 650; letter-spacing: -.025em; overflow-wrap: anywhere; }
  .gathering-surface :global(.gathering-intro) { max-width: 48rem; margin-top: .6rem; color: var(--color-ink-muted); font-size: .875rem; line-height: 1.75; }
  .gathering-surface :global(.gathering-actions) { display: flex; align-items: center; flex-wrap: wrap; gap: .65rem; }
  .gathering-surface :global(.gathering-section-heading) { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin: 1.5rem 0 1rem; }
  .gathering-surface :global(.gathering-section-heading h2) { font-size: 1rem; font-weight: 650; }
  .gathering-surface :global(.gathering-panel) { padding: 1.25rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface-raised); box-shadow: none; }
  .gathering-surface :global(.gathering-panel h2) { font-family: var(--font-body); font-size: 1rem; font-weight: 650; }
  .gathering-surface :global(.gathering-table-wrap) { overflow-x: auto; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface-raised); }
  .gathering-surface :global(.gathering-table) { width: 100%; border-collapse: collapse; font-size: .8125rem; }
  .gathering-surface :global(.gathering-table th) { padding: .7rem 1rem; background: var(--color-surface-sunken); font-size: .625rem; color: var(--color-ink-muted); letter-spacing: .07em; text-transform: uppercase; font-weight: 700; }
  .gathering-surface :global(.gathering-table td) { padding: .9rem 1rem; border-top: 1px solid var(--color-border); vertical-align: middle; font-size: .8125rem; }
  .gathering-surface :global(.gathering-table td:nth-child(1)) { font-weight: 600; }
  .gathering-surface :global(.gathering-stats) { display: flex; flex-wrap: wrap; border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 1rem 1.25rem; gap: 1.25rem 2.5rem; margin: 1.5rem 0; background: var(--color-surface-raised); }
  .gathering-surface :global(.gathering-stats > div) { min-width: 7rem; }
  .gathering-surface :global(.gathering-stats dt) { font-size: .6875rem; color: var(--color-ink-muted); }
  .gathering-surface :global(.gathering-stats dd) { font-size: 1.65rem; line-height: 1.3; font-weight: 650; color: var(--color-primary); margin-top: .35rem; font-variant-numeric: tabular-nums; }
  .gathering-surface :global(.gathering-editor) { margin: 1.5rem 0; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface-raised); }
  .gathering-surface :global(.gathering-editor > summary) { cursor: pointer; padding: 1.1rem 1.25rem; font-size: .875rem; font-weight: 650; color: var(--color-primary); }
  .gathering-surface :global(.gathering-editor > form) { max-width: none; margin: 0; }
  .gathering-surface :global(.gathering-editor > form > section) { border: 0; border-top: 1px solid var(--color-border); border-radius: 0; box-shadow: none; }
  .gathering-surface :global(.gathering-editor-inner) { padding: 0 1.25rem 1.25rem; }
  .gathering-surface :global(.gathering-editor-inner > form) { max-width: none; }
  .gathering-surface :global(.gathering-editor-inner [data-q-row]) { border-radius: var(--radius-sm); box-shadow: none; padding: 1rem; }
  .gathering-surface :global(.gathering-tabs) { display: flex; gap: .35rem; flex-wrap: wrap; padding: .35rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface-raised); margin: 1.25rem 0; }
  .gathering-surface :global(.gathering-tabs a) { display: inline-flex; align-items: center; gap: .5rem; padding: .7rem 1rem; color: var(--color-ink-muted); font-size: .8125rem; font-weight: 600; border-radius: var(--radius-sm); }
  .gathering-surface :global(.gathering-tabs a[aria-current="page"]) { background: var(--color-primary); color: var(--color-on-primary); }
  .gathering-surface :global(.gathering-identity) { display: flex; align-items: center; gap: .7rem; min-width: 10rem; }
  .gathering-surface :global(.gathering-roster-status) { display: inline-block; border: 1px solid var(--color-border); border-radius: var(--radius-full); padding: .2rem .55rem; background: var(--color-surface); font-size: .6875rem; font-weight: 600; }
  .gathering-surface :global(.gathering-roster-status[data-status="confirmed"]) { border-color: var(--color-success); background: var(--color-success-soft); color: var(--color-success); }
  .gathering-surface :global(.gathering-roster-status[data-status="waiting"]) { border-color: var(--color-warn); background: var(--color-warn-soft); color: var(--color-warn); }
  .gathering-surface :global(.gathering-registration-list) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  .gathering-surface :global(.gathering-registration-card) { display: flex; align-items: flex-start; gap: 1.25rem; padding: 1.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface-raised); }
  .gathering-surface :global(.gathering-registration-card h2) { font-family: var(--font-display); font-size: 1.5rem; font-weight: 550; line-height: 1.25; }
  .gathering-surface :global(.gathering-registration-card h2 a:hover) { color: var(--color-primary); text-decoration: underline; }
  .gathering-surface :global(.gathering-registration-card > div) { flex: 1; min-width: 0; }
  .gathering-surface :global(.gathering-registration-detail) { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 2.5rem; padding-block: 2.5rem 4rem; align-items: start; }
  .gathering-surface :global(.gathering-registration-about) { position: sticky; top: 1.5rem; }
  .gathering-surface :global(.gathering-registration-about > img) { width: 100%; aspect-ratio: 1.8; object-fit: cover; border-radius: var(--radius-sm); margin-bottom: 1.5rem; }
  .gathering-surface :global(.gathering-registration-about h1) { font-family: var(--font-display); font-size: clamp(1.9rem, 3.5vw, 3rem); font-weight: 550; line-height: 1.15; letter-spacing: -.025em; }
  .gathering-surface :global(.gathering-registration-form) { padding: 1.75rem; border: 1px solid var(--color-border); border-top: 3px solid var(--color-primary); border-radius: var(--radius-sm); background: var(--color-surface-raised); }
  .gathering-surface :global(.gathering-registration-form h2) { font-size: 1.125rem; font-weight: 650; }
  .gathering-surface :global(.gathering-registration-form input), .gathering-surface :global(.gathering-registration-form select) { min-height: 2.75rem; }
  .gathering-surface :global(.gathering-registration-form input[type="radio"]), .gathering-surface :global(.gathering-registration-form input[type="checkbox"]) { min-height: auto; }
  .gathering-surface :global(.gathering-flow) { display: flex; gap: 1.25rem; flex-wrap: wrap; margin: 1.25rem 0; padding: 0; list-style: none; font-size: .75rem; color: var(--color-ink-muted); }
  .gathering-surface :global(.gathering-flow li) { display: flex; align-items: center; gap: .5rem; }
  .gathering-surface :global(.gathering-flow b) { display: grid; width: 1.65rem; height: 1.65rem; place-items: center; border: 1px solid var(--color-border); border-radius: var(--radius-full); font-size: .6875rem; }
  .gathering-surface :global(.gathering-flow [aria-current="step"]) { color: var(--color-primary); font-weight: 650; }
  .gathering-surface :global(.gathering-flow [aria-current="step"] b) { background: var(--color-primary); border-color: var(--color-primary); color: var(--color-on-primary); }
  .gathering-surface :global(.gathering-complete) { max-width: 40rem; margin: 3rem auto; padding: 2.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface-raised); text-align: center; }
  .gathering-surface :global(.gathering-complete-icon) { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: var(--radius-full); background: var(--color-primary-soft); color: var(--color-on-primary-soft); margin: 0 auto 1.5rem; }
  .gathering-surface :global(.gathering-children-banner) { display: grid; grid-template-columns: 1fr 11rem; align-items: center; gap: 1.5rem; border-bottom: 1px solid var(--color-border); margin-bottom: 1rem; padding-bottom: 1.5rem; }
  .gathering-surface :global(.gathering-children-banner img) { width: 100%; aspect-ratio: 1.8; object-fit: cover; border-radius: var(--radius-sm); }
  .gathering-surface :global(.gathering-kiosk-panel) { display: grid; grid-template-columns: minmax(0, 1fr) minmax(15rem, .6fr); align-items: center; gap: 1.5rem; }
  .gathering-surface :global(.gathering-kiosk-panel img) { width: 100%; border-radius: var(--radius-sm); }
  .gathering-kiosk :global(.kiosk-welcome) { position: relative; overflow: hidden; min-height: 13rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); margin: 1.25rem 0; padding: 2rem 3rem; display: flex; flex-direction: column; justify-content: center; text-align: center; }
  .gathering-kiosk :global(.kiosk-scene) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 70%; z-index: 0; }
  .gathering-kiosk :global(.kiosk-welcome > div) { position: relative; max-width: 28rem; margin: auto; padding: .65rem; border-radius: var(--radius-sm); background: color-mix(in srgb, var(--color-surface) 88%, transparent); }
  .gathering-kiosk :global(.kiosk-welcome h1) { font-family: var(--font-body); font-size: clamp(1.8rem, 4vw, 2.25rem); font-weight: 650; line-height: 1.2; }
  .gathering-kiosk :global(.kiosk-welcome p) { margin-top: .65rem; font-size: 1rem; line-height: 1.65; color: var(--color-ink-muted); }
  .gathering-kiosk :global(.kiosk-search-panel) { padding: 1.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface-raised); }
  .gathering-kiosk :global(.kiosk-search-panel label) { font-size: 1rem; font-weight: 650; }
  .gathering-kiosk :global(.kiosk-search-panel input), .gathering-kiosk :global(.kiosk-search-panel button) { min-height: 3.5rem; font-size: 1.125rem; border-radius: var(--radius-sm); }
  .gathering-kiosk :global(.kiosk-result) { display: flex; gap: 1rem; align-items: center; padding: 1.25rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface-raised); }
  .gathering-kiosk :global(.kiosk-result:hover) { border-color: var(--color-primary); background: var(--color-primary-soft); }
  .gathering-kiosk :global(.kiosk-result p) { font-size: .9375rem; }.gathering-kiosk :global(.kiosk-result p:first-child) { font-size: 1.25rem; }
  .gathering-kiosk :global(.kiosk-section) { padding: 1.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface-raised); }
  .gathering-kiosk :global(.kiosk-section h2) { font-size: 1.25rem; font-weight: 650; }
  .gathering-kiosk :global(.kiosk-choice input:focus-visible + span) { outline: 3px solid var(--color-ring); outline-offset: 3px; }
  .gathering-kiosk :global(.kiosk-choice > span) { display: flex; align-items: center; justify-content: center; gap: .75rem; min-height: 6rem; padding: 1rem; font-size: 1.2rem; border-radius: var(--radius-sm); }
  .gathering-kiosk :global(.kiosk-choice input:checked + span::after) { content: '✓'; color: var(--color-primary); }
  .gathering-kiosk :global(.kiosk-confirmation) { padding: 2rem 1.5rem; border: 1px solid var(--color-border); border-top: 4px solid var(--color-success); border-radius: var(--radius-md); background: var(--color-surface-raised); margin-top: 1.25rem; }
  .gathering-kiosk :global(.kiosk-pickup-code) { padding: 1rem 1.5rem; background: var(--color-primary-soft); color: var(--color-on-primary-soft); border: 1px dashed var(--color-primary); border-radius: var(--radius-sm); font-family: var(--font-mono); font-size: clamp(2.5rem, 9vw, 4.5rem); }
  .gathering-kiosk :global(.kiosk-checkout input), .gathering-kiosk :global(.kiosk-checkout button) { min-height: 3.25rem; }
  .gathering-kiosk :global(.kiosk-checkout input) { font-family: var(--font-mono); }
  @media (max-width: 900px) { .gathering-surface :global(.gathering-registration-detail) { grid-template-columns: 1fr; gap: 1.5rem; } .gathering-surface :global(.gathering-registration-about) { position: static; } .gathering-surface :global(.gathering-registration-about > img) { aspect-ratio: 2.4; } .gathering-surface :global(.gathering-kiosk-panel) { grid-template-columns: 1fr; } }
  @media (max-width: 640px) { .gathering-surface :global(.gathering-registration-list) { grid-template-columns: 1fr; } .gathering-surface :global(.gathering-registration-card) { padding: 1rem; gap: 1rem; } .gathering-surface :global(.gathering-registration-form) { padding: 1.25rem; } .gathering-surface :global(.gathering-children-banner) { grid-template-columns: 1fr; } .gathering-surface :global(.gathering-children-banner img) { display: none; } .gathering-kiosk :global(.kiosk-welcome) { padding: 1rem; min-height: 11rem; } .gathering-kiosk :global(.kiosk-section) { padding: 1rem; } .gathering-surface :global(.gathering-complete) { margin: 2rem 1rem; padding: 1.5rem; } }
</style>

<style>
  @media (max-width: 480px) { .gathering-kiosk :global(.kiosk-section > .grid) { grid-template-columns: minmax(0, 1fr); } }
</style>
