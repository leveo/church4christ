---
// Sticky site header. The admin-ordered links are condensed into audience
// groups on desktop and mobile so a fully enabled installation stays calm.
// Both layers use native disclosures and need no navigation JavaScript.
import { localePath } from '../lib/locales';
import { t } from '../lib/i18n';
import { getSiteIdentity, getLogoImageKey } from '../lib/settings';
import { mediaPath } from '../lib/mediaRef';
import { groupNavLinks, resolveDefaultNav, resolveNav } from '../lib/nav';
import Icon from './ui/Icon.astro';
import DesignImage from './ui/DesignImage.astro';
import type { DesignImage as DesignImageKey } from '../lib/designAssets';
import LocaleSwitch from './LocaleSwitch.astro';

interface Props { privateMetadata?: boolean }
const { privateMetadata = false } = Astro.props;

const locale = Astro.locals.locale;
const home = localePath(locale, '/');
const give = localePath(locale, '/give');

const db = Astro.locals.db;
const modules = Astro.locals.modules;
// Site identity + logo + the nav menu come from admin-editable settings; a DB
// hiccup falls back to the pre-feature hardcoded name, no logo, and the
// module-gated default nav rather than 500ing the header on every public page
// (mirrors Base.astro's identity guard).
let siteName = t(locale, 'site.name');
let logoSrc = '';
let links = resolveDefaultNav(locale, modules);
try {
  const identity = await getSiteIdentity(db, locale);
  siteName = identity.name || t(locale, 'site.name');
  const logoKey = await getLogoImageKey(db);
  logoSrc = logoKey ? (mediaPath(logoKey) ?? '') : '';
  links = await resolveNav(db, locale, modules);
} catch {
  /* keep the hardcoded site name, no logo, and the default nav when settings are unavailable */
}
const groups = groupNavLinks(links, locale);
const groupImages: Record<string, DesignImageKey> = { welcome: 'welcome', explore: 'sermons', connect: 'groups', participate: 'worship', more: 'learning' };
const memberHome = modules.has('portal') || modules.has('serve');
const memberPath = modules.has('serve') ? '/my' : '/my/opportunities';
---

<header class="sticky top-0 z-40 bg-header-bg text-header-ink border-b border-border">
  <div class="container-wide relative flex items-center gap-4 h-20">
    <a href={home} class="font-display font-bold text-lg whitespace-nowrap shrink-0 flex items-center gap-2">
      {logoSrc ? <img src={logoSrc} alt="" class="h-8 w-auto" /> : <Icon name="leaf" size={27} class="text-primary"/>}
      <span>{siteName}</span>
    </a>

    <nav
      class="hidden lg:flex flex-1 items-center justify-center gap-1 text-sm"
      aria-label={t(locale, 'common.menu')}
    >
      {
        groups.map((group) => (
          <details class="group site-nav-disclosure" name="site-navigation">
            <summary class="flex cursor-pointer list-none items-center gap-1 rounded-md px-3 py-2 font-semibold hover:bg-surface-raised [&::-webkit-details-marker]:hidden">
              {group.label}
              <span aria-hidden="true" class="text-xs text-ink-muted transition-transform group-open:rotate-180">⌄</span>
            </summary>
            <div class="site-mega-menu">
              <div class="site-mega-links">
                <p class="section-eyebrow">{group.label}</p>
                {group.links.map(link => <a href={link.href}>{link.label}<Icon name="arrow" size={16}/></a>)}
              </div>
              <div class="site-mega-feature"><DesignImage image={groupImages[group.key]} class="h-40 w-full object-cover rounded-md" /><p>{t(locale, `design.menu.${group.key}`)}</p></div>
            </div>
          </details>
        ))
      }
    </nav>

    <div class="hidden lg:flex items-center gap-3 shrink-0">
      {
        locale === 'zh' && (
          <button
            type="button"
            data-zh-toggle
            data-no-convert
            class="px-2.5 py-1 rounded-md border border-border text-sm font-semibold hover:bg-surface-raised cursor-pointer"
            aria-label={t(locale, 'common.zhToggleAria')}
          >
            {t(locale, 'common.zhToggleToTrad')}
          </button>
        )
      }
      {!privateMetadata && <LocaleSwitch />}
      <a
        href={memberHome ? localePath(locale, memberPath) : give}
        class="px-4 py-2 rounded-md bg-primary text-on-primary font-semibold hover:bg-primary-hover"
      >
        {t(locale, memberHome ? 'design.menu.myChurch' : 'nav.give')}
      </a>
    </div>

    {/* Mobile disclosure: checkbox toggles the panel, no framework needed. */}
    <input type="checkbox" id="c4c-nav" class="peer sr-only" />
    <label
      for="c4c-nav"
      class="lg:hidden ml-auto cursor-pointer p-2 min-w-11 min-h-11 flex flex-col items-center justify-center gap-1.5"
      aria-label={t(locale, 'common.menu')}
    >
      <span class="block w-6 h-0.5 bg-current"></span>
      <span class="block w-6 h-0.5 bg-current"></span>
      <span class="block w-6 h-0.5 bg-current"></span>
    </label>
    <nav
      class="hidden peer-checked:block absolute top-20 inset-x-0 bg-header-bg text-header-ink border-b border-border shadow-lg lg:hidden max-h-[80vh] overflow-y-auto"
      aria-label={t(locale, 'common.menu')}
    >
      <div class="container-wide py-4 flex flex-col gap-3">
        {
          groups.map((group) => (
            <section class="rounded-xl border border-border bg-surface px-4 py-3">
              <h2 class="text-xs font-bold uppercase tracking-wider text-ink-muted">{group.label}</h2>
              <div class="mt-1 grid gap-0.5 sm:grid-cols-2">
                {group.links.map((link) => (
                  <a href={link.href} class="block rounded-md py-2 font-medium hover:text-primary">
                    {link.label}
                  </a>
                ))}
              </div>
            </section>
          ))
        }
        <a
          href={give}
          class="block mt-3 px-4 py-2 rounded-full bg-accent text-on-accent text-center font-semibold"
        >
          {t(locale, 'nav.give')}
        </a>
        <div class="mt-3 flex justify-center items-center gap-4">
          {
            locale === 'zh' && (
              <button
                type="button"
                data-zh-toggle
                data-no-convert
                class="px-2.5 py-1 rounded-md border border-border text-sm font-semibold hover:bg-surface-raised cursor-pointer"
                aria-label={t(locale, 'common.zhToggleAria')}
              >
                {t(locale, 'common.zhToggleToTrad')}
              </button>
            )
          }
          {!privateMetadata && <LocaleSwitch />}
        </div>
      </div>
    </nav>
  </div>
</header>
