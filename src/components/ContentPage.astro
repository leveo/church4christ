---
// Editorial reading shell with optional contextual photography and a practical
// sidebar. Localized content visibility and prose typography remain caller-owned.
import Base from '../layouts/Base.astro';
import DesignImage from './ui/DesignImage.astro';
import type { DesignImage as ImageKey } from '../lib/designAssets';
import { t } from '../lib/i18n';
import type { Locale } from '../lib/locales';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  /** false → render the "showing English version" notice. */
  translated?: boolean;
  noindex?: boolean;
  image?: ImageKey;
  eyebrow?: string;
}

const { title, description, locale, translated = true, noindex = false, image, eyebrow } = Astro.props;
---

<Base title={title} description={description} locale={locale} noindex={noindex}>
  <div class="content-page container-content">
    <header class:list={['content-intro', { 'content-intro-photo': image }]}>
      <div>
      {eyebrow && <p class="section-eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {description && <p class="content-description">{description}</p>}
      {
        Astro.slots.has('subtitle') && (
          <div class="mt-3 text-lg">
            <slot name="subtitle" />
          </div>
        )
      }
      </div>
      {image && <div class="content-cover"><DesignImage image={image} eager class="h-full w-full object-cover" /></div>}
    </header>

  <div class:list={['content-body', { 'content-with-aside': Astro.slots.has('aside') }]}>
    <div class="content-reading">
    {
      !translated && (
        <p class="mb-8 rounded-md border border-border bg-info-soft text-info px-4 py-3 text-sm">
          {t(locale, 'content.notTranslated')}
        </p>
      )
    }
    {
      Astro.slots.has('before') && (
        <div class="mb-8">
          <slot name="before" />
        </div>
      )
    }
    <article class="prose"><slot /></article>
    {
      Astro.slots.has('after') && (
        <div class="mt-10">
          <slot name="after" />
        </div>
      )
    }
    </div>
    {Astro.slots.has('aside') && <aside class="content-aside"><slot name="aside" /></aside>}
  </div>
  </div>
</Base>
<style>
  .content-page { padding-bottom: 4rem; }
  .content-intro { padding-block: 3.5rem 2.5rem; border-bottom: 1px solid var(--color-border); }
  .content-intro-photo { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, .8fr); gap: 4rem; align-items: center; }
  h1 { font-family: var(--font-display); font-size: clamp(2.5rem, 5vw, 4.5rem); line-height: 1.08; letter-spacing: -.04em; color: var(--color-primary); overflow-wrap: anywhere; margin-top: .8rem; }
  .content-description { margin-top: 1.25rem; max-width: 40rem; color: var(--color-ink-muted); font-size: 1.1rem; line-height: 1.8; }
  .content-cover { border-radius: var(--radius-lg); overflow: hidden; height: 280px; }
  .content-body { padding-top: 2.5rem; }
  .content-reading { max-width: 760px; min-width: 0; }
  .content-with-aside { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 3.5rem; }
  .content-aside { position: sticky; top: 7rem; align-self: start; min-width: 0; }
  @media (max-width: 800px) { .content-intro { padding-block: 2rem; } .content-intro-photo, .content-with-aside { grid-template-columns: 1fr; gap: 1.75rem; } .content-cover { height: 200px; } .content-aside { position: static; grid-row: 1; } }
</style>
