---
// Ministries tab: a summary table (name, category, team / member / open-role
// counts, active toggle) with a per-row collapsible "edit basics" form.
import { t } from '../../lib/i18n';
import type { Locale } from '../../lib/locales';
import type { MinistrySummary, MinistryEditRow } from '../../lib/ministryDb';
import { card, th, td, tin, lab, btn, btnSecondary, badge, badgeActive, badgeInactive } from '../../lib/adminUi';
import { mediaPath } from '../../lib/mediaRef';

interface Props {
  lang: Locale;
  title: string;
  ministries: MinistrySummary[];
  editRows: MinistryEditRow[];
  categories: { value: string; label: string }[];
  leaders: { id: number; name: string }[];
}
const { lang, title, ministries, editRows, categories, leaders } = Astro.props;
const editOf = (id: number) => editRows.find((r) => r.id === id);
---
<div class={card}>
  <div class="flex items-center gap-3 flex-wrap">
    <h2 class="font-display text-heading-sm font-bold">{title}</h2>
    <a href="/admin/ministries?tab=new" class={`ml-auto ${btn}`}>{t(lang, 'admin.console.newMinistryBtn')}</a>
  </div>

  {ministries.length === 0 ? (
    <p class="mt-6 text-sm text-ink-muted">{t(lang, 'admin.console.noMinistries')}</p>
  ) : (
    <>
    <ul class="mt-4 grid gap-3 sm:hidden" data-ministry-cards>
      {ministries.map((m) => (
        <li class="rounded-lg border border-border bg-surface-raised p-4">
          <div class="flex items-start justify-between gap-3">
            <p class="text-base font-semibold">{m.icon} {m.name}</p>
            <span class={`${badge} ${m.active === 1 ? badgeActive : badgeInactive}`}>{t(lang, m.active === 1 ? 'admin.console.active' : 'admin.console.disabled')}</span>
          </div>
          <dl class="mt-3 grid grid-cols-3 gap-2 text-center text-sm">
            <div><dt class="text-xs text-ink-muted">{t(lang, 'admin.console.col.teams')}</dt><dd class="font-semibold">{m.team_count}</dd></div>
            <div><dt class="text-xs text-ink-muted">{t(lang, 'admin.console.col.members')}</dt><dd class="font-semibold">{m.member_count}</dd></div>
            <div><dt class="text-xs text-ink-muted">{t(lang, 'admin.console.col.openRoles')}</dt><dd class="font-semibold">{m.open_count}</dd></div>
          </dl>
          <div class="mt-3 grid grid-cols-2 gap-2">
            <a href={`/${lang}/serve/matrix`} class={btnSecondary}>{t(lang, 'admin.console.schedule')}</a>
            {editOf(m.id) && <a href={`#ministry-edit-${m.id}`} data-open-edit class={btnSecondary}>{t(lang, 'admin.console.editBasics')}</a>}
            <form method="post" class="col-span-2">
              <input type="hidden" name="ministry_id" value={m.id} />
              <input type="hidden" name="active" value={m.active === 1 ? '0' : '1'} />
              <button name="_action" value="toggleMinistry" class={`${btnSecondary} w-full`}>{t(lang, m.active === 1 ? 'admin.console.disable' : 'admin.console.enable')}</button>
            </form>
          </div>
        </li>
      ))}
    </ul>
    <div class="mt-4 hidden overflow-x-auto rounded-xl border border-border sm:block">
      <table class="w-full border-collapse text-sm min-w-[44rem]">
        <thead class="bg-surface-sunken">
          <tr>
            <th class={th}>{t(lang, 'admin.console.col.ministry')}</th>
            <th class={`${th} text-center`}>{t(lang, 'admin.console.col.teams')}</th>
            <th class={`${th} text-center`}>{t(lang, 'admin.console.col.members')}</th>
            <th class={`${th} text-center`}>{t(lang, 'admin.console.col.openRoles')}</th>
            <th class={th}>{t(lang, 'admin.console.col.status')}</th>
            <th class={th}></th>
          </tr>
        </thead>
        <tbody>
          {ministries.map((m) => (
            <tr class="border-t border-border">
              <td class={`${td} font-semibold whitespace-nowrap`}>{m.icon} {m.name}</td>
              <td class={`${td} text-center text-ink-muted`}>{m.team_count}</td>
              <td class={`${td} text-center text-ink-muted`}>{m.member_count}</td>
              <td class={`${td} text-center`}>{m.open_count > 0 ? <span class="font-semibold text-primary">{m.open_count}</span> : <span class="text-ink-subtle">0</span>}</td>
              <td class={td}>
                <span class={`${badge} ${m.active === 1 ? badgeActive : badgeInactive}`}>{t(lang, m.active === 1 ? 'admin.console.active' : 'admin.console.disabled')}</span>
              </td>
              <td class={`${td} text-right whitespace-nowrap`}>
                <span class="inline-flex gap-2 items-center">
                  <a href={`/${lang}/serve/matrix`} class="inline-flex min-h-9 items-center px-1 text-primary hover:underline text-xs font-semibold">{t(lang, 'admin.console.schedule')}</a>
                  {editOf(m.id) && <a href={`#ministry-edit-${m.id}`} data-open-edit class="inline-flex min-h-9 items-center px-1 text-primary hover:underline text-xs font-semibold">{t(lang, 'admin.console.editBasics')}</a>}
                  <form method="post" class="inline">
                    <input type="hidden" name="ministry_id" value={m.id} />
                    <input type="hidden" name="active" value={m.active === 1 ? '0' : '1'} />
                    <button name="_action" value="toggleMinistry" class="min-h-9 px-1 text-xs font-semibold text-ink-muted hover:text-danger">{t(lang, m.active === 1 ? 'admin.console.disable' : 'admin.console.enable')}</button>
                  </form>
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-6 grid gap-3" data-ministry-edit-list>
      {ministries.map((m) => {
        const e = editOf(m.id);
        if (!e) return null;
        const coverSrc = mediaPath(e.coverKey);
        return (
          <details id={`ministry-edit-${m.id}`} class="rounded-lg border border-border bg-surface-sunken px-4 py-1">
            <summary class="flex min-h-11 cursor-pointer items-center text-sm font-semibold text-primary">{t(lang, 'admin.console.editBasics')} · {m.icon} {m.name}</summary>
            <form method="post" class="mt-3 grid sm:grid-cols-2 gap-3">
              <input type="hidden" name="ministry_id" value={m.id} />
              <label><span class={lab}>{t(lang, 'admin.console.wiz.nameEn')}</span><input name="name_en" value={e.name_en ?? ''} class={tin} /></label>
              <label><span class={lab}>{t(lang, 'admin.console.wiz.nameZh')}</span><input name="name_zh" value={e.name_zh ?? ''} class={tin} /></label>
              <label><span class={lab}>{t(lang, 'admin.console.wiz.category')}</span>
                <select name="category" class={tin}>
                  {categories.map((c) => <option value={c.value} selected={c.value === e.category}>{c.label}</option>)}
                </select>
              </label>
              <label><span class={lab}>{t(lang, 'admin.console.wiz.icon')}</span><input name="icon" value={e.icon} class={tin} /></label>
              <label><span class={lab}>{t(lang, 'admin.console.wiz.leader')}</span>
                <select name="leader_person_id" class={tin}>
                  <option value="">{t(lang, 'admin.console.wiz.leaderNone')}</option>
                  {leaders.map((l) => <option value={l.id} selected={l.id === e.leader_person_id}>{l.name}</option>)}
                </select>
              </label>
              <div class="sm:col-span-2">
                <button name="_action" value="updateBasics" class={`${btn} w-full sm:w-auto`}>{t(lang, 'admin.console.saveBasics')}</button>
              </div>
            </form>
            <form method="post" enctype="multipart/form-data" class="mt-3 mb-3 grid gap-2 border-t border-border pt-3">
              <input type="hidden" name="ministry_id" value={m.id} />
              {
                coverSrc && (
                  <div class="space-y-1">
                    <span class={lab}>{t(lang, 'admin.console.currentCover')}</span>
                    <img src={coverSrc} alt="" class="h-32 w-full max-w-md rounded-md border border-border object-cover" loading="lazy" />
                  </div>
                )
              }
              <label class="block">
                <span class={lab}>{coverSrc ? t(lang, 'admin.console.changeCover') : t(lang, 'admin.console.coverImage')}</span>
                <input type="file" name="cover_image" accept="image/jpeg,image/png,image/webp,image/gif" class="w-full text-base sm:text-sm" />
              </label>
              <label class="flex min-h-11 items-center gap-2 text-sm">
                <input type="checkbox" name="remove_cover" class="h-5 w-5" /> {t(lang, 'admin.console.removeCover')}
              </label>
              <div>
                <button name="_action" value="updateCover" class={`${btn} w-full sm:w-auto`}>{t(lang, 'admin.console.saveCover')}</button>
              </div>
            </form>
          </details>
        );
      })}
    </div>
    </>
  )}
</div>

<script>
  // "Edit basics" links jump to the matching <details> below the list and open it.
  document.querySelectorAll<HTMLAnchorElement>('[data-open-edit]').forEach((link) => {
    link.addEventListener('click', () => {
      const target = document.getElementById(link.hash.slice(1));
      if (target instanceof HTMLDetailsElement) target.open = true;
    });
  });
</script>
