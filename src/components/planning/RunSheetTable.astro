---
// Read-only run sheet: a table from the sm breakpoint up, stacked cards on phones.
// The viewer's own items are highlighted; cue notes render only when showCue is set.
import { t } from '../../lib/i18n';
import type { Locale } from '../../lib/locales';
import type { RunSheetRow } from '../../lib/planningView';

interface Props { locale: Locale; rows: RunSheetRow[]; showCue?: boolean }
const { locale, rows, showCue = false } = Astro.props;
---
{rows.length === 0 && <p class="text-sm text-ink-muted">{t(locale, 'planning.rs.empty')}</p>}
{rows.length > 0 && (
  <>
    <table class="rs-table">
      <thead>
        <tr>
          <th scope="col">{t(locale, 'planning.rs.time')}</th>
          <th scope="col">{t(locale, 'planning.rs.duration')}</th>
          <th scope="col">{t(locale, 'planning.rs.item')}</th>
          <th scope="col">{t(locale, 'planning.rs.owner')}</th>
          {showCue && <th scope="col">{t(locale, 'planning.rs.cue')}</th>}
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr class:list={[r.item.kind === 'heading' && 'rs-heading', r.mine && 'rs-mine']}>
            <td class="tabular-nums">{r.timing.start}</td>
            <td class="tabular-nums">{r.item.duration_min > 0 ? t(locale, 'planning.rs.min', { n: r.item.duration_min }) : ''}</td>
            <td>
              <strong>{r.title}</strong>
              {r.mine && <span class="rs-badge">{t(locale, 'planning.rs.mine')}</span>}
              {r.details && <p class="rs-details">{r.details}</p>}
            </td>
            <td>{r.owner}</td>
            {showCue && <td class="rs-cue">{r.item.cue_notes}</td>}
          </tr>
        ))}
      </tbody>
    </table>
    <ol class="rs-cards">
      {rows.map((r) => (
        <li class:list={[r.item.kind === 'heading' && 'rs-heading', r.mine && 'rs-mine']}>
          <p class="rs-card-time tabular-nums">{r.timing.start}{r.item.duration_min > 0 && ` · ${t(locale, 'planning.rs.min', { n: r.item.duration_min })}`}</p>
          <p><strong>{r.title}</strong>{r.mine && <span class="rs-badge">{t(locale, 'planning.rs.mine')}</span>}</p>
          {r.owner && <p class="text-sm text-ink-muted">{r.owner}</p>}
          {r.details && <p class="rs-details">{r.details}</p>}
          {showCue && r.item.cue_notes && <p class="rs-cue">{r.item.cue_notes}</p>}
        </li>
      ))}
    </ol>
  </>
)}
<style>
  .rs-table { width: 100%; border-collapse: collapse; background: var(--color-surface-raised); border: 1px solid var(--color-border); border-radius: var(--radius-lg); }
  .rs-table th { padding: .6rem .75rem; text-align: left; font-size: .72rem; text-transform: uppercase; letter-spacing: .04em; color: var(--color-ink-subtle); background: var(--color-surface-sunken); }
  .rs-table td { padding: .6rem .75rem; border-top: 1px solid var(--color-border); vertical-align: top; font-size: .9rem; }
  .rs-heading td, .rs-heading { background: var(--color-surface-sunken); }
  .rs-mine td, .rs-cards .rs-mine { background: var(--color-primary-soft); }
  .rs-badge { margin-left: .5rem; padding: .1rem .5rem; border-radius: var(--radius-full); font-size: .7rem; font-weight: 600; background: var(--color-primary); color: var(--color-on-primary); }
  .rs-details { margin-top: .25rem; font-size: .85rem; color: var(--color-ink-muted); white-space: pre-line; }
  .rs-cue { font-size: .85rem; color: var(--color-ink-muted); white-space: pre-line; font-style: italic; }
  .rs-cards { display: none; gap: .75rem; padding: 0; list-style: none; }
  .rs-cards li { padding: .85rem 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface-raised); }
  .rs-card-time { font-size: .8rem; color: var(--color-ink-muted); }
  @media (max-width: 639px) { .rs-table { display: none; } .rs-cards { display: grid; } }
</style>
