---
// A single staff member on the team directory: avatar (image or initials
// fallback) + name + role, linking to the bio page. Token utilities only.
import { localePath, type Locale } from '../lib/locales';
import AvatarInitials from './AvatarInitials.astro';
import { frontdoorCopy } from '../i18n/designFrontdoor';

interface Props {
  name: string;
  role: string;
  slug: string;
  locale: Locale;
  avatar?: string;
}

const { name, role, slug, locale, avatar } = Astro.props;
---

<a
  href={localePath(locale, `/about/staff/${slug}`)}
  class="staff-card"
>
  {
    avatar ? (
        <img src={avatar} alt="" class="w-20 h-20 rounded-lg object-cover shrink-0" loading="lazy" />
    ) : (
      <AvatarInitials name={name} sizeClass="w-20 h-20 text-xl" />
    )
  }
  <div class="min-w-0">
    <p class="font-display text-lg font-semibold">{name}</p>
    <p class="mt-1 text-sm text-ink-muted">{role}</p>
    <span class="mt-4 block text-xs font-semibold text-primary">{frontdoorCopy(locale).readBio} →</span>
  </div>
</a>
<style>
  .staff-card { display: flex; align-items: center; gap: 1.25rem; padding: 1.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface-raised); }
  .staff-card:hover { border-color: var(--color-primary); }
</style>
