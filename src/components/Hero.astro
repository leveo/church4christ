---
import { localePath, type Locale } from '../lib/locales';
import { t } from '../lib/i18n';
import { mediaPath } from '../lib/mediaRef';
import DesignImage from './ui/DesignImage.astro';
import Icon from './ui/Icon.astro';
interface Props { locale: Locale; heroImageKey?: string }
const { locale, heroImageKey = '' } = Astro.props;
const sermonsOn = Astro.locals.modules.has('sermons');
---
<section class="welcome-hero container-wide">
  <div class="welcome-copy">
    <p class="section-eyebrow"><Icon name="leaf" size={18} /> {t(locale, 'design.home.eyebrow')}</p>
    <h1>{t(locale, 'design.home.title')}</h1>
    <p class="welcome-description">{t(locale, 'home.heroSubtitle')}</p>
    <div class="welcome-actions">
      <a href={localePath(locale, '/visit')} class="action-primary">{t(locale, 'nav.visit')} <Icon name="arrow" size={18}/></a>
      {sermonsOn && <a href={localePath(locale, '/sermons')} class="action-secondary"><Icon name="play" size={16}/>{t(locale, 'home.heroCtaSermons')}</a>}
    </div>
  </div>
  <div class="welcome-photo"><DesignImage image="welcome" src={mediaPath(heroImageKey)} eager class="h-full w-full object-cover" /></div>
</section>
