---
import type { Locale } from '../lib/locales';
import { t } from '../lib/i18n';
import { memberNavigation, type MemberNavKey } from '../lib/memberNavigation';
import Icon from './ui/Icon.astro';
export type PortalNavTab = MemberNavKey;
interface Props { locale: Locale; active: MemberNavKey; rail?: boolean }
const { locale, active, rail = false } = Astro.props;
const tabs = memberNavigation(Astro.locals.modules, locale);
---
<nav class:list={['portal-navigation', rail && 'portal-navigation-rail']} aria-label={t(locale, 'portal.nav.myPortal')}>
  {tabs.map(tab => (
    <a href={tab.href} aria-current={tab.key === active ? 'page' : undefined}>
      <Icon name={tab.icon} size={17} /><span>{tab.label}</span>
    </a>
  ))}
</nav>
<style>
  .portal-navigation { display: flex; gap: .25rem; overflow-x: auto; padding: .25rem 0 .5rem; }
  .portal-navigation a { display: flex; align-items: center; gap: .7rem; padding: .75rem .8rem; border-radius: var(--radius-md); font-size: .8rem; font-weight: 500; color: var(--color-ink-muted); white-space: nowrap; }
  .portal-navigation a:hover { background: var(--color-surface-sunken); color: var(--color-ink); }
  .portal-navigation a[aria-current] { background: var(--color-primary-soft); color: var(--color-on-primary-soft); font-weight: 650; box-shadow: inset 3px 0 var(--color-primary); }
  .portal-navigation-rail { flex-direction: column; overflow: visible; }
  @media (max-width: 1023px) { .portal-navigation-rail { flex-direction: row; overflow-x: auto; border-bottom: 1px solid var(--color-border); } .portal-navigation a[aria-current] { box-shadow: inset 0 -2px var(--color-primary); } .portal-navigation a { padding: .75rem; } }
</style>
