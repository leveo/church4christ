---
// Admin shell: shared theme/mode wiring, a role-gated dark sidebar nav (top bar
// + checkbox-hack disclosure on mobile), a repeat-row editor island
// (progressive enhancement for the content forms), and a sidebar-bottom block
// showing the signed-in email + a signout POST. Admin UI language follows
// the signed-in person's `lang` (falling back to English). Fonts are imported
// the same way Base.astro does so admin renders in the brand faces.
import WorkspaceNavigation from '../components/admin/WorkspaceNavigation.astro';
import Icon from '../components/ui/Icon.astro';
import { groupAdminLinks } from '../lib/adminNavigation';
import { localePath } from '../lib/locales';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/nunito';
import '@fontsource-variable/space-grotesk';
import '../styles/base.css';
import { getActiveTheme, THEME_DEFAULT, THEME_DEFAULT_MODE, type Theme } from '../lib/theme';
import { t } from '../lib/i18n';
import { getLogoImageKey } from '../lib/settings';
import { mediaPath } from '../lib/mediaRef';
import { paymentOperationsEnabled, type ModuleKey } from '../lib/modules';
import type { Locale } from '../lib/locales';
import { hasAreaAccess, type AdminAreaKey } from '../lib/adminAreas';
import { listCampusesForUser, type CampusRow } from '../lib/campusDb';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const user = Astro.locals.user;
const lang: Locale = user?.lang ?? 'en';
const theme = (Astro.locals.theme ?? THEME_DEFAULT) as Theme;
// Default color mode for the no-flash script comes from the `theme.default_mode`
// setting (cached per-isolate, warmed by middleware). Guarded so a DB hiccup
// falls back to the theme's intrinsic default rather than 500ing the page.
let defaultMode: 'light' | 'dark' = THEME_DEFAULT_MODE[theme] ?? 'light';
try {
  defaultMode = (await getActiveTheme(Astro.locals.db)).defaultMode;
} catch {
  /* keep the theme's intrinsic default mode */
}
const appName = t(lang, 'admin.title');
const fullTitle = title ? `${title} · ${appName}` : appName;

// Church logo mark for the sidebar/mobile-bar brand block, fetched the same
// guarded way Header.astro does — a settings hiccup renders no logo rather
// than 500ing the whole admin shell.
let logoSrc = '';
try {
  const logoKey = await getLogoImageKey(Astro.locals.db);
  logoSrc = logoKey ? (mediaPath(logoKey) ?? '') : '';
} catch {
  /* no logo when settings are unavailable */
}

// Nav renders by role. The dashboard shows for console-class users (admin ∪
// editor ∪ team leader); content (bulletins/sermons/prayer-sheets) + news
// (announcements/events) + the prayer wall need editor∪admin; people is
// admin-only, settings/navigation are super-admin-only; giving is admin ∪
// finance-flagged. Team leaders (no editor/admin) therefore see the dashboard
// only — their console lands in slice 6. Beyond these role-based `show` flags,
// a per-admin area grant (below) further narrows which rows an ADMIN sees —
// editors/leaders/finance are untouched by that layer.
// Links to pages built later this slice (tasks 2–4) are intentionally live.
const isStaff = !!(user?.isEditor || user?.isAdmin);
const isAdmin = !!user?.isAdmin;
// Giving admin (finance route class): a finance-flagged member reaches it without
// full site-admin, so its nav link shows for admins AND finance-flagged members.
const isFinance = isAdmin || user?.finance === 1;
// /admin (the dashboard) is the 'console' route class — admin ∪ editor ∪ team
// leader (mirrors routePolicy.canAccess). A finance-only member renders this
// shell on /admin/giving but would 403 on /admin itself, so the Dashboard link
// must not show for them.
const isConsole = isStaff || (user?.leaderTeamIds.length ?? 0) > 0;

// A nav entry with a `module` hides when that module is off (settings itself has
// none — it is core). Groups drop out once every child is hidden.
const modules = Astro.locals.modules;
const modOn = (m?: ModuleKey) => !m || modules.has(m);
const hasPaymentOperations = paymentOperationsEnabled(modules);
// Per-admin area filter: only narrows admins — editors/leaders/finance keep
// their role-based rows (their `show` booleans), so non-admins pass areaOn.
const areaOn = (a?: AdminAreaKey) => !a || !user?.isAdmin || hasAreaAccess(user, a);
const isSuper = !!user?.isSuperAdmin;
const isNewcomerStaff = hasAreaAccess(user, 'newcomers');
let campusChoices: CampusRow[] = [];
if (user) {
  try {
    campusChoices = (await listCampusesForUser(Astro.locals.rawDb, user.id, isSuper))
      .filter(({ active }) => active === 1);
  } catch {
    /* A migration-in-progress keeps the shell usable without a selector. */
  }
}
const switchUrl = new URL(Astro.url);
switchUrl.searchParams.delete('campus');
const campusSwitchNext = switchUrl.pathname + switchUrl.search;

type NavItem = { label: string; href: string; module?: ModuleKey; area?: AdminAreaKey };
type NavSection = {
  label: string;
  href?: string;
  show: boolean;
  module?: ModuleKey;
  area?: AdminAreaKey;
  children?: NavItem[];
};

const rawSections: NavSection[] = [
  { label: t(lang, 'admin.nav.dashboard'), href: '/admin', show: isConsole },
  {
    label: t(lang, 'admin.nav.content'),
    show: isStaff,
    children: [
      { label: t(lang, 'admin.nav.bulletins'), href: '/admin/bulletins', module: 'bulletins', area: 'bulletins' },
      { label: t(lang, 'admin.nav.sermons'), href: '/admin/sermons', module: 'sermons', area: 'sermons' },
      {
        label: t(lang, 'admin.nav.prayerSheets'),
        href: '/admin/prayer-sheets',
        module: 'prayer-sheets',
        area: 'prayer-sheets',
      },
      { label: t(lang, 'admin.nav.testimonies'), href: '/admin/testimonies', module: 'testimonies', area: 'testimonies' },
      { label: t(lang, 'admin.nav.pages'), href: '/admin/pages', area: 'pages' },
    ],
  },
  {
    label: t(lang, 'admin.nav.news'),
    show: isStaff,
    module: 'events',
    area: 'events',
    children: [
      { label: t(lang, 'admin.nav.announcements'), href: '/admin/announcements' },
      { label: t(lang, 'admin.nav.events'), href: '/admin/events' },
    ],
  },
  {
    label: t(lang, 'admin.nav.prayerWall'),
    href: '/admin/prayer-wall',
    show: isStaff,
    module: 'prayer-wall',
    area: 'prayer-wall',
  },
  { label: t(lang, 'admin.nav.people'), href: '/admin/people', show: isAdmin, module: 'people', area: 'people-basic' },
  { label: t(lang, 'admin.nav.groups'), href: '/admin/groups', show: isAdmin, module: 'groups', area: 'groups' },
  { label: t(lang, 'admin.nav.children'), href: '/admin/children', show: isAdmin, module: 'children', area: 'children' },
  { label: t(lang, 'admin.nav.attendance'), href: '/admin/attendance', show: isAdmin, module: 'attendance', area: 'attendance' },
  { label: t(lang, 'admin.nav.activityScore'), href: '/admin/activity-score', show: isAdmin, module: 'activity-score', area: 'activity-score' },
  { label: t(lang, 'admin.nav.learning'), href: '/admin/learning', show: isAdmin, module: 'learning', area: 'learning' },
  { label: t(lang, 'admin.nav.newcomers'), href: '/admin/newcomers', show: isNewcomerStaff, module: 'newcomers', area: 'newcomers' },
  { label: t(lang, 'admin.nav.onboarding'), href: '/admin/onboarding', show: isAdmin, area: 'onboarding' },
  { label: t(lang, 'admin.giving.title'), href: '/admin/giving', show: isFinance, module: 'giving', area: 'giving' },
  {
    label: t(lang, 'admin.stripe.title'),
    href: '/admin/stripe-events',
    show: isFinance && hasPaymentOperations,
    area: 'payment-operations',
  },
  {
    label: t(lang, 'admin.reg.title'),
    href: '/admin/registration',
    show: isStaff,
    module: 'registration',
    area: 'registration',
  },
  { label: t(lang, 'admin.console.title'), href: '/admin/ministries', show: isAdmin || (user?.leaderTeamIds.length ?? 0) > 0, module: 'serve', area: 'serve' },
  { label: t(lang, 'admin.teams.title'), href: '/admin/teams', show: isAdmin, module: 'serve', area: 'serve' },
  { label: t(lang, 'admin.serviceTypes.title'), href: '/admin/service-types', show: isAdmin, module: 'serve', area: 'serve' },
  { label: t(lang, 'admin.nav.settings'), href: '/admin/settings', show: isSuper },
  { label: t(lang, 'admin.nav.navigation'), href: '/admin/navigation', show: isSuper },
  { label: t(lang, 'admin.nav.campuses'), href: '/admin/campuses', show: isSuper },
];

const sections: NavSection[] = rawSections
  .filter((s) => s.show && modOn(s.module) && areaOn(s.area))
  .map((s) => (s.children ? { ...s, children: s.children.filter((c) => modOn(c.module) && areaOn(c.area)) } : s))
  .filter((s) => !s.children || s.children.length > 0);

const current = Astro.url.pathname.replace(/\/+$/, '') || '/admin';
const navigationGroups = groupAdminLinks(sections.flatMap(section => section.children ?? [{ href: section.href!, label: section.label }]), lang);
---

<!doctype html>
<html
  lang={lang === 'zh' ? 'zh-Hans' : 'en'}
  data-theme={theme}
  data-mode={defaultMode}
  data-mode-default={defaultMode}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="robots" content="noindex" />
    <script is:inline>
      // No-flash mode: honor a saved choice, else fall back to the settings-driven
      // default carried in data-mode-default (rendered from theme.default_mode).
      (function () {
        var el = document.documentElement;
        var saved = null;
        try {
          saved = localStorage.getItem('c4c-mode');
        } catch (e) {
          /* private mode / storage disabled — use the theme default */
        }
        el.dataset.mode = saved === 'light' || saved === 'dark' ? saved : el.dataset.modeDefault || 'light';
      })();
    </script>
  </head>
  <body class="workspace-shell min-h-screen bg-surface text-ink">
    <a href="#workspace-main" class="skip-link">{t(lang, 'design.nav.skip')}</a>
    <aside class="workspace-sidebar">
      <a href="/admin" class="workspace-brand">
        {logoSrc ? <img src={logoSrc} alt="" class="h-8 w-auto" /> : <Icon name="leaf" size={28} />}
        <span>Church4Christ<small>{t(lang, 'design.nav.context')}</small></span>
      </a>
      <div class="workspace-desktop-nav"><WorkspaceNavigation groups={navigationGroups} current={current} label={t(lang, 'admin.nav.label')} /></div>
      <details class="workspace-mobile-nav">
        <summary>{t(lang, 'admin.nav.label')} <span aria-hidden="true">☰</span></summary>
        <WorkspaceNavigation groups={navigationGroups} current={current} label={t(lang, 'admin.nav.label')} />
        <div class="workspace-mobile-account">
          <a href={localePath(lang, '/')}>{t(lang, 'admin.nav.viewSite')}</a>
          {user && <form method="post" action="/signout"><button type="submit">{t(lang, 'common.signOut')}</button></form>}
        </div>
      </details>
      <div class="workspace-sidebar-footer">
        <a href={localePath(lang, '/')}><Icon name="arrow" size={17} /> {t(lang, 'admin.nav.viewSite')}</a>
        {user && <form method="post" action="/signout"><button type="submit">{t(lang, 'common.signOut')}</button></form>}
      </div>
    </aside>
    <div class="workspace-body">
      <header class="workspace-topbar">
        {(campusChoices.length > 1 || isSuper) ? (
          <form method="post" action="/campus/switch" class="workspace-campus">
            <input type="hidden" name="next" value={campusSwitchNext} />
            <label class="sr-only" for="workspace-campus">{t(lang, 'admin.campuses.campus')}</label>
            <select id="workspace-campus" name="campus">
              {isSuper && <option value="all" selected={user?.campusMode === 'all'}>{t(lang, 'admin.campuses.all')}</option>}
              {campusChoices.map(campus => <option value={campus.slug} selected={user?.campus?.id === campus.id}>{campus.name}</option>)}
            </select>
            <button type="submit">{t(lang, 'admin.campuses.switch')}</button>
          </form>
        ) : <span class="workspace-context">{t(lang, 'design.nav.context')}</span>}
        <span class="workspace-page-title">{title}</span>
        {user && <a class="workspace-profile" aria-label={t(lang, 'profile.title')} href={localePath(lang, '/profile')}><span class="workspace-avatar" aria-hidden="true">{(user.email ?? '?').slice(0, 1).toUpperCase()}</span><span class="workspace-email">{user.email}</span></a>}
      </header>
      <main id="workspace-main" class="workspace-main" tabindex="-1">
        <slot />
      </main>
    </div>
    <script>
      // Repeat-rows editor island (ported from the reference stack): progressive
      // enhancement over a <template data-repeat-template> plus [data-repeat-row]
      // rows with add / remove / move-up / move-down controls. Add clones the
      // template before it; remove/move act on the closest row. Pure enhancement —
      // with JS off the form still posts every row and the server skips blanks.
      document.querySelectorAll<HTMLElement>('[data-repeat]').forEach((box) => {
        const tpl = box.querySelector<HTMLTemplateElement>('template[data-repeat-template]');
        box.querySelector('[data-repeat-add]')?.addEventListener('click', () => {
          if (tpl) box.insertBefore(tpl.content.cloneNode(true), tpl);
        });
        box.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          const rm = target.closest('[data-repeat-remove]');
          if (rm && box.contains(rm)) {
            rm.closest('[data-repeat-row]')?.remove();
            return;
          }
          const mv = target.closest<HTMLElement>('[data-repeat-up], [data-repeat-down]');
          if (!mv || !box.contains(mv)) return;
          const row = mv.closest('[data-repeat-row]');
          if (!row || !row.parentElement) return;
          if (mv.matches('[data-repeat-up]') && row.previousElementSibling?.matches('[data-repeat-row]')) {
            row.parentElement.insertBefore(row, row.previousElementSibling);
          } else if (mv.matches('[data-repeat-down]') && row.nextElementSibling?.matches('[data-repeat-row]')) {
            row.parentElement.insertBefore(row.nextElementSibling, row);
          }
        });
      });
    </script>
  </body>
</html>
