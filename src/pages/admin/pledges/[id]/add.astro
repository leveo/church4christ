---
// Staff entry of a paper pledge card (or a pledge taken in person). Uses the
// same plan rules as the public form. No confirmation email is sent from here;
// staff send one from the record when the card has an email address.
import Admin from '../../../../layouts/Admin.astro';
import PledgeStaffFields from '../../../../components/pledges/PledgeStaffFields.astro';
import { t } from '../../../../lib/i18n';
import { hasAreaAccess } from '../../../../lib/adminAreas';
import { btn, btnSecondary, card, errorText, lab, tin } from '../../../../lib/adminUi';
import { createPaperPledge, getCampaign } from '../../../../lib/pledgeDb';
import { parsePledgeForm, type FieldErrors } from '../../../../lib/pledgeForms';
import { SUPPORTED_LOCALES, isSupportedLocale, localeMeta, type Locale } from '../../../../lib/locales';

export const prerender = false;

const user = Astro.locals.user;
if (!user || !hasAreaAccess(user, 'pledges')) return new Response(null, { status: 403 });
const lang: Locale = user.lang ?? 'en';
const db = Astro.locals.db;
const id = /^\d+$/.test(Astro.params.id ?? '') ? Number(Astro.params.id) : 0;
const campaign = id ? await getCampaign(db, id, lang) : null;
if (!campaign) return new Response(null, { status: 404 });

let errors: FieldErrors = {};
let values: Record<string, string> = {};
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  values = Object.fromEntries([...fd.entries()].map(([k, v]) => [k, String(v)]));
  const pledgeLocale = isSupportedLocale(values.locale) ? values.locale : Astro.locals.locales.default;
  const parsed = parsePledgeForm(fd, campaign, { staff: true, locale: pledgeLocale });
  if (!parsed.ok) {
    errors = parsed.errors;
  } else {
    const r = await createPaperPledge(db, campaign.id, parsed.value.write, user.email, parsed.value.originalCode);
    if (r.ok) return Astro.redirect(`/admin/pledges/record/${r.id}?created=1`, 303);
    errors = { original_code: 'pledges.err.originalNotFound' };
  }
}
const languages = SUPPORTED_LOCALES.filter((code) => Astro.locals.locales.enabled.includes(code));
---

<Admin title={t(lang, 'pledges.admin.addPaper')}>
  <p class="text-sm"><a class="text-primary hover:underline" href={`/admin/pledges/${campaign.id}`}>← {campaign.title}</a></p>
  <h1 class="mt-2 font-display text-display-lg font-bold">{t(lang, 'pledges.admin.addPaper')}</h1>
  <p class="mt-1 max-w-2xl text-sm text-ink-muted">{t(lang, 'pledges.admin.addPaperIntro')}</p>
  {Object.keys(errors).length > 0 && <p class={`mt-4 ${errorText}`}>{t(lang, 'admin.form.fixErrors')}</p>}
  <form method="post" class={`${card} mt-6 max-w-3xl space-y-5`}>
    <PledgeStaffFields lang={lang} values={values} errors={errors} maxMonths={campaign.max_months} givingStart={campaign.giving_start} givingEnd={campaign.giving_end} allowAdditional />
    <label class="block max-w-xs">
      <span class={lab}>{t(lang, 'pledges.admin.field.language')}</span>
      <select name="locale" class={tin}>{languages.map((code) => <option value={code} selected={(values.locale ?? Astro.locals.locales.default) === code}>{localeMeta(code).nativeName}</option>)}</select>
    </label>
    <div class="flex flex-wrap gap-3">
      <button type="submit" class={btn}>{t(lang, 'pledges.admin.savePledge')}</button>
      <a href={`/admin/pledges/${campaign.id}`} class={btnSecondary}>{t(lang, 'pledges.admin.cancel')}</a>
    </div>
  </form>
</Admin>
