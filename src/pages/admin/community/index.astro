---
import Admin from '../../../layouts/Admin.astro';
import { hasAreaAccess } from '../../../lib/adminAreas';
import { listCampusesForUser } from '../../../lib/campusDb';
import { createFellowship,updateFellowship,setFellowshipActive,listFellowships,listCommunityGroups,listCommunityMembers,assignFellowshipGroup,saveFellowshipMember } from '../../../lib/fellowshipDb';
import { positiveId } from '../../../lib/communityValidation';
import { listWorkflowTasks } from '../../../lib/workflowDb';
import { btn,card,lab,tin,noticeErr,noticeOk } from '../../../lib/adminUi';
const user=Astro.locals.user;
if(!user || !hasAreaAccess(user,'groups')) return new Response(null,{status:403});
const db=Astro.locals.db;
const campus=Astro.locals.campus;
const rawFellowship=Astro.url.searchParams.get('fellowship');
let fellowshipId:number|null=null;
try { if(rawFellowship) fellowshipId=positiveId(rawFellowship); } catch { return new Response('Community not found.',{status:404}); }
let error='';
if(Astro.request.method==='POST') {
  if(!campus) return new Response('Select a campus before making changes.',{status:400});
  try {
    const form=await Astro.request.formData(); const action=form.get('action');
    if(action==='save') {
      const input={name:String(form.get('name')??''),slug:String(form.get('slug')??''),description:String(form.get('description')??''),meetingDetails:String(form.get('meeting_details')??''),coordinatorId:form.get('coordinator_id')?positiveId(form.get('coordinator_id')):null};
      if(fellowshipId) await updateFellowship(db,fellowshipId,input); else fellowshipId=await createFellowship(db,input);
    } else if(action==='active' && fellowshipId) await setFellowshipActive(db,fellowshipId,form.get('active')==='1');
    else if(action==='group') await assignFellowshipGroup(db,form.get('fellowship_id')?positiveId(form.get('fellowship_id')):null,positiveId(form.get('group_id')));
    else if(action==='member' && fellowshipId) {
      const role=String(form.get('role'));
      if(role!=='member'&&role!=='coordinator') throw new Error('Choose a valid role.');
      await saveFellowshipMember(db,fellowshipId,positiveId(form.get('person_id')),role,form.get('active')==='1');
    } else throw new Error('Choose a valid action.');
    return Astro.redirect(`/admin/community?${fellowshipId?`fellowship=${fellowshipId}&`:''}saved=1`,303);
  } catch(e) { error=e instanceof Error && !/SQL|constraint|D1_|postgres/i.test(e.message)?e.message:'The change could not be saved. Check the selected records and use a unique slug.'; }
}
const fellowships=campus?await listFellowships(db):[];
const selected=fellowships.find(f=>f.id===fellowshipId);
if(fellowshipId&&!selected) return new Response('Community not found.',{status:404});
const allGroups=campus?await listCommunityGroups(db):[];
const groups=allGroups.filter(g=>g.fellowship_id===fellowshipId);
const people=campus?await listCommunityMembers(db,null):[];
const members=campus?await listCommunityMembers(db,fellowshipId):[];
const tasks=campus?await listWorkflowTasks(db,{fellowshipId}):[];
const campuses=await listCampusesForUser(Astro.locals.rawDb,user.id,!!user.isSuperAdmin);
const heading=selected?.name??campus?.name??'Campuses & Fellowships';
const context=fellowshipId?`?fellowship=${fellowshipId}`:'';
---
<Admin title={heading}>
  <div class="space-y-6">
    <header><p class="text-sm font-semibold text-primary">Community management</p><h1 class="font-display text-heading-md font-bold">{heading}</h1><p class="mt-2 text-ink-muted">Manage members, groups, and follow-up in one place. A campus can work directly with groups; fellowships are optional.</p></header>
    {error&&<p role="alert" class={noticeErr}>{error}</p>}
    {Astro.url.searchParams.has('saved')&&<p role="status" class={noticeOk}>Changes saved.</p>}
    {!campus ? <section class={card}><h2 class="text-xl font-semibold">Choose a campus</h2><div class="mt-4 flex flex-wrap gap-3">{campuses.filter(c=>c.active===1).map(c=><a class={btn} href={`/admin/community?campus=${c.slug}`}>{c.name}</a>)}</div></section> : <>
      <nav class="flex flex-wrap gap-3" aria-label="Community"><a class={btn} href="/admin/community">Campus overview</a>{fellowships.filter(f=>f.active===1||f.id===fellowshipId).map(f=><a class="rounded-lg border border-border px-4 py-2" aria-current={f.id===fellowshipId?'page':undefined} href={`/admin/community?fellowship=${f.id}`}>{f.name}{f.active===0?' (Archived)':''}</a>)}<a class="rounded-lg border border-border px-4 py-2" href={`/admin/workflows${context}`}>Workflows</a></nav>
      <div class="grid gap-4 sm:grid-cols-3">{[{label:'Members',value:members.filter(m=>m.active===1).length},{label:selected?'Groups':'Direct campus groups',value:groups.length},{label:'Open follow-up tasks',value:tasks.filter(t=>['pending','in_progress'].includes(t.status)&&t.run_status==='active').length}].map(s=><div class={card}><p class="text-sm text-ink-muted">{s.label}</p><p class="mt-2 font-display text-3xl font-bold">{s.value}</p></div>)}</div>
      {selected&&<p class={card}>{selected.description}<br/><span class="text-sm text-ink-muted">{selected.meeting_details}</span></p>}
      <section class={card}><div class="flex flex-wrap justify-between gap-3"><h2 class="text-xl font-semibold">{selected?'Fellowship groups':'Groups managed directly by this campus'}</h2><a class="text-primary underline" href="/admin/groups">Create or manage groups</a></div>
        {!groups.length&&<p class="mt-4 text-ink-muted">No groups here yet. Assign an existing group below, or create a new group.</p>}
        <ul class="mt-4 divide-y divide-border">{groups.map(g=><li class="flex justify-between py-3"><a class="font-semibold text-primary" href={`/admin/groups/${g.id}`}>{g.name}</a><span>{g.member_count} members</span></li>)}</ul>
        <form method="post" class="mt-5 flex flex-wrap items-end gap-3"><input type="hidden" name="action" value="group"/><label><span class={lab}>Group</span><select class={tin} name="group_id" required>{allGroups.map(g=><option value={g.id}>{g.name} — {g.fellowship_name??'Campus'}</option>)}</select></label><label><span class={lab}>Managed by</span><select class={tin} name="fellowship_id"><option value="">Campus directly</option>{fellowships.filter(f=>f.active===1).map(f=><option value={f.id} selected={f.id===fellowshipId}>{f.name}</option>)}</select></label><button class={btn}>Assign group</button></form>
        <p class="mt-2 text-sm text-ink-muted">Moving a group preserves its members, events, and attendance. It does not enroll its members in a fellowship.</p>
      </section>
      <section class={card}><h2 class="text-xl font-semibold">Members</h2><p class="mt-2 text-sm text-ink-muted">{selected?'Fellowship membership is independent of group membership. Coordinator labels do not grant administrator access.':'Campus members can participate in groups and workflows without joining a fellowship.'}</p>
        <ul class="mt-4 divide-y divide-border">{members.map(m=><li class="flex flex-wrap items-center justify-between gap-3 py-3"><span>{m.display_name} <span class="text-sm text-ink-muted">· {m.role}{m.active!==1?' · Inactive':''}</span></span>{selected&&<form method="post"><input type="hidden" name="action" value="member"/><input type="hidden" name="person_id" value={m.id}/><input type="hidden" name="role" value={m.role}/><input type="hidden" name="active" value={m.active===1?'0':'1'}/><button class="text-sm text-primary underline">{m.active===1?'Remove':'Restore'}</button></form>}</li>)}</ul>
        {selected?<form method="post" class="mt-5 flex flex-wrap items-end gap-3"><input type="hidden" name="action" value="member"/><input type="hidden" name="active" value="1"/><label><span class={lab}>Campus member</span><select class={tin} name="person_id" required>{people.filter(p=>p.active===1).map(p=><option value={p.id}>{p.display_name}</option>)}</select></label><label><span class={lab}>Role</span><select class={tin} name="role"><option value="member">Member</option><option value="coordinator">Coordinator</option></select></label><button class={btn}>Save membership</button></form>:<p class="mt-4"><a class="text-primary underline" href="/admin/people">Open people directory</a>{user.isSuperAdmin&&<> · <a class="text-primary underline" href={`/admin/campuses?manageCampus=${campus.id}`}>Manage campus access</a></>}</p>}
      </section>
      <details class={card}><summary class="cursor-pointer text-lg font-semibold">{selected?'Edit fellowship':'Add an optional fellowship'}</summary><form method="post" class="mt-4 grid gap-4 sm:grid-cols-2"><input type="hidden" name="action" value="save"/>
        <label><span class={lab}>Name</span><input class={tin} name="name" required maxlength="120" value={selected?.name}/></label><label><span class={lab}>Slug</span><input class={tin} name="slug" required maxlength="64" pattern="[a-z0-9]+(-[a-z0-9]+)*" value={selected?.slug}/></label>
        <label class="sm:col-span-2"><span class={lab}>Description</span><textarea class={tin} name="description" maxlength="5000">{selected?.description}</textarea></label><label><span class={lab}>Meeting details</span><input class={tin} name="meeting_details" maxlength="500" value={selected?.meeting_details}/></label><label><span class={lab}>Default coordinator</span><select class={tin} name="coordinator_id"><option value="">Choose later</option>{people.filter(p=>p.active===1).map(p=><option value={p.id} selected={p.id===selected?.coordinator_id}>{p.display_name}</option>)}</select></label><div><button class={btn}>Save fellowship</button></div></form>
        {selected&&<form method="post" class="mt-5"><input type="hidden" name="action" value="active"/><input type="hidden" name="active" value={selected.active===1?'0':'1'}/><p class="mb-2 text-sm text-ink-muted">Archiving pauses fellowship reminders and keeps its history and groups.</p><button class="text-primary underline">{selected.active===1?'Archive fellowship':'Restore fellowship'}</button></form>}
      </details>
      {!selected&&fellowships.some(f=>f.active===0)&&<section class={card}><h2 class="font-semibold">Archived fellowships</h2>{fellowships.filter(f=>f.active===0).map(f=><p class="mt-2"><a class="text-primary underline" href={`/admin/community?fellowship=${f.id}`}>{f.name}</a></p>)}</section>}
    </>}
  </div>
</Admin>
