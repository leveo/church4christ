---
import Admin from '../../../layouts/Admin.astro';
import CareWorkspace from '../../../components/admin/care/CareWorkspace.astro';
import { careToolsCopy } from '../../../i18n/designCareTools';
import { listServiceTypes } from '../../../lib/teamDb';
import { hasAreaAccess } from '../../../lib/adminAreas';
import { btn, btnSecondary, lab, noticeErr, tin } from '../../../lib/adminUi';
import { createNewcomerSubmission, listNewcomerFormDefinition } from '../../../lib/newcomerDb';
import { readNewcomerUrlencodedForm } from '../../../lib/newcomerHttp';
import { validateNewcomerIntake } from '../../../lib/newcomerValidation';
import { todayInTz } from '../../../lib/dates';
import { t } from '../../../lib/i18n';
import type { Locale } from '../../../lib/locales';

const modules = Astro.locals.modules;
if (!modules.has('newcomers')) return new Response(null, { status: 404 });
const user = Astro.locals.user;
if (!hasAreaAccess(user, 'newcomers')) return new Response(null, { status: 403 });
const lang: Locale = user?.lang === 'zh' ? 'zh' : 'en';
const definition = await listNewcomerFormDefinition(Astro.locals.db, Astro.locals.dbBackend, lang);
const fieldName = (id: number) => `answer_${id}`;
const allowed = ['name', 'email', 'phone', 'locale', 'visit_date', 'service_type_id', 'contact_consent', ...definition.fields.map((field) => fieldName(field.id))];
let error = false;
if (Astro.request.method === 'POST') {
  const read = await readNewcomerUrlencodedForm(Astro.request, allowed);
  if (read.ok) {
    const form = read.fields;
    const answers: Array<{ fieldId: number; value: string | boolean }> = [];
    for (const field of definition.fields) {
      const value = form[fieldName(field.id)];
      if (field.type === 'checkbox') answers.push({ fieldId: field.id, value: value === 'true' });
      else if (value !== undefined && value !== '') answers.push({ fieldId: field.id, value });
    }
    const parsed = validateNewcomerIntake('staff', {
      name: form.name ?? '', email: form.email ?? '', phone: form.phone ?? '',
      locale: form.locale ?? lang, visitDate: form.visit_date ?? '',
      serviceTypeId: /^\d+$/.test(form.service_type_id ?? '') ? Number(form.service_type_id) : null,
      contactConsent: form.contact_consent === 'true', answers,
    }, { activeServiceTypeIds: definition.activeServiceTypeIds, fields: definition.fields.map((field) => ({
      id: field.id, key: field.key, type: field.type, required: field.required,
      options: field.options.map((option) => option.value),
    })) });
    if (parsed.ok) {
      try {
        const operationId = crypto.randomUUID();
        const created = await createNewcomerSubmission(Astro.locals.db, user, 'staff', parsed.value, { backend: Astro.locals.dbBackend, operationId });
        return Astro.redirect(`/admin/newcomers/${created.id}`, 303);
      } catch { error = true; }
    } else error = true;
  } else error = true;
}
const today = todayInTz();
const copy = careToolsCopy(lang);
const services = new Map((await listServiceTypes(Astro.locals.db, lang)).map((service) => [service.id, service.name]));
---
<Admin title={t(lang, 'admin.newcomers.newTitle')}>
  <CareWorkspace variant="newcomer-intake">
    <div class="care-heading"><div><p class="care-eyebrow">{copy.intake}</p><h1>{t(lang, 'admin.newcomers.newTitle')}</h1><p class="care-intro">{copy.intakeIntro}</p></div><a class={btnSecondary} href="/admin/newcomers">&larr; {t(lang, 'admin.newcomers.queue')}</a></div>
    {error && <p class={`mb-4 ${noticeErr}`} role="alert">{t(lang, 'admin.newcomers.error')}</p>}
    <div class="care-tools-layout">
      <form method="post" class="care-intake-form">
        <fieldset class="care-panel"><legend>{copy.contact}</legend><div class="care-form-grid">
          <label class="care-field-wide"><span class={lab}>{t(lang, 'newcomers.name')}</span><input class={tin} name="name" autocomplete="name" required /></label>
          <label><span class={lab}>{t(lang, 'newcomers.email')}</span><input class={tin} type="email" name="email" autocomplete="email" /></label>
          <label><span class={lab}>{t(lang, 'newcomers.phone')}</span><input class={tin} type="tel" name="phone" autocomplete="tel" /></label>
          <label class="care-field-wide"><span class={lab}>{t(lang, 'newcomers.language')}</span><select class={tin} name="locale"><option value="en" selected={lang === 'en'}>{t(lang, 'locale.en')}</option><option value="zh" selected={lang === 'zh'}>{t(lang, 'locale.zh')}</option></select></label>
        </div></fieldset>
        <fieldset class="care-panel"><legend>{copy.visit}</legend><div class="care-form-grid">
          <label><span class={lab}>{t(lang, 'newcomers.visitDate')}</span><input class={tin} type="date" name="visit_date" value={today} required /></label>
          <label><span class={lab}>{t(lang, 'newcomers.service')}</span><select class={tin} name="service_type_id"><option value="">{t(lang, 'newcomers.none')}</option>{definition.activeServiceTypeIds.map((id) => <option value={id}>{services.get(id) || `${copy.service} ${id}`}</option>)}</select></label>
        </div></fieldset>
        {definition.fields.length > 0 && <fieldset class="care-panel"><legend>{copy.answers}</legend><div class="space-y-4">
          {definition.fields.map((field) => <div>
            {field.type === 'textarea' ? <label class="block"><span class={lab}>{field.label}</span><textarea class={tin} name={fieldName(field.id)} required={field.required} aria-describedby={field.help ? `help-${field.id}` : undefined}></textarea></label>
            : field.type === 'select' ? <label class="block"><span class={lab}>{field.label}</span><select class={tin} name={fieldName(field.id)} required={field.required} aria-describedby={field.help ? `help-${field.id}` : undefined}><option value="">{t(lang, 'newcomers.none')}</option>{field.options.map((option) => <option value={option.value}>{option.label}</option>)}</select></label>
            : field.type === 'checkbox' ? <label class="flex items-start gap-3"><input type="checkbox" name={fieldName(field.id)} value="true" required={field.required} aria-describedby={field.help ? `help-${field.id}` : undefined} /><span>{field.label}</span></label>
            : <label class="block"><span class={lab}>{field.label}</span><input class={tin} name={fieldName(field.id)} required={field.required} aria-describedby={field.help ? `help-${field.id}` : undefined} /></label>}
            {field.help && <p id={`help-${field.id}`} class="mt-2 text-xs text-ink-muted">{field.help}</p>}
          </div>)}
        </div></fieldset>}
        <fieldset class="care-panel care-consent"><legend>{copy.consent}</legend><label class="flex items-start gap-3"><input type="checkbox" name="contact_consent" value="true" /><span>{t(lang, 'newcomers.staffConsent')}</span></label></fieldset>
        <div class="care-form-actions"><button class={btn} type="submit">{t(lang, 'admin.newcomers.save')}</button></div>
      </form>
      <aside class="care-panel care-tools-aside"><h2>{copy.next}</h2><p>{copy.nextBody}</p><p>{copy.nextHint}</p></aside>
    </div>
  </CareWorkspace>
</Admin>
