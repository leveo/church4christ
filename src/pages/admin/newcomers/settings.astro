---
import Admin from '../../../layouts/Admin.astro';
import CareWorkspace from '../../../components/admin/care/CareWorkspace.astro';
import { careToolsCopy } from '../../../i18n/designCareTools';
import { btn, btnSecondary, lab, noticeErr, noticeOk, tin } from '../../../lib/adminUi';
import {
  createNewcomerField, createNewcomerStatus, listNewcomerAdminConfiguration,
  updateNewcomerField, updateNewcomerStatus, type NewcomerFieldOptionInput,
} from '../../../lib/newcomerDb';
import { readNewcomerUrlencodedForm } from '../../../lib/newcomerHttp';
import { t } from '../../../lib/i18n';
import type { Locale } from '../../../lib/locales';
import type { NewcomerFieldType } from '../../../lib/newcomerValidation';

const modules = Astro.locals.modules;
if (!modules.has('newcomers')) return new Response(null, { status: 404 });
const user = Astro.locals.user;
if (!user?.isSuperAdmin) return new Response(null, { status: 403 });
const lang: Locale = user.lang === 'zh' ? 'zh' : 'en';
const allowed = ['action', 'id', 'key', 'category', 'type', 'sort', 'active', 'required', 'initial_status_id', 'label_en', 'label_zh', 'help_en', 'help_zh', 'options_json'];
let saved = Astro.url.searchParams.get('saved') === '1';
let error = false;

function integer(value: string | undefined): number {
  if (!/^\d+$/.test(value ?? '')) throw new Error('invalid integer');
  return Number(value);
}
function options(value: string | undefined): NewcomerFieldOptionInput[] {
  const parsed: unknown = JSON.parse(value || '[]');
  if (!Array.isArray(parsed) || parsed.length > 100) throw new Error('invalid options');
  return parsed.map((candidate) => {
    if (!candidate || typeof candidate !== 'object' || Array.isArray(candidate)) throw new Error('invalid option');
    const row = candidate as Record<string, unknown>;
    if (typeof row.value !== 'string' || typeof row.sort !== 'number' || typeof row.active !== 'boolean'
      || typeof row.labelEn !== 'string' || typeof row.labelZh !== 'string') throw new Error('invalid option');
    return { value: row.value, sort: row.sort, active: row.active, labelEn: row.labelEn, labelZh: row.labelZh };
  });
}
if (Astro.request.method === 'POST') {
  const read = await readNewcomerUrlencodedForm(Astro.request, allowed);
  if (read.ok) {
    const form = read.fields;
    try {
      if (form.action === 'create-status') await createNewcomerStatus(Astro.locals.db, user, { key: form.key ?? '', category: form.category as 'open' | 'closed', sort: integer(form.sort), active: form.active === 'true', labelEn: form.label_en ?? '', labelZh: form.label_zh ?? '' });
      else if (form.action === 'update-status') await updateNewcomerStatus(Astro.locals.db, user, { id: integer(form.id), sort: integer(form.sort), active: form.active === 'true', initialStatusId: integer(form.initial_status_id), labelEn: form.label_en ?? '', labelZh: form.label_zh ?? '' });
      else if (form.action === 'create-field') await createNewcomerField(Astro.locals.db, user, { key: form.key ?? '', type: form.type as NewcomerFieldType, required: form.required === 'true', active: form.active === 'true', sort: integer(form.sort), labelEn: form.label_en ?? '', labelZh: form.label_zh ?? '', helpEn: form.help_en || null, helpZh: form.help_zh || null, options: options(form.options_json) });
      else if (form.action === 'update-field') await updateNewcomerField(Astro.locals.db, user, { id: integer(form.id), required: form.required === 'true', active: form.active === 'true', sort: integer(form.sort), labelEn: form.label_en ?? '', labelZh: form.label_zh ?? '', helpEn: form.help_en || null, helpZh: form.help_zh || null, options: options(form.options_json) });
      else throw new Error('invalid action');
      return Astro.redirect('/admin/newcomers/settings?saved=1', 303);
    } catch { error = true; }
  } else error = true;
}
const [english, chinese] = await Promise.all([
  listNewcomerAdminConfiguration(Astro.locals.db, Astro.locals.dbBackend, user, 'en'),
  listNewcomerAdminConfiguration(Astro.locals.db, Astro.locals.dbBackend, user, 'zh'),
]);
const zhStatus = new Map(chinese.statuses.map((row) => [row.id, row]));
const zhField = new Map(chinese.fields.map((row) => [row.id, row]));
const optionJson = (field: (typeof english.fields)[number]) => JSON.stringify(field.options.map((option) => ({ value: option.value, sort: option.sort, active: option.active, labelEn: option.label, labelZh: zhField.get(field.id)?.options.find((item) => item.value === option.value)?.label ?? option.label })), null, 2);
const initialStatusId = english.statuses.find((status) => status.initial)?.id ?? 1;
const copy = careToolsCopy(lang);
---
<Admin title={t(lang, 'admin.newcomers.settings')}>
  <CareWorkspace variant="newcomer-settings">
    <div class="care-heading"><div><p class="care-eyebrow">{copy.settings}</p><h1>{t(lang, 'admin.newcomers.settings')}</h1><p class="care-intro">{copy.settingsIntro}</p></div><a class={btnSecondary} href="/admin/newcomers">&larr; {t(lang, 'admin.newcomers.queue')}</a></div>
    {saved && <p class={`mb-4 ${noticeOk}`} role="status">{t(lang, 'admin.newcomers.saved')}</p>}{error && <p class={`mb-4 ${noticeErr}`} role="alert">{t(lang, 'admin.newcomers.error')}</p>}
    <nav class="care-record-nav" aria-label={copy.settingsNav}><a href="#welcome-stages">{copy.stages} <span>{english.statuses.length}</span></a><a href="#welcome-fields">{copy.fields} <span>{english.fields.length}</span></a></nav>
    <section id="welcome-stages" class="care-config-section">
      <div class="care-panel-heading"><div><h2>{copy.stages}</h2><p class="care-intro">{copy.stagesIntro}</p></div><a class={btnSecondary} href="#create-welcome-stage">+ {copy.addStage}</a></div>
      <div class="care-config-list">
        {english.statuses.map((status) => <details class="care-config-item" open={error}>
          <summary><span class="care-config-name">{lang === 'zh' ? zhStatus.get(status.id)?.label || status.label : status.label}<small>{status.category === 'open' ? copy.open : copy.closed}{status.initial ? ` · ${t(lang, 'admin.newcomers.initial')}` : ''}</small></span><span class="care-state" data-active={status.active}>{status.active ? copy.active : copy.inactive}</span></summary>
          <form method="post" class="care-config-form"><input type="hidden" name="action" value="update-status" /><input type="hidden" name="id" value={status.id} />
            <fieldset><legend>{copy.labels}</legend><div class="care-form-grid"><label><span class={lab}>{t(lang, 'locale.en')}</span><input class={tin} name="label_en" value={status.label} lang="en" required /></label><label><span class={lab}>{t(lang, 'locale.zh')}</span><input class={tin} name="label_zh" value={zhStatus.get(status.id)?.label ?? status.label} lang="zh-Hans" required /></label></div></fieldset>
            <fieldset><legend>{copy.behavior}</legend><div class="care-form-grid care-form-three"><label><span class={lab}>{t(lang, 'admin.newcomers.sort')}</span><input class={tin} type="number" name="sort" value={status.sort} required /></label><label><span class={lab}>{t(lang, 'admin.newcomers.initial')}</span><select class={tin} name="initial_status_id">{english.statuses.filter((item) => item.active && item.category === 'open').map((item) => <option value={item.id} selected={item.id === initialStatusId}>{lang === 'zh' ? zhStatus.get(item.id)?.label || item.label : item.label}</option>)}</select></label><label><span class={lab}>{t(lang, 'admin.newcomers.active')}</span><select class={tin} name="active"><option value="true" selected={status.active}>{t(lang, 'admin.newcomers.yes')}</option><option value="false" selected={!status.active}>{t(lang, 'admin.newcomers.no')}</option></select></label></div></fieldset>
            <div class="care-form-actions"><button class={btnSecondary} type="submit">{t(lang, 'admin.newcomers.save')}</button></div>
          </form>
        </details>)}
      </div>
      <details id="create-welcome-stage" class="care-config-item care-config-create" open={error}>
        <summary>+ {copy.addStage}</summary>
        <form method="post" class="care-config-form"><input type="hidden" name="action" value="create-status" /><input type="hidden" name="active" value="true" /><div class="care-form-grid">
          <label><span class={lab}>{t(lang, 'admin.newcomers.key')}</span><input class={tin} name="key" required /></label>
          <label><span class={lab}>{t(lang, 'admin.newcomers.category')}</span><select class={tin} name="category"><option value="open">{copy.open}</option><option value="closed">{copy.closed}</option></select></label>
          <label><span class={lab}>{t(lang, 'locale.en')}</span><input class={tin} name="label_en" lang="en" required /></label><label><span class={lab}>{t(lang, 'locale.zh')}</span><input class={tin} name="label_zh" lang="zh-Hans" required /></label>
          <label><span class={lab}>{t(lang, 'admin.newcomers.sort')}</span><input class={tin} type="number" name="sort" value="100" required /></label>
        </div><div class="care-form-actions"><button class={btn} type="submit">{t(lang, 'admin.newcomers.add')}</button></div></form>
      </details>
    </section>
    <section id="welcome-fields" class="care-config-section">
      <div class="care-panel-heading"><div><h2>{copy.fields}</h2><p class="care-intro">{copy.fieldsIntro}</p></div><a class={btnSecondary} href="#create-welcome-field">+ {copy.addField}</a></div>
      <div class="care-config-list">
        {english.fields.map((field) => <details class="care-config-item" open={error}>
          <summary><span class="care-config-name">{lang === 'zh' ? zhField.get(field.id)?.label || field.label : field.label}<small>{copy[field.type]}{field.required ? ` · ${t(lang, 'admin.newcomers.required')}` : ''}</small></span><span class="care-state" data-active={field.active}>{field.active ? copy.active : copy.inactive}</span></summary>
          <form method="post" class="care-config-form"><input type="hidden" name="action" value="update-field" /><input type="hidden" name="id" value={field.id} />
            <fieldset><legend>{copy.labels}</legend><div class="care-form-grid"><label><span class={lab}>{t(lang, 'locale.en')}</span><input class={tin} name="label_en" value={field.label} lang="en" required /></label><label><span class={lab}>{t(lang, 'locale.zh')}</span><input class={tin} name="label_zh" value={zhField.get(field.id)?.label ?? field.label} lang="zh-Hans" required /></label><label><span class={lab}>{t(lang, 'admin.newcomers.helpEn')}</span><input class={tin} name="help_en" value={field.help ?? ''} lang="en" /></label><label><span class={lab}>{t(lang, 'admin.newcomers.helpZh')}</span><input class={tin} name="help_zh" value={zhField.get(field.id)?.help ?? ''} lang="zh-Hans" /></label></div></fieldset>
            <fieldset><legend>{copy.behavior}</legend><div class="care-form-grid care-form-three"><label><span class={lab}>{t(lang, 'admin.newcomers.sort')}</span><input class={tin} type="number" name="sort" value={field.sort} required /></label><label><span class={lab}>{t(lang, 'admin.newcomers.required')}</span><select class={tin} name="required"><option value="false" selected={!field.required}>{t(lang, 'admin.newcomers.no')}</option><option value="true" selected={field.required}>{t(lang, 'admin.newcomers.yes')}</option></select></label><label><span class={lab}>{t(lang, 'admin.newcomers.active')}</span><select class={tin} name="active"><option value="true" selected={field.active}>{t(lang, 'admin.newcomers.yes')}</option><option value="false" selected={!field.active}>{t(lang, 'admin.newcomers.no')}</option></select></label></div></fieldset>
            <label class="block"><span class={lab}>{copy.options}</span><textarea class={`${tin} font-mono`} rows="5" name="options_json" aria-describedby={`options-help-${field.id}`}>{optionJson(field)}</textarea><span id={`options-help-${field.id}`} class="mt-2 block text-xs text-ink-muted">{t(lang, 'admin.newcomers.optionsHelp')}</span></label>
            <div class="care-form-actions"><button class={btnSecondary} type="submit">{t(lang, 'admin.newcomers.save')}</button></div>
          </form>
        </details>)}
      </div>
      <details id="create-welcome-field" class="care-config-item care-config-create" open={error}>
        <summary>+ {copy.addField}</summary>
        <form method="post" class="care-config-form"><input type="hidden" name="action" value="create-field" /><input type="hidden" name="active" value="true" />
          <div class="care-form-grid"><label><span class={lab}>{t(lang, 'admin.newcomers.key')}</span><input class={tin} name="key" required /></label><label><span class={lab}>{t(lang, 'admin.newcomers.type')}</span><select class={tin} name="type"><option value="text">{copy.text}</option><option value="textarea">{copy.textarea}</option><option value="select">{copy.select}</option><option value="checkbox">{copy.checkbox}</option></select></label>
            <label><span class={lab}>{t(lang, 'locale.en')}</span><input class={tin} name="label_en" lang="en" required /></label><label><span class={lab}>{t(lang, 'locale.zh')}</span><input class={tin} name="label_zh" lang="zh-Hans" required /></label><label><span class={lab}>{t(lang, 'admin.newcomers.helpEn')}</span><input class={tin} name="help_en" lang="en" /></label><label><span class={lab}>{t(lang, 'admin.newcomers.helpZh')}</span><input class={tin} name="help_zh" lang="zh-Hans" /></label>
            <label><span class={lab}>{t(lang, 'admin.newcomers.sort')}</span><input class={tin} type="number" name="sort" value="100" required /></label><label><span class={lab}>{t(lang, 'admin.newcomers.required')}</span><select class={tin} name="required"><option value="false">{t(lang, 'admin.newcomers.no')}</option><option value="true">{t(lang, 'admin.newcomers.yes')}</option></select></label>
          </div><label class="block"><span class={lab}>{copy.options}</span><textarea class={`${tin} font-mono`} rows="5" name="options_json" aria-describedby="options-help-new">[]</textarea><span id="options-help-new" class="mt-2 block text-xs text-ink-muted">{t(lang, 'admin.newcomers.optionsHelp')}</span></label>
          <div class="care-form-actions"><button class={btn} type="submit">{t(lang, 'admin.newcomers.add')}</button></div>
        </form>
      </details>
    </section>
  </CareWorkspace>
</Admin>
