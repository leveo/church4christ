---
// Provider-neutral Learning provider administration.
import Admin from '../../../layouts/Admin.astro';
import { hasAreaAccess } from '../../../lib/adminAreas';
import { badge, btn, btnSecondary, card, lab, tin } from '../../../lib/adminUi';
import { t } from '../../../lib/i18n';
import { listLearningConnections } from '../../../lib/learningConnectionDb';
import type { Locale } from '../../../lib/locales';
import type { LearningConnectionStatus, LearningErrorCode } from '../../../lib/learningModel';

export const prerender = false;

const modules = Astro.locals.modules;
if (!modules.has('learning')) {
  return new Response(null, { status: 404, headers: { 'cache-control': 'no-store' } });
}
const user = Astro.locals.user;
if (!hasAreaAccess(user, 'learning')) {
  return new Response(null, { status: 403, headers: { 'cache-control': 'no-store' } });
}
if (Astro.request.method !== 'GET' && Astro.request.method !== 'HEAD') {
  return new Response(null, {
    status: 405,
    headers: { allow: 'GET, HEAD', 'cache-control': 'no-store' },
  });
}
const lang: Locale = user!.lang === 'zh' ? 'zh' : 'en';
const connections = await listLearningConnections(Astro.locals.db, { includeDeleted: true, limit: 100 });
const copy = lang === 'zh' ? {
  providers: '学习平台连接',
  none: '尚未连接 Google Classroom 或 Canvas。',
  createCanvas: '连接 Canvas',
  createGoogle: '准备 Google Classroom',
  name: '显示名称',
  baseUrl: 'Canvas HTTPS 地址',
  create: '建立连接',
  update: '保存设置',
  health: '检查状态',
  disconnect: '断开连接',
  authorizeGoogle: '授权 Google Classroom',
  authorizeCanvas: '使用 OAuth 授权 Canvas',
  selectGoogleCourses: '选择 Classroom 课程',
  selectCanvasCourses: '选择 Canvas 课程',
  googleNote: 'Google 授权将在 OAuth 设置步骤中完成。',
  saved: '连接设置已保存。',
  googleConnected: 'Google Classroom 已安全连接。',
  canvasConnected: 'Canvas 已安全连接。',
  googleAuthorizationFailed: 'Google 授权未完成；请重新开始授权流程。',
  canvasAuthorizationFailed: 'Canvas 授权未完成；请重新开始授权流程。',
  error: '连接设置未能保存；请刷新后重试。',
} : {
  providers: 'Learning provider connections',
  none: 'No Google Classroom or Canvas connection has been configured.',
  createCanvas: 'Connect Canvas',
  createGoogle: 'Prepare Google Classroom',
  name: 'Display name',
  baseUrl: 'Canvas HTTPS address',
  create: 'Create connection',
  update: 'Save settings',
  health: 'Check status',
  disconnect: 'Disconnect',
  authorizeGoogle: 'Authorize Google Classroom',
  authorizeCanvas: 'Authorize Canvas with OAuth',
  selectGoogleCourses: 'Select Classroom courses',
  selectCanvasCourses: 'Select Canvas courses',
  googleNote: 'Google authorization is completed in the OAuth setup step.',
  saved: 'Connection settings were saved.',
  googleConnected: 'Google Classroom was connected securely.',
  canvasConnected: 'Canvas was connected securely.',
  googleAuthorizationFailed: 'Google authorization was not completed. Start the authorization flow again.',
  canvasAuthorizationFailed: 'Canvas authorization was not completed. Start the authorization flow again.',
  error: 'Connection settings could not be saved. Refresh and try again.',
};
type ConnectionErrorCode =
  | 'connection_conflict'
  | 'connection_invalid'
  | 'credentials_unavailable'
  | 'connection_failed'
  | 'google_authorization_failed'
  | 'canvas_authorization_failed'
  | LearningErrorCode;
const statusLabels: Record<LearningConnectionStatus, string> = lang === 'zh' ? {
  pending: '等待授权', active: '正常', error: '需要处理', disabled: '已断开',
} : {
  pending: 'Pending authorization', active: 'Active', error: 'Needs attention', disabled: 'Disconnected',
};
const errorMessages: Record<ConnectionErrorCode, string> = lang === 'zh' ? {
  connection_conflict: '连接已被其他管理员更新；请刷新后重试。',
  connection_invalid: '连接设置无效。',
  credentials_unavailable: '学习平台凭据暂时不可用。',
  connection_failed: '连接设置未能安全保存；请刷新后重试。',
  google_authorization_failed: copy.googleAuthorizationFailed,
  canvas_authorization_failed: copy.canvasAuthorizationFailed,
  invalid_request: '学习平台拒绝了状态检查请求。',
  authentication_required: '学习平台需要重新授权。',
  permission_denied: '学习平台账号没有所需权限。',
  not_found: '学习平台连接不存在。',
  rate_limited: '学习平台请求过多；请稍后重试。',
  provider_unavailable: '学习平台暂时不可用。',
  malformed_response: '学习平台返回了无效响应。',
  response_too_large: '学习平台响应超过安全大小限制。',
  pagination_limit: '学习平台响应超过安全分页限制。',
  conflict: '学习平台状态已改变；请重试。',
  timeout: '学习平台状态检查超时。',
  cancelled: '学习平台状态检查已取消。',
  internal_error: '学习平台状态检查安全失败。',
} : {
  connection_conflict: 'Another administrator changed this connection. Refresh and try again.',
  connection_invalid: 'The connection settings are invalid.',
  credentials_unavailable: 'Learning provider credentials are temporarily unavailable.',
  connection_failed: 'The connection settings could not be saved safely. Refresh and try again.',
  google_authorization_failed: copy.googleAuthorizationFailed,
  canvas_authorization_failed: copy.canvasAuthorizationFailed,
  invalid_request: 'The Learning provider rejected the health-check request.',
  authentication_required: 'The Learning provider must be authorized again.',
  permission_denied: 'The Learning provider account lacks the required permission.',
  not_found: 'The Learning provider connection was not found.',
  rate_limited: 'The Learning provider rate limit was reached. Try again later.',
  provider_unavailable: 'The Learning provider is temporarily unavailable.',
  malformed_response: 'The Learning provider returned an invalid response.',
  response_too_large: 'The Learning provider response exceeded the safe size limit.',
  pagination_limit: 'The Learning provider response exceeded the safe page limit.',
  conflict: 'The Learning provider state changed. Try again.',
  timeout: 'The Learning provider health check timed out.',
  cancelled: 'The Learning provider health check was cancelled.',
  internal_error: 'The Learning provider health check failed safely.',
};
const savedCodes = new Set([
  'connection_created', 'connection_updated',
  'connection_disconnected', 'health_checked', 'google_connected', 'canvas_connected',
]);
const queryEntries = [...Astro.url.searchParams.entries()];
let banner: { readonly tone: 'success' | 'danger'; readonly text: string } | null = null;
if (queryEntries.length === 1) {
  const [name, value] = queryEntries[0];
  if (name === 'saved' && savedCodes.has(value)) {
    banner = { tone: 'success', text: value === 'google_connected'
      ? copy.googleConnected : value === 'canvas_connected' ? copy.canvasConnected : copy.saved };
  }
  if (name === 'error' && Object.hasOwn(errorMessages, value)) {
    banner = { tone: 'danger', text: errorMessages[value as ConnectionErrorCode] };
  }
}
---

<Admin title={t(lang, 'admin.learning.title')}>
  <h1 class="font-display text-heading-md font-bold">{t(lang, 'admin.learning.title')}</h1>
  <p class="mt-2 max-w-3xl text-ink-muted">{t(lang, 'admin.learning.intro')}</p>
  {banner && <p class={`mt-4 max-w-3xl rounded-card px-4 py-3 text-sm ${
    banner.tone === 'success' ? 'bg-success/10 text-success' : 'bg-danger/10 text-danger'
  }`}>{banner.text}</p>}

  <section class="mt-8 max-w-4xl">
    <h2 class="font-display text-heading-sm font-bold">{copy.providers}</h2>
    {connections.length === 0 && <p class={`mt-4 ${card} text-ink-muted`}>{copy.none}</p>}
    <div class="mt-4 grid gap-4">
      {connections.map((connection) => (
        <article class={card}>
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <h3 class="font-display text-lg font-bold">{connection.displayName}</h3>
              <p class="mt-1 text-sm text-ink-muted">
                {connection.provider === 'canvas' ? 'Canvas' : 'Google Classroom'}
                {connection.baseUrl ? ` · ${connection.baseUrl}` : ''}
              </p>
            </div>
            <span class={badge}>{statusLabels[connection.status]}</span>
          </div>
          {connection.lastErrorCode && Object.hasOwn(errorMessages, connection.lastErrorCode) && (
            <p class="mt-3 text-sm text-danger">{errorMessages[connection.lastErrorCode as ConnectionErrorCode]}</p>
          )}

          {connection.deletedAt === null ? (
            <div class="mt-5 grid gap-4">
              <form method="post" action="/admin/learning/connections" class="grid gap-3 md:grid-cols-2">
                <input type="hidden" name="action" value="update" />
                <input type="hidden" name="connection_id" value={connection.connectionId} />
                <input type="hidden" name="revision" value={connection.revision} />
                <input type="hidden" name="provider" value={connection.provider} />
                <label class={lab}>{copy.name}<input class={tin} name="display_name" value={connection.displayName} required maxlength="120" /></label>
                {connection.provider === 'canvas' && (
                  <label class={lab}>{copy.baseUrl}<input class={tin} type="url" name="base_url" value={connection.baseUrl ?? ''} required maxlength="2048" /></label>
                )}
                <button class={btnSecondary} type="submit">{copy.update}</button>
              </form>
              <div class="flex flex-wrap gap-3">
                {connection.provider === 'google_classroom' && (
                  <form method="post" action="/admin/learning/google/start">
                    <input type="hidden" name="connection_id" value={connection.connectionId} />
                    <input type="hidden" name="revision" value={connection.revision} />
                    <button class={btn} type="submit">{copy.authorizeGoogle}</button>
                  </form>
                )}
                {connection.provider === 'canvas' && connection.baseUrl && (
                  <form method="post" action="/admin/learning/canvas/start">
                    <input type="hidden" name="connection_id" value={connection.connectionId} />
                    <input type="hidden" name="revision" value={connection.revision} />
                    <input type="hidden" name="base_url" value={connection.baseUrl} />
                    <button class={btn} type="submit">{copy.authorizeCanvas}</button>
                  </form>
                )}
                {connection.provider === 'google_classroom' && connection.status === 'active' && (
                  <a class={btnSecondary} href={`/admin/learning/google/courses?connection_id=${connection.connectionId}`}>
                    {copy.selectGoogleCourses}
                  </a>
                )}
                {connection.provider === 'canvas' && connection.status === 'active' && (
                  <a class={btnSecondary} href={`/admin/learning/canvas/courses?connection_id=${connection.connectionId}`}>
                    {copy.selectCanvasCourses}
                  </a>
                )}
                <form method="post" action="/admin/learning/connections">
                  <input type="hidden" name="action" value="health_check" />
                  <input type="hidden" name="connection_id" value={connection.connectionId} />
                  <input type="hidden" name="revision" value={connection.revision} />
                  <input type="hidden" name="provider" value={connection.provider} />
                  <input type="hidden" name="status" value={connection.status} />
                  <button class={btnSecondary} type="submit">{copy.health}</button>
                </form>
                <form method="post" action="/admin/learning/connections">
                  <input type="hidden" name="action" value="disconnect" />
                  <input type="hidden" name="connection_id" value={connection.connectionId} />
                  <input type="hidden" name="revision" value={connection.revision} />
                  <button class={btnSecondary} type="submit">{copy.disconnect}</button>
                </form>
              </div>
            </div>
          ) : <p class="mt-4 text-sm text-ink-muted">{copy.googleNote}</p>}
        </article>
      ))}
    </div>
  </section>

  <section class="mt-8 grid max-w-4xl gap-4 lg:grid-cols-2">
    <form method="post" action="/admin/learning/connections" class={card}>
      <input type="hidden" name="action" value="create" />
      <input type="hidden" name="provider" value="canvas" />
      <h2 class="font-display text-heading-sm font-bold">{copy.createCanvas}</h2>
      <label class={`${lab} mt-4`}>{copy.name}<input class={tin} name="display_name" required maxlength="120" /></label>
      <label class={`${lab} mt-3`}>{copy.baseUrl}<input class={tin} type="url" name="base_url" placeholder="https://canvas.example.org" required maxlength="2048" /></label>
      <button class={`${btn} mt-4`} type="submit">{copy.create}</button>
    </form>
    <form method="post" action="/admin/learning/connections" class={card}>
      <input type="hidden" name="action" value="create" />
      <input type="hidden" name="provider" value="google_classroom" />
      <h2 class="font-display text-heading-sm font-bold">{copy.createGoogle}</h2>
      <p class="mt-2 text-sm text-ink-muted">{copy.googleNote}</p>
      <label class={`${lab} mt-4`}>{copy.name}<input class={tin} name="display_name" required maxlength="120" /></label>
      <button class={`${btn} mt-4`} type="submit">{copy.create}</button>
    </form>
  </section>
</Admin>
