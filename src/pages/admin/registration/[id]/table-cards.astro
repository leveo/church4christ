---
// Printable table cards for one event (event logistics, seating): one card per table with its label in large
// type and the names of the people at it. Gated like the badges ('view' on this event) plus the module and the
// event's seating switch (404 otherwise).
import PrintSheet from '../../../../layouts/PrintSheet.astro';
import { logisticsPrintGate } from '../../../../lib/regLogisticsPrint';
import { listSeating } from '../../../../lib/regSeating';
import { t } from '../../../../lib/i18n';

const gate = await logisticsPrintGate(Astro.locals, Astro.params.id, 'seating');
if (gate instanceof Response) return gate;
const { eventId, lang, eventTitle, names } = gate;
const tables = await listSeating(Astro.locals.db, eventId);
---

<PrintSheet title={`${t(lang, 'admin.reg.lx.print.tableCards')} · ${eventTitle}`} lang={lang}>
  <div class="print-toolbar">
    <a href={`/admin/registration/${eventId}?tab=tables#logistics`}>{t(lang, 'admin.reg.backToEvent')}</a>
    <button type="button" class="print-primary" data-print>{t(lang, 'admin.reg.print')}</button>
  </div>
  <main class="lx-cards" data-testid="table-cards">
    {tables.length === 0 && <p class="p-6 text-ink-muted no-print">{t(lang, 'admin.reg.lx.noTables')}</p>}
    {tables.map((tb) => (
      <article class="lx-card" data-card={tb.id}>
        <p class="lx-card-event">{eventTitle}</p>
        <p class="lx-card-label">{tb.label}</p>
        <ul class="lx-card-names">{tb.occupants.map((id) => <li>{names.get(id) ?? ''}</li>)}</ul>
      </article>
    ))}
  </main>
  <script is:inline>
    document.querySelector('[data-print]')?.addEventListener('click', function () { window.print(); });
  </script>
</PrintSheet>

<style is:global>
  .lx-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr)); gap: 1rem; padding: 1rem; }
  .lx-card { display: flex; flex-direction: column; align-items: center; min-height: 16rem; padding: 1.25rem; border: 2px solid var(--color-border-strong); border-radius: var(--radius-md); background: var(--color-surface-raised); text-align: center; break-inside: avoid; }
  .lx-card-event { font-size: .875rem; font-weight: 600; color: var(--color-ink-muted); }
  .lx-card-label { margin: .5rem 0 .75rem; font-family: var(--font-display); font-size: 3.5rem; font-weight: 800; line-height: 1; overflow-wrap: anywhere; }
  .lx-card-names { display: grid; gap: .2rem; font-size: 1.125rem; }
  @media print {
    .lx-cards { grid-template-columns: repeat(2, 1fr); padding: 0; gap: 6mm; }
    .lx-card { min-height: 120mm; background: transparent; border-color: var(--color-ink); }
  }
</style>
