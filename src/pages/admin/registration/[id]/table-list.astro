---
// Printable table list for one event (event logistics, seating): each table with the names of the people at it,
// the host marked. Gated like the badges ('view' on this event) plus the module and the event's seating switch.
import PrintSheet from '../../../../layouts/PrintSheet.astro';
import { logisticsPrintGate } from '../../../../lib/regLogisticsPrint';
import { listSeating } from '../../../../lib/regSeating';
import { t } from '../../../../lib/i18n';

const gate = await logisticsPrintGate(Astro.locals, Astro.params.id, 'seating');
if (gate instanceof Response) return gate;
const { eventId, lang, eventTitle, names } = gate;
const tables = await listSeating(Astro.locals.db, eventId);
const total = tables.reduce((n, tb) => n + tb.occupants.length, 0);
---

<PrintSheet title={`${t(lang, 'admin.reg.lx.print.tableList')} · ${eventTitle}`} lang={lang}>
  <div class="print-toolbar">
    <a href={`/admin/registration/${eventId}?tab=tables#logistics`}>{t(lang, 'admin.reg.backToEvent')}</a>
    <button type="button" class="print-primary" data-print>{t(lang, 'admin.reg.print')}</button>
  </div>
  <main class="sheet" data-testid="table-list">
    <h1 class="sheet-title">{eventTitle}</h1>
    <p class="sheet-meta">{t(lang, 'admin.reg.lx.print.tableList')} · {t(lang, 'admin.reg.lx.print.peopleSeated', { n: total })}</p>
    <div class="lx-print-grid">
      {tables.map((tb) => (
        <section class="lx-print-block" data-table={tb.id}>
          <h2 class="lx-print-h2">{tb.label} <span class="lx-print-note">{tb.occupants.length} / {tb.seats}</span></h2>
          <ol class="lx-print-names">{tb.occupants.map((id) => <li>{names.get(id) ?? ''}{tb.hostAttendeeId === id ? ` (${t(lang, 'admin.reg.lx.host')})` : ''}</li>)}</ol>
        </section>
      ))}
    </div>
  </main>
  <script is:inline>
    document.querySelector('[data-print]')?.addEventListener('click', function () { window.print(); });
  </script>
</PrintSheet>

<style is:global>
  .sheet { max-width: 60rem; margin: 0 auto; padding: 1.5rem; }
  .sheet-title { font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; }
  .sheet-meta { margin: .25rem 0 1rem; color: var(--color-ink-muted); font-size: .875rem; }
  .lx-print-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 1rem; }
  .lx-print-block { padding: .75rem; border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm); break-inside: avoid; }
  .lx-print-h2 { font-family: var(--font-display); font-size: 1.125rem; font-weight: 700; display: flex; justify-content: space-between; gap: .5rem; }
  .lx-print-note { color: var(--color-ink-muted); font-size: .75rem; font-weight: 400; font-variant-numeric: tabular-nums; }
  .lx-print-names { margin-top: .35rem; padding-left: 1.25rem; list-style: decimal; font-size: .9375rem; }
</style>
