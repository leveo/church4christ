---
import LocaleFields from '../../../components/admin/LocaleFields.astro';
import GatheringSurface from '../../../components/gatherings/GatheringSurface.astro';
import { gatheringsCopy } from '../../../i18n/designGatherings';

// Registration events admin (console class — editors run events, so this re-checks
// editor∪admin and 403s a bare team leader, mirroring the events console). Inline
// add/edit model like funds/events (?edit=<id>, a single save action): the create
// form doubles as the editor. Price is dollars → integer cents with blank/0 = a
// free event (price_cents NULL); datetimes are datetime-local → UTC. Per-event
// questions + roster live on /admin/registration/[id]. Deactivate an event by
// editing it and unchecking Active — there is no destructive delete here.
import Admin from '../../../layouts/Admin.astro';
import { env } from 'cloudflare:workers';
import { t } from '../../../lib/i18n';
import { applyEventAction, saveEventFromForm } from '../../../lib/regAdminActions';
import { listEventsAdmin, type RegPhase } from '../../../lib/regDb';
import { utcToDatetimeLocal, toUtcSql } from '../../../lib/dates';
import { formatCents } from '../../../lib/money';
import { tin, lab, card, errorText, btn, badge, badgeActive, badgeInactive, badgeScheduled, th, td, noticeOk, noticeErr } from '../../../lib/adminUi';
import { SUPPORTED_LOCALES, type Locale } from '../../../lib/locales';
import { hasAreaAccess } from '../../../lib/adminAreas';
import { ALLOWED_IMAGE_TYPES, MAX_IMAGE_BYTES } from '../../../lib/upload';
import { saveImageUpload, uploadErrorKey, type MediaBucket } from '../../../lib/mediaUpload';
import { mediaPath } from '../../../lib/mediaRef';

const user = Astro.locals.user;
if (!user || !(user.isEditor || hasAreaAccess(user, 'registration'))) return new Response(null, { status: 403 });
const lang: Locale = user.lang ?? 'en';
const db = Astro.locals.db;

let errors: Record<string, string> = {};
let fd: FormData | null = null;
let failedId: string | null = null; // id whose form failed ('' = the create form)
let badRequest = false; // unparseable POST body -> generic localized banner, not a 500
const isD1 = Astro.locals.dbBackend === 'd1';

if (Astro.request.method === 'POST') {
  // Reject a clearly oversized poster before buffering it (the form then re-renders blank).
  const contentLength = Number(Astro.request.headers.get('content-length') ?? '0');
  if (contentLength > MAX_IMAGE_BYTES + 1_000_000) {
    errors.poster = 'errors.imageTooLarge';
    failedId = '';
  } else {
    try {
      fd = await Astro.request.formData();
    } catch {
      badRequest = true;
    }
  }
  if (fd) {
    const action = String(fd.get('action') ?? '');
    const idRaw = String(fd.get('id') ?? '');
    const id = /^\d+$/.test(idRaw) ? Number(idRaw) : null;
    if (action === 'event') {
      // A lifecycle button or Duplicate. Duplicate lands on the new event's editor.
      const result = await applyEventAction(db, fd);
      if (result.ok) {
        return Astro.redirect(
          result.notice === 'duplicated' ? `/admin/registration?edit=${result.id}&duplicated=1` : '/admin/registration?updated=1',
          303,
        );
      }
      return Astro.redirect(`/admin/registration?error=${result.error}${result.id !== null ? `&row=${result.id}` : ''}`, 303);
    }
    if (action === 'save') {
      let poster: string | null | undefined;
      const file = fd.get('poster_file');
      if (file instanceof File && file.size > 0) {
        try {
          const media = (env as { MEDIA: MediaBucket }).MEDIA;
          poster = await saveImageUpload({ db, media, file, uploadedBy: user.email });
        } catch (e) {
          errors.poster = uploadErrorKey(e);
        }
      } else if (fd.get('remove_poster')) {
        poster = null;
      }
      if (!errors.poster) {
        const result = await saveEventFromForm(db, Astro.locals.dbBackend, fd, { id, ...(poster !== undefined ? { poster } : {}) });
        if (result.ok) return Astro.redirect('/admin/registration?saved=1', 303);
        errors = result.errors;
      }
      failedId = id === null ? '' : String(id);
    }
  }
}

const rows = await listEventsAdmin(db);
const saved = Astro.url.searchParams.get('saved') === '1';
const updated = Astro.url.searchParams.get('updated') === '1';
const duplicated = Astro.url.searchParams.get('duplicated') === '1';
const actionError = Astro.url.searchParams.get('error');
const actionErrorRow = Astro.url.searchParams.get('row') ?? '';

// Summary row: counts derive from the admin list already loaded (same seat counts
// the table renders). "Open" is the lifecycle phase. Seats remaining only sums open
// events with a capacity cap.
const nowSql = toUtcSql();
const openEvents = rows.filter((r) => r.phase === 'open');
const activeRegistrations = rows.reduce((sum, r) => sum + r.confirmed_count, 0);
const seatsRemaining = openEvents.reduce(
  (sum, r) => sum + (r.capacity == null ? 0 : Math.max(0, r.capacity - r.taken_count)),
  0,
);
const stats = [
  { label: t(lang, 'admin.reg.stats.openEvents'), value: String(openEvents.length) },
  { label: t(lang, 'admin.reg.stats.activeRegistrations'), value: String(activeRegistrations) },
  { label: t(lang, 'admin.reg.stats.seatsRemaining'), value: String(seatsRemaining) },
];

const defaultLocale = Astro.locals.locales.default;
const phaseBadge: Record<RegPhase, string> = {
  hidden: badgeInactive,
  preview: badgeScheduled,
  open: badgeActive,
  closed: badgeInactive,
};
const displayTitle = (r: (typeof rows)[number]) => r.titles[lang] || r.titles[defaultLocale] || r.title_en || '—';
const needsNewClose = (r: (typeof rows)[number]) => (r.closes_at ?? r.starts_at) <= nowSql;

const editParam = Astro.url.searchParams.get('edit');
const editId = failedId !== null ? failedId : editParam && /^\d+$/.test(editParam) ? editParam : '';
const editingRow = editId ? (rows.find((r) => String(r.id) === editId) ?? null) : null;

const g = (n: string) => String(fd?.get(n) ?? '');
const echoing = fd !== null && failedId !== null;
const dollars = (cents: number | null) => (cents == null ? '' : (cents / 100).toFixed(2));
// Per-language values for the tabbed fields: the posted text when a save bounced,
// the stored text otherwise.
const titleValues: Partial<Record<Locale, string>> = {};
const descValues: Partial<Record<Locale, string>> = {};
const noteValues: Partial<Record<Locale, string>> = {};
for (const code of SUPPORTED_LOCALES) {
  titleValues[code] = echoing ? g(`title_${code}`) : (editingRow?.titles[code] ?? '');
  descValues[code] = echoing ? g(`description_${code}`) : (editingRow?.descriptions[code] ?? '');
  noteValues[code] = echoing ? g(`notes_${code}`) : (editingRow?.notes[code] ?? '');
}
const v = echoing
  ? {
      startsAt: g('starts_at'), endsAt: g('ends_at'), opensAt: g('opens_at'), closesAt: g('closes_at'), visibleFrom: g('visible_from'),
      location: g('location'), capacity: g('capacity'), price: g('price'), active: fd!.get('active') !== null,
      waitlist: String(fd!.getAll('waitlist_enabled').at(-1) ?? '1') === '1', prefix: g('confirmation_prefix'), poster: g('poster'),
      maxParty: g('max_party_size'), selfEdit: String(fd!.getAll('allow_self_edit').at(-1) ?? '1') === '1',
    }
  : editingRow
    ? {
        startsAt: utcToDatetimeLocal(editingRow.starts_at), endsAt: utcToDatetimeLocal(editingRow.ends_at),
        opensAt: utcToDatetimeLocal(editingRow.opens_at), closesAt: utcToDatetimeLocal(editingRow.closes_at),
        visibleFrom: utcToDatetimeLocal(editingRow.visible_from),
        location: editingRow.location ?? '', capacity: editingRow.capacity == null ? '' : String(editingRow.capacity),
        price: dollars(editingRow.price_cents), active: editingRow.active === 1,
        waitlist: editingRow.waitlist_enabled === 1, prefix: editingRow.confirmation_prefix ?? '', poster: editingRow.poster ?? '',
        maxParty: String(editingRow.max_party_size), selfEdit: editingRow.allow_self_edit === 1,
      }
    : { startsAt: '', endsAt: '', opensAt: '', closesAt: '', visibleFrom: '', location: '', capacity: '', price: '', active: true, waitlist: true, prefix: '', poster: '', maxParty: '1', selfEdit: true };
const posterSrc = mediaPath(v.poster);

const hasErrors = Object.keys(errors).length > 0;
const heading = t(lang, 'admin.reg.title');
const formHeading = editId ? t(lang, 'admin.reg.editEvent') : t(lang, 'admin.reg.newEvent');
const copy = gatheringsCopy(lang);
const h2 = 'font-display text-heading-sm font-bold';
// Compact list actions, still a 44px touch target.
const actionBtn =
  'inline-flex min-h-11 items-center justify-center rounded-md border border-border px-3 py-1.5 text-xs font-semibold text-ink-muted hover:bg-surface-sunken';
---

<Admin title={heading}>
  <GatheringSurface>
  <div class="gathering-heading"><div><p class="gathering-eyebrow">{copy.eyebrow}</p><h1>{heading}</h1><p class="gathering-intro">{copy.adminRegistrationIntro}</p></div><a href="?new=1#gathering-event-editor" class={btn}>{t(lang, 'admin.reg.newEvent')}</a></div>
  {saved && <p class={`mt-4 ${noticeOk}`}>{t(lang, 'admin.form.saved')}</p>}
  {updated && <p class={`mt-4 ${noticeOk}`}>{t(lang, 'admin.reg.updated')}</p>}
  {duplicated && <p class={`mt-4 ${noticeOk}`}>{t(lang, 'admin.reg.duplicated')}</p>}
  {badRequest && <p class={`mt-4 ${noticeErr}`}>{t(lang, 'admin.form.badRequest')}</p>}
  {actionError === 'close_required' && <p class={`mt-4 ${noticeErr}`} data-testid="close-required">{t(lang, 'admin.reg.closeRequired')}</p>}
  {(actionError === 'invalid' || actionError === 'not_found') && <p class={`mt-4 ${noticeErr}`}>{t(lang, 'admin.form.badRequest')}</p>}

  <dl class="gathering-stats">{stats.map((stat) => <div><dt>{stat.label}</dt><dd>{stat.value}</dd></div>)}</dl>


  <h2 class={`mt-8 ${h2}`}>{t(lang, 'admin.reg.events')}</h2>
  <div class="gathering-table-wrap mt-4">
    <table class="gathering-table">
      <thead class="bg-surface-sunken">
        <tr>
          <th class={th}>{t(lang, 'admin.reg.titleEn')}</th>
          <th class={th}>{t(lang, 'admin.reg.starts')}</th>
          <th class={th}>{t(lang, 'admin.reg.registered')}</th>
          <th class={th}>{t(lang, 'admin.reg.price')}</th>
          <th class={th}>{t(lang, 'admin.reg.status')}</th>
          <th class={th}>{t(lang, 'admin.reg.actions')}</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.length === 0 ? (
            <tr>
              <td class={`${td} text-ink-muted`} colspan="6">
                {t(lang, 'admin.reg.empty')}
              </td>
            </tr>
          ) : (
            rows.map((r) => (
              <tr class="border-t border-border align-top" data-event-id={r.id}>
                <td class={td}>
                  <div class="font-medium">{displayTitle(r)}</div>
                </td>
                <td class={`${td} text-ink-muted tabular-nums`}>{utcToDatetimeLocal(r.starts_at).replace('T', ' ')}</td>
                <td class={`${td} tabular-nums`}>
                  {r.taken_count}
                  {r.capacity != null ? ` / ${r.capacity}` : ''}
                  {r.waitlist_count > 0 && <div class="text-xs text-ink-muted">{t(lang, 'admin.reg.waitlistCount', { count: r.waitlist_count })}</div>}
                </td>
                <td class={td}>{r.price_cents == null ? t(lang, 'admin.reg.free') : formatCents(r.price_cents, r.currency)}</td>
                <td class={td}>
                  <span class={`${badge} ${phaseBadge[r.phase]}`} data-phase={r.phase}>{t(lang, `admin.reg.phase.${r.phase}`)}</span>
                </td>
                <td class={td}>
                  <div class="flex flex-wrap items-center gap-2">
                    <a href={`/admin/registration?edit=${r.id}`} class={actionBtn}>{t(lang, 'admin.form.edit')}</a>
                    <a href={`/admin/registration/${r.id}`} class={actionBtn}>{t(lang, 'admin.reg.manage')}</a>
                    {r.phase !== 'open' && (
                      <form method="post" class="flex flex-wrap items-center gap-2">
                        <input type="hidden" name="action" value="event" />
                        <input type="hidden" name="id" value={r.id} />
                        <input type="hidden" name="op" value="open_now" />
                        {(needsNewClose(r) || (actionError === 'close_required' && actionErrorRow === String(r.id))) && (
                          <label class="flex items-center gap-2 text-xs text-ink-muted">
                            <span>{t(lang, 'admin.reg.newClose')}</span>
                            <input type="datetime-local" name="closes_at" required class={`${tin} w-auto`} />
                          </label>
                        )}
                        <button type="submit" class={actionBtn}>{t(lang, 'admin.reg.action.openNow')}</button>
                      </form>
                    )}
                    {(r.phase === 'open' || r.phase === 'preview') && (
                      <form method="post">
                        <input type="hidden" name="action" value="event" />
                        <input type="hidden" name="id" value={r.id} />
                        <input type="hidden" name="op" value="close_now" />
                        <button type="submit" class={actionBtn} data-confirm={t(lang, 'admin.reg.closeConfirm')}>{t(lang, 'admin.reg.action.closeNow')}</button>
                      </form>
                    )}
                    <form method="post">
                      <input type="hidden" name="action" value="event" />
                      <input type="hidden" name="id" value={r.id} />
                      <input type="hidden" name="op" value={r.active === 1 ? 'hide' : 'show'} />
                      <button type="submit" class={actionBtn}>{t(lang, r.active === 1 ? 'admin.reg.action.hide' : 'admin.reg.action.show')}</button>
                    </form>
                    <form method="post">
                      <input type="hidden" name="action" value="event" />
                      <input type="hidden" name="id" value={r.id} />
                      <input type="hidden" name="op" value="duplicate" />
                      <button type="submit" class={actionBtn}>{t(lang, 'admin.reg.action.duplicate')}</button>
                    </form>
                  </div>
                </td>
              </tr>
            ))
          )
        }
      </tbody>
    </table>
  </div>
  <details id="gathering-event-editor" class="gathering-editor" open={Astro.url.searchParams.has('new') || !!editId || hasErrors || rows.length === 0}><summary>{formHeading}</summary>
  <form method="post" enctype="multipart/form-data" class="mt-6 max-w-2xl">
    <section class={`${card} space-y-4`}>
      <h2 class={h2}>{formHeading}</h2>
      <input type="hidden" name="action" value="save" />
      {editId && <input type="hidden" name="id" value={editId} />}
      {hasErrors && <p class={noticeErr}>{t(lang, 'admin.form.fixErrors')}</p>}

      <div><LocaleFields name="title" label={t(lang, 'admin.reg.titleEn')} values={titleValues} lang={lang} error={errors[`title_${defaultLocale}`]} /></div>
      <div><LocaleFields name="description" label={t(lang, 'admin.reg.descEn')} values={descValues} lang={lang} multiline rows={3} /></div>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class={lab}>{t(lang, 'admin.reg.starts')}</span>
          <input type="datetime-local" name="starts_at" value={v.startsAt} class={tin} />
          {errors.starts_at && <span class={errorText}>{t(lang, errors.starts_at)}</span>}
        </label>
        <label class="block">
          <span class={lab}>{t(lang, 'admin.reg.ends')}</span>
          <input type="datetime-local" name="ends_at" value={v.endsAt} class={tin} />
          {errors.ends_at && <span class={errorText}>{t(lang, errors.ends_at)}</span>}
        </label>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class={lab}>{t(lang, 'admin.reg.opens')}</span>
          <input type="datetime-local" name="opens_at" value={v.opensAt} class={tin} />
          {errors.opens_at && <span class={errorText}>{t(lang, errors.opens_at)}</span>}
        </label>
        <label class="block">
          <span class={lab}>{t(lang, 'admin.reg.closes')}</span>
          <input type="datetime-local" name="closes_at" value={v.closesAt} class={tin} />
          {errors.closes_at && <span class={errorText}>{t(lang, errors.closes_at)}</span>}
        </label>
      </div>
      <label class="block sm:max-w-xs">
        <span class={lab}>{t(lang, 'admin.reg.visibleFrom')}</span>
        <input type="datetime-local" name="visible_from" value={v.visibleFrom} class={tin} />
        {errors.visible_from && <span class={errorText}>{t(lang, errors.visible_from)}</span>}
      </label>
      <p class="text-xs text-ink-subtle">{t(lang, 'admin.reg.visibleFromHint')}</p>
      <div class="grid gap-4 sm:grid-cols-3">
        <label class="block">
          <span class={lab}>{t(lang, 'admin.reg.location')}</span>
          <input name="location" value={v.location} class={tin} />
        </label>
        <label class="block">
          <span class={lab}>{t(lang, 'admin.reg.capacity')}</span>
          <input name="capacity" value={v.capacity} class={tin} inputmode="numeric" />
          {errors.capacity && <span class={errorText}>{t(lang, errors.capacity)}</span>}
        </label>
        <label class="block">
          <span class={lab}>{t(lang, 'admin.reg.price')}</span>
          <input name="price" value={v.price} class={tin} inputmode="decimal" disabled={isD1} />
          {errors.price && <span class={errorText}>{t(lang, errors.price)}</span>}
        </label>
      </div>
      <p class="text-xs text-ink-subtle">{t(lang, isD1 ? 'admin.reg.priceD1' : 'admin.reg.priceHint')}</p>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="flex min-h-11 items-center gap-2 text-sm">
          <input type="hidden" name="waitlist_enabled" value="0" />
          <input type="checkbox" name="waitlist_enabled" value="1" checked={v.waitlist} /> {t(lang, 'admin.reg.waitlist')}
        </label>
        <label class="block">
          <span class={lab}>{t(lang, 'admin.reg.confirmationPrefix')}</span>
          <input name="confirmation_prefix" value={v.prefix} class={`${tin} uppercase`} maxlength="6" autocapitalize="characters" />
          {errors.confirmation_prefix && <span class={errorText}>{t(lang, errors.confirmation_prefix)}</span>}
        </label>
      </div>
      <p class="text-xs text-ink-subtle">{t(lang, 'admin.reg.confirmationPrefixHint')}</p>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class={lab}>{t(lang, 'admin.reg.maxParty')}</span>
          <input type="number" name="max_party_size" value={v.maxParty} class={tin} min="1" max="20" inputmode="numeric" />
          {errors.max_party_size && <span class={errorText}>{t(lang, errors.max_party_size)}</span>}
        </label>
        <label class="flex min-h-11 items-center gap-2 self-end text-sm">
          <input type="hidden" name="allow_self_edit" value="0" />
          <input type="checkbox" name="allow_self_edit" value="1" checked={v.selfEdit} /> {t(lang, 'admin.reg.selfEdit')}
        </label>
      </div>
      <p class="text-xs text-ink-subtle">{t(lang, 'admin.reg.maxPartyHint')} {t(lang, 'admin.reg.selfEditHint')}</p>
      <div><LocaleFields name="notes" label={t(lang, 'admin.reg.notes')} values={noteValues} lang={lang} multiline rows={3} /></div>
      <p class="text-xs text-ink-subtle">{t(lang, 'admin.reg.notesHint')}</p>
      <div class="block">
        <span class={lab}>{t(lang, 'admin.reg.poster')}</span>
        <input type="hidden" name="poster" value={v.poster} />
        {posterSrc && <img src={posterSrc} alt="" class="mb-2 h-24 w-40 rounded border border-border object-cover" loading="lazy" />}
        <input type="file" name="poster_file" accept={ALLOWED_IMAGE_TYPES.join(',')} class={tin} />
        {errors.poster && <span class={errorText}>{t(lang, errors.poster)}</span>}
        {posterSrc && (
          <label class="mt-2 flex min-h-11 items-center gap-2 text-sm">
            <input type="checkbox" name="remove_poster" value="1" /> {t(lang, 'admin.reg.posterRemove')}
          </label>
        )}
        <p class="mt-1 text-xs text-ink-subtle">{t(lang, 'admin.reg.posterHint')}</p>
      </div>
      <label class="flex min-h-11 items-center gap-2 text-sm">
        <input type="checkbox" name="active" checked={v.active} /> {t(lang, 'admin.reg.active')}
      </label>
      <div class="flex items-center gap-4">
        <button type="submit" class={btn}>{t(lang, 'admin.form.save')}</button>
        {editId && <a href="/admin/registration" class="text-sm text-primary hover:underline">{t(lang, 'admin.reg.cancelEdit')}</a>}
      </div>
    </section>
  </form>
  </details>
  </GatheringSurface>
</Admin>
