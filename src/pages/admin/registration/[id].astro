---
import GatheringSurface from '../../../components/gatherings/GatheringSurface.astro';
import { gatheringsCopy } from '../../../i18n/designGatherings';
import DateBadge from '../../../components/gatherings/DateBadge.astro';
import RegFormBuilder from '../../../components/regBuilder/RegFormBuilder';
import Overview from '../../../components/regAdmin/Overview.astro';
import Roster from '../../../components/regAdmin/Roster.astro';
import Drawer from '../../../components/regAdmin/Drawer.astro';
import ManualAdd from '../../../components/regAdmin/ManualAdd.astro';
import BulkEmail from '../../../components/regAdmin/BulkEmail.astro';
import Duplicates from '../../../components/regAdmin/Duplicates.astro';
import AccessPanel from '../../../components/regAdmin/AccessPanel.astro';
import LogisticsNav from '../../../components/regAdmin/logistics/LogisticsNav.astro';
import HousingTab from '../../../components/regAdmin/logistics/HousingTab.astro';
import TablesTab from '../../../components/regAdmin/logistics/TablesTab.astro';
import GroupsTab from '../../../components/regAdmin/logistics/GroupsTab.astro';
import en from '../../../i18n/en';

// One event's back office. The route class is `regEventStaff` (a per-event role holder reaches it without area
// access); the middleware has already checked the role for this event, and this page checks it AGAIN here, then
// each section and each POST action checks its own capability before reading or changing anything:
//   view    overview, roster, detail panel, duplicates, activity, exports, printing
//   manage  edits, decisions, cancels, manual add, notes, resend, bulk email           (per-event registrar or area access)
//   edit    event settings link, the form builder, per-event roles, event admins        (registration area only)
//   refund  refunds                                                                    (payment operations + manage)
// A person holding only 'view' is never sent the builder, the access panel or any form. The event of a registration
// opened with ?reg= is derived from the row and must be this page's event (a read leak otherwise).
// With the event-logistics module on, ?tab=housing|tables|groups shows that board instead of the roster, for the
// areas switched on for this event; its forms post here too and every action checks 'manage' (regLogisticsPage.ts).
import Admin from '../../../layouts/Admin.astro';
import { t } from '../../../lib/i18n';
import { getEventAdmin, listQuestions, listQuestionsAdmin, listTicketTypes, listTicketTypesAdmin } from '../../../lib/regDb';
import { canEditEvent, canRefund, eventOfRegistration, listEventRoles, regRoleAllows, requireRegRole, searchPeopleForAccess } from '../../../lib/regAccess';
import { eventOverview, getRegistrationAdmin, listDuplicates, listRoster } from '../../../lib/regAdmin';
import { parseRosterState, rosterOptions, rosterQuery, runBuilderSave, runRegAdminAction, safeBack, type ActionOutcome } from '../../../lib/regAdminPage';
import { failureKey, noticeKey, reasonKey } from '../../../lib/regAdminView';
import { submissionErrorKey } from '../../../lib/regViewHtml';
import { outboxCounts } from '../../../lib/regOutbox';
import { env } from 'cloudflare:workers';
import { listEventAdmins, listPeopleWithAccount } from '../../../lib/prayerDb';
import { tin, lab, card, btn, btnSecondary, td, noticeOk, noticeErr } from '../../../lib/adminUi';
import { SUPPORTED_LOCALES, localeMeta, type Locale } from '../../../lib/locales';
import { logisticsModuleEnabled } from '../../../lib/modules';
import { assignmentsForAttendees, getLogisticsSettings, logisticsOverview } from '../../../lib/regLogistics';
import { LOGISTICS_TABS, isLogisticsTab, loadLogisticsBoard, type LogisticsTab } from '../../../lib/regLogisticsPage';

const user = Astro.locals.user;
if (!user) return new Response(null, { status: 403 });
const lang: Locale = user.lang ?? 'en';
const db = Astro.locals.db;
// Event admins (prayer-approval console) only exist under the portal module.
const hasPortal = Astro.locals.modules.has('portal');
const isPg = Astro.locals.dbBackend !== 'd1';

const rawId = Astro.params.id ?? '';
if (!/^\d+$/.test(rawId)) return new Response(null, { status: 404 });
const eventId = Number(rawId);
const gate = await requireRegRole(db, user, eventId, 'view');
if (!gate.ok) return new Response(null, { status: gate.status });
const canManage = regRoleAllows(gate.role, 'manage');
const canEdit = canEditEvent(user);
const canRefundNow = canManage && canRefund(user);
const event = await getEventAdmin(db, eventId);
if (!event) return new Response(null, { status: 404 });
const defaultLocale = Astro.locals.locales.default;
// Event logistics: on for this campus, a real event, and the tabs of the areas switched on for it.
const logisticsOn = logisticsModuleEnabled(Astro.locals.modules) && event.is_template !== 1;
const lxSettings = logisticsOn ? await getLogisticsSettings(db, eventId) : null;
const lxTabs = lxSettings ? (Object.keys(LOGISTICS_TABS) as LogisticsTab[]).filter((tab) => lxSettings[LOGISTICS_TABS[tab]]) : [];

// ── POST ─────────────────────────────────────────────────────────────────────
let outcome: ActionOutcome | null = null;
let echo: Record<string, string> = {};
let echoStatuses: string[] = [];
if (Astro.request.method === 'POST') {
  // The form builder island saves with application/json (registration admins only).
  if ((Astro.request.headers.get('content-type') ?? '').includes('application/json')) {
    const result = await runBuilderSave({ db, user, eventId, defaultLocale, env: env as never }, await Astro.request.text());
    if ('denied' in result) return new Response(null, { status: result.denied });
    return new Response(JSON.stringify(result.saved.body), { status: result.saved.status, headers: { 'content-type': 'application/json' } });
  }
  let fd: FormData;
  try {
    fd = await Astro.request.formData();
  } catch {
    return new Response(null, { status: 400 });
  }
  outcome = await runRegAdminAction({ db, env: env as never, user, eventId, portal: hasPortal, defaultLocale, logistics: logisticsOn }, fd);
  if (outcome.kind === 'denied') return new Response(null, { status: outcome.status });
  if (outcome.kind === 'bad_request') return new Response(null, { status: 400 });
  const back = safeBack(String(fd.get('back') ?? ''));
  const go = (extra: Record<string, string | number | null | undefined>, hash = ''): Response => {
    const p = new URLSearchParams(back);
    for (const [k, v] of Object.entries(extra)) if (v !== null && v !== undefined) p.set(k, String(v));
    return Astro.redirect(`/admin/registration/${eventId}?${p.toString()}${hash}`, 303);
  };
  if (outcome.kind === 'ok') {
    const hash = outcome.notice.startsWith('role_') ? '#access' : outcome.reg ? '#reg-drawer' : outcome.notice === 'bulk_queued' ? '#email' : outcome.notice.startsWith('lx_') ? '#logistics' : '';
    return go({ reg: outcome.reg, notice: outcome.notice, ...(outcome.extra ?? {}) }, hash);
  }
  if (outcome.kind === 'conflict') return go({ reg: outcome.reg, notice: 'conflict' }, outcome.reg ? '#reg-drawer' : '');
  for (const [k, v] of fd.entries()) if (typeof v === 'string') echo[k] = v;
  echoStatuses = fd.getAll('audience_status').filter((v): v is string => typeof v === 'string');
  if (outcome.kind === 'confirm' || outcome.kind === 'reason') Astro.response.status = 409;
  else if (outcome.kind === 'invalid' || outcome.kind === 'failed') Astro.response.status = 422;
}

const isTemplate = event.is_template === 1;
const eventTitle = event.titles[lang] || event.titles[defaultLocale] || event.title_en || `#${eventId}`;
const base = `/admin/registration/${eventId}`;
const state = parseRosterState(Astro.url.searchParams);

// The registration opened in the detail panel (POST failures keep it open too).
const regParam = Astro.url.searchParams.get('reg') ?? (outcome && 'reg' in outcome && outcome.reg ? String(outcome.reg) : '');
let regId: number | null = /^\d+$/.test(regParam) ? Number(regParam) : null;
if (regId !== null && isTemplate) regId = null;
if (regId !== null && (await eventOfRegistration(db, regId)) !== eventId) return new Response(null, { status: 404 });

const tabParam = Astro.url.searchParams.get('tab') ?? '';
// A logistics tab reads only its own board (none of the roster's data).
const lxTab: LogisticsTab | null = isLogisticsTab(tabParam) && lxTabs.includes(tabParam) ? tabParam : null;
const board = lxTab ? await loadLogisticsBoard(db, eventId, lxTab, lang, Astro.url.searchParams) : null;
const [overview, roster, questions, tickets, detail, duplicates, counts] = isTemplate || lxTab
  ? [null, null, [], [], null, [], null]
  : await Promise.all([
      eventOverview(db, eventId, lang),
      listRoster(db, eventId, rosterOptions(state, lang)),
      listQuestions(db, lang, eventId),
      listTicketTypes(db, lang, eventId),
      regId !== null ? getRegistrationAdmin(db, regId, lang) : Promise.resolve(null),
      listDuplicates(db, eventId),
      canManage ? outboxCounts(db, eventId) : Promise.resolve(null),
    ]);

const lxOverview = !lxTab && lxTabs.length > 0 && overview ? await logisticsOverview(db, eventId) : null;
const lxAssignments = !lxTab && lxTabs.length > 0 && detail ? await assignmentsForAttendees(db, eventId, detail.summary.attendees.map((a) => a.id)) : null;

// Admin-only (registration area) data: the builder, per-event roles and event admins. Never loaded for a viewer or
// registrar, nor on a logistics tab (the builder and access panels show with the registrations view).
const showAdminPanels = canEdit && !lxTab;
const builderQuestions = showAdminPanels ? await listQuestionsAdmin(db, eventId) : [];
const builderTickets = showAdminPanels ? await listTicketTypesAdmin(db, eventId) : [];
const peopleSearch = (Astro.url.searchParams.get('people') ?? '').trim().slice(0, 100);
const accessRoles = showAdminPanels && !isTemplate ? await listEventRoles(db, eventId) : [];
const accessCandidates = showAdminPanels && !isTemplate && peopleSearch !== '' ? await searchPeopleForAccess(db, peopleSearch) : [];
let eventAdmins: Awaited<ReturnType<typeof listEventAdmins>> = [];
let adminCandidates: Awaited<ReturnType<typeof listPeopleWithAccount>> = [];
if (showAdminPanels && hasPortal && !isTemplate) {
  [eventAdmins, adminCandidates] = await Promise.all([listEventAdmins(db, eventId), listPeopleWithAccount(db)]);
}

const { enabled } = Astro.locals.locales;
const formLocales: Locale[] = [defaultLocale, ...enabled.filter((code) => code !== defaultLocale)].filter((code) => SUPPORTED_LOCALES.includes(code));
const builderLocales = formLocales.map((code) => ({ code, label: localeMeta(code).nativeName }));
// The island gets pre-translated copy (every admin.regBuilder.* key) and never touches the dictionaries.
const BUILDER_PREFIX = 'admin.regBuilder.';
const builderStrings = Object.fromEntries(
  Object.keys(en).filter((key) => key.startsWith(BUILDER_PREFIX)).map((key) => [key.slice(BUILDER_PREFIX.length), t(lang, key)]),
);
const copy = gatheringsCopy(lang);
const heading = t(lang, 'admin.reg.title');
const h2 = 'font-display text-heading-sm font-bold';

// Banners: a notice from a finished action, or the refusal of the last one.
const notice = noticeKey(Astro.url.searchParams.get('notice'));
// Logistics notices carry their counts in n= and m=.
const noticeVars = { n: Number(Astro.url.searchParams.get('n')) || 0, m: Number(Astro.url.searchParams.get('m')) || 0 };
const bulkQueued = Astro.url.searchParams.get('queued');
const bulkSent = Astro.url.searchParams.get('sent');
const legacyCancelled = Astro.url.searchParams.get('cancelled') === '1';
const saved = Astro.url.searchParams.get('saved') === '1';
const questionTypes = new Map(questions.map((q) => [q.id, q.type as string]));
const back = rosterQuery(state, { page: state.page });
const closeHref = `${base}${back ? `?${back}` : ''}#roster`;
const priced = (event.price_cents ?? 0) > 0 || tickets.some((ty) => ty.active === 1 && ty.price_cents > 0);
const openSection = (name: string) => tabParam === name || (outcome !== null && ((name === 'add' && echo.action === 'create') || (name === 'email' && /^bulk_/.test(echo.action ?? ''))));
---

<Admin title={`${eventTitle} · ${heading}`}>
  <GatheringSurface>
  <div class="gathering-heading">
    <div><p class="gathering-eyebrow">{copy.eyebrow}</p><h1>{eventTitle}{isTemplate && <span class="ml-3 align-middle rounded-full bg-surface-sunken px-3 py-1 text-xs font-medium text-ink-muted">{t(lang, 'admin.reg.templateBadge')}</span>}</h1><p class="gathering-intro">{isTemplate ? t(lang, 'admin.reg.templateIntroDetail') : copy.rosterIntro}</p></div>
    <div class="flex flex-wrap items-center gap-3">
      {canEdit && !isTemplate && <a href={`/admin/registration?edit=${eventId}`} class="text-sm text-primary hover:underline" data-testid="event-settings-link">{t(lang, 'admin.reg.bo.eventSettings')}</a>}
      {canEdit && <a href="/admin/registration" class="text-sm text-primary hover:underline">{t(lang, 'admin.reg.backToList')}</a>}
    </div>
  </div>

  {saved && <p class={`mt-4 ${noticeOk}`}>{t(lang, 'admin.form.saved')}</p>}
  {legacyCancelled && <p class={`mt-4 ${noticeOk}`}>{t(lang, 'admin.reg.cancelled')}</p>}
  {notice && (
    <p class={`mt-4 ${Astro.url.searchParams.get('notice') === 'conflict' ? noticeErr : noticeOk}`} role="status" data-testid="notice" data-notice={Astro.url.searchParams.get('notice')}>
      {t(lang, notice, noticeVars)}{Astro.url.searchParams.get('notice') === 'bulk_queued' && bulkQueued ? ` ${t(lang, 'admin.reg.bo.bulkQueuedDetail', { queued: Number(bulkQueued) || 0, sent: Number(bulkSent) || 0 })}` : ''}
    </p>
  )}
  {outcome?.kind === 'failed' && <p class={`mt-4 ${noticeErr}`} role="alert" data-testid="refusal" data-code={outcome.code}>{t(lang, failureKey(outcome.code))}</p>}
  {outcome?.kind === 'invalid' && (
    <div class={`mt-4 ${noticeErr}`} role="alert" data-testid="validation-errors">
      <p class="font-semibold">{t(lang, 'register.err.summary')}</p>
      <ul class="mt-1 list-disc pl-5">
        {outcome.errors.length === 0 ? <li>{t(lang, failureKey(outcome.code))}</li> : outcome.errors.map((e) => <li data-path={e.path}>{e.path} — {t(lang, submissionErrorKey(e, questionTypes))}</li>)}
      </ul>
    </div>
  )}
  {outcome?.kind === 'confirm' && !outcome.reasons && (
    <form method="post" class={`mt-4 ${noticeErr} flex flex-wrap items-center gap-3`} role="alert" data-testid="needs-confirm" data-reason={outcome.reason}>
      <p class="min-w-0 flex-1 text-sm">{t(lang, reasonKey(outcome.reason))}</p>
      {outcome.fields.map(([k, v]) => <input type="hidden" name={k} value={v} />)}
      <input type="hidden" name="confirm" value="1" />
      <button type="submit" class={btn}>{t(lang, 'admin.reg.bo.doItAnyway')}</button>
    </form>
  )}
  {outcome?.kind === 'confirm' && outcome.reasons && (
    <form method="post" class={`mt-4 ${noticeErr} space-y-3`} role="alert" data-testid="needs-confirm" data-reason={outcome.reason} data-reasons={outcome.reasons.join(' ')}>
      <ul class="list-disc space-y-1 pl-5 text-sm">{outcome.reasons.map((r) => <li data-confirm-reason={r}>{t(lang, reasonKey(r))}</li>)}</ul>
      {outcome.fields.map(([k, v]) => <input type="hidden" name={k} value={v} />)}
      <div class="flex flex-wrap items-center gap-3">
        <label class="flex min-h-11 items-center gap-2 text-sm font-semibold"><input type="checkbox" name="confirm" value="1" required /> {t(lang, 'admin.reg.lx.confirmCheckbox')}</label>
        <button type="submit" class={btn}>{t(lang, 'admin.reg.bo.doItAnyway')}</button>
      </div>
    </form>
  )}
  {outcome?.kind === 'reason' && (
    <form method="post" class={`mt-4 ${noticeErr} space-y-3`} role="alert" data-testid="needs-reason">
      <p class="text-sm">{t(lang, 'admin.reg.lx.reasonNeeded')}</p>
      {outcome.fields.map(([k, v]) => <input type="hidden" name={k} value={v} />)}
      <label class="block"><span class="mb-1 block text-sm font-semibold">{t(lang, 'admin.reg.lx.reason')}</span><input name="reason" required maxlength="200" class={tin} /></label>
      <button type="submit" class={btn}>{t(lang, 'admin.reg.lx.continue')}</button>
    </form>
  )}

  {!isTemplate && (overview || board) && (
    <>
    <div class="gathering-section-heading">
      <div class="gathering-actions"><DateBadge date={event.starts_at} locale={lang} /><p class="text-xs text-ink-muted">{event.location ?? ''}</p></div>
      <div class="flex flex-wrap gap-2" data-testid="export-links">
        <a href={`${base}/export.csv`} class={btnSecondary}>{t(lang, 'admin.reg.exportCsv')}</a>
        <a href={`${base}/export-people.csv`} class={btnSecondary}>{t(lang, 'admin.reg.bo.exportPeople')}</a>
        <a href={`${base}/badges`} class={btnSecondary} target="_blank" rel="noopener">{t(lang, 'admin.reg.badges.title')}</a>
        <a href={`${base}/sign-in-sheet`} class={btnSecondary} target="_blank" rel="noopener">{t(lang, 'admin.reg.sheet.title')}</a>
        <a href={`${base}/checkin`} class={btnSecondary}>{t(lang, 'admin.reg.bo.checkinDesk')}</a>
      </div>
    </div>

    {lxTabs.length > 0 && <LogisticsNav eventId={eventId} lang={lang} available={lxTabs} active={lxTab} />}
    {board && lxTab === 'housing' && <HousingTab board={board} lang={lang} eventId={eventId} canManage={canManage} />}
    {board && lxTab === 'tables' && <TablesTab board={board} lang={lang} eventId={eventId} canManage={canManage} preview={outcome?.kind === 'seat_preview' ? outcome : null} />}
    {board && lxTab === 'groups' && <GroupsTab board={board} lang={lang} eventId={eventId} canManage={canManage} />}
    </>
  )}

  {!isTemplate && overview && roster && (
    <>
    <Overview overview={overview} lang={lang} eventId={eventId} logistics={lxOverview} />

    {detail && (
      <Drawer
        detail={detail}
        questions={questions}
        types={tickets}
        lang={lang}
        eventId={eventId}
        back={back}
        closeHref={closeHref}
        canManage={canManage}
        canRefund={canRefundNow}
        isPg={isPg}
        requiresApproval={event.requires_approval === 1}
        assignments={lxAssignments}
      />
    )}
    {regId !== null && !detail && <p class={`mt-6 ${noticeErr}`}>{t(lang, 'register.manage.notAllowed')}</p>}

    <Roster page={roster} state={state} questions={questions} types={tickets} eventId={eventId} lang={lang} selected={regId} />

    <div class="mt-6">
      {canManage && <ManualAdd questions={questions} types={tickets} lang={lang} maxParty={event.max_party_size} paid={priced} open={openSection('add')} echo={echo.action === 'create' ? echo : {}} />}
      <Duplicates groups={duplicates} lang={lang} eventId={eventId} open={tabParam === 'duplicates'} />
      {canManage && counts && (
        <BulkEmail types={tickets} lang={lang} counts={counts} open={openSection('email')} echo={/^bulk_/.test(echo.action ?? '') ? echo : {}} echoStatuses={echoStatuses} preview={outcome?.kind === 'preview' ? outcome.count : null} />
      )}
    </div>
    </>
  )}

  {showAdminPanels && (
    <section class={isTemplate ? 'mt-6' : 'mt-10'} aria-labelledby="reg-form-heading" data-testid="form-builder">
      <h2 id="reg-form-heading" class={h2}>{t(lang, 'admin.regBuilder.title')}</h2>
      <p class="mt-1 max-w-2xl text-sm text-ink-muted">{t(lang, isTemplate ? 'admin.reg.templateBuilderIntro' : 'admin.regBuilder.intro')}</p>
      <RegFormBuilder
        client:only="react"
        questions={builderQuestions}
        tickets={builderTickets}
        locales={builderLocales}
        defaultLocale={defaultLocale}
        isD1={Astro.locals.dbBackend === 'd1'}
        strings={builderStrings}
      />
    </section>
  )}

  {showAdminPanels && !isTemplate && <AccessPanel roles={accessRoles} candidates={accessCandidates} lang={lang} search={peopleSearch} eventId={eventId} />}

  {
    showAdminPanels && hasPortal && !isTemplate && (
      <section class={`mt-10 ${card} max-w-2xl`}>
        <h2 class="font-semibold">{t(lang, 'admin.reg.eventAdmins.title')}</h2>
        <p class="mt-1 text-sm text-ink-muted">{t(lang, 'admin.reg.eventAdmins.hint')}</p>
        {eventAdmins.length === 0 ? (
          <p class="mt-3 text-sm text-ink-muted">{t(lang, 'admin.reg.eventAdmins.empty')}</p>
        ) : (
          <div class="mt-4 overflow-x-auto rounded-xl border border-border">
            <table class="w-full border-collapse text-sm">
              <tbody>
                {eventAdmins.map((a) => (
                  <tr class="border-t border-border first:border-t-0">
                    <td class={td}>{a.display_name}</td>
                    <td class={`${td} text-right whitespace-nowrap`}>
                      <form method="post" class="inline">
                        <input type="hidden" name="action" value="removeEventAdmin" />
                        <input type="hidden" name="person_id" value={a.person_id} />
                        <button type="submit" class="text-xs font-semibold text-danger hover:underline">
                          {t(lang, 'admin.reg.eventAdmins.remove')}
                        </button>
                      </form>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        {adminCandidates.length > 0 && (
          <form method="post" class="mt-4 flex flex-wrap items-end gap-3">
            <input type="hidden" name="action" value="addEventAdmin" />
            <label class="flex-1 min-w-48">
              <span class={lab}>{t(lang, 'admin.reg.eventAdmins.selectPerson')}</span>
              <select name="person_id" class={tin}>
                {adminCandidates.map((p) => (
                  <option value={p.id}>{p.display_name}</option>
                ))}
              </select>
            </label>
            <button type="submit" class={btnSecondary}>{t(lang, 'admin.reg.eventAdmins.add')}</button>
          </form>
        )}
      </section>
    )
  }
  {showAdminPanels && !hasPortal && !isTemplate && <p class="mt-10 max-w-2xl text-sm text-ink-muted">{t(lang, 'admin.reg.eventAdmins.portalOff')}</p>}
  </GatheringSurface>
</Admin>
