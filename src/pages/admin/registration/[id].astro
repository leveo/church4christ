---
import GatheringSurface from '../../../components/gatherings/GatheringSurface.astro';
import { gatheringsCopy } from '../../../i18n/designGatherings';
import AvatarInitials from '../../../components/AvatarInitials.astro';
import DateBadge from '../../../components/gatherings/DateBadge.astro';
import RegFormBuilder from '../../../components/regBuilder/RegFormBuilder';
import en from '../../../i18n/en';

// One event's registration form builder + registration roster (console class — re-checks
// editor∪admin). The form builder is a client:only React island (the same pattern as the page
// builder): GET mounts it with the stored questions and ticket types as JSON; the island saves with
// a same-page JSON POST (application/json) handled by saveFormRequest (validated in one batch,
// field-path errors come back for inline display; the CSRF middleware checks Origin on every
// non-GET). The roster lists each registration with its answers in per-question columns, an admin
// cancel button, and a CSV link. A template (is_template) opens the same builder but has no roster.
import Admin from '../../../layouts/Admin.astro';
import { t } from '../../../lib/i18n';
import { getEventAdmin, listQuestions, listQuestionsAdmin, listRegistrations, listTicketTypesAdmin } from '../../../lib/regDb';
import { saveFormRequest } from '../../../lib/regFormSave';
import { cancelAndNotify, type RegNotifyEnv } from '../../../lib/regNotify';
import { env } from 'cloudflare:workers';
import { listEventAdmins, addEventAdmin, removeEventAdmin, listPeopleWithAccount } from '../../../lib/prayerDb';
import { formatCents } from '../../../lib/money';
import { tin, lab, card, btnSecondary, rowBtn, th, td, noticeOk } from '../../../lib/adminUi';
import { SUPPORTED_LOCALES, localeMeta, type Locale } from '../../../lib/locales';
import { hasAreaAccess } from '../../../lib/adminAreas';

const user = Astro.locals.user;
if (!user || !(user.isEditor || hasAreaAccess(user, 'registration'))) return new Response(null, { status: 403 });
const lang: Locale = user.lang ?? 'en';
const db = Astro.locals.db;
// Event admins (prayer-approval console) only exist under the portal module.
const hasPortal = Astro.locals.modules.has('portal');

const rawId = Astro.params.id ?? '';
if (!/^\d+$/.test(rawId)) return new Response(null, { status: 404 });
const eventId = Number(rawId);
const event = await getEventAdmin(db, eventId);
if (!event) return new Response(null, { status: 404 });

if (Astro.request.method === 'POST') {
  // The form builder island saves with application/json.
  if ((Astro.request.headers.get('content-type') ?? '').includes('application/json')) {
    const saved = await saveFormRequest(db, eventId, await Astro.request.text(), {
      backend: Astro.locals.dbBackend,
      defaultLocale: Astro.locals.locales.default,
    });
    return new Response(JSON.stringify(saved.body), { status: saved.status, headers: { 'content-type': 'application/json' } });
  }
  const fd = await Astro.request.formData();
  const action = String(fd.get('action') ?? '');
  if (action === 'cancel') {
    const rid = String(fd.get('registration_id') ?? '');
    // Cancelling frees seats: waitlisted registrations move up (free events), and both they
    // and the cancelled registrant are emailed. Awaited (the db client is drained after the
    // redirect) and never throws.
    if (/^\d+$/.test(rid)) await cancelAndNotify(env as unknown as RegNotifyEnv, db, Number(rid));
    return Astro.redirect(`/admin/registration/${eventId}?cancelled=1`, 303);
  }
  if (hasPortal && (action === 'addEventAdmin' || action === 'removeEventAdmin')) {
    const pid = String(fd.get('person_id') ?? '');
    if (/^\d+$/.test(pid)) {
      if (action === 'addEventAdmin') await addEventAdmin(db, eventId, Number(pid));
      else await removeEventAdmin(db, eventId, Number(pid));
    }
    return Astro.redirect(`/admin/registration/${eventId}?saved=1`, 303);
  }
}

const isTemplate = event.is_template === 1;
const [questions, tickets] = await Promise.all([listQuestionsAdmin(db, eventId), listTicketTypesAdmin(db, eventId)]);
// A template is only ever copied: it has no registrations, roster or event admins.
const roster = isTemplate ? [] : await listRegistrations(db, lang, eventId);
// Roster column headers use the same localized labels the answers carry (so each
// answer lines up with its column even when two questions share a label).
const rosterQuestions = isTemplate ? [] : (await listQuestions(db, lang, eventId)).filter((q) => q.scope === 'registration' && q.type !== 'section');
const saved = Astro.url.searchParams.get('saved') === '1';
const cancelled = Astro.url.searchParams.get('cancelled') === '1';

let eventAdmins: Awaited<ReturnType<typeof listEventAdmins>> = [];
let adminCandidates: Awaited<ReturnType<typeof listPeopleWithAccount>> = [];
if (hasPortal && !isTemplate) {
  [eventAdmins, adminCandidates] = await Promise.all([listEventAdmins(db, eventId), listPeopleWithAccount(db)]);
}

// The event's display title + the localized question label (for roster headers
// and aligning each answer to its column — the CSV keys by id, the HTML by label).
const defaultLocale = Astro.locals.locales.default;
const eventTitle = event.titles[lang] || event.titles[defaultLocale] || event.title_en || `#${eventId}`;
// The form is editable in every enabled site language (default first, required); the island
// folds the others. A disabled language is left out of the payload, which the writer reads as
// "leave that language's text as it is".
const { enabled } = Astro.locals.locales;
const formLocales: Locale[] = [defaultLocale, ...enabled.filter((code) => code !== defaultLocale)].filter((code) => SUPPORTED_LOCALES.includes(code));
const builderLocales = formLocales.map((code) => ({ code, label: localeMeta(code).nativeName }));
// The island gets pre-translated copy (every admin.regBuilder.* key) and never touches the dictionaries.
const BUILDER_PREFIX = 'admin.regBuilder.';
const builderStrings = Object.fromEntries(
  Object.keys(en).filter((key) => key.startsWith(BUILDER_PREFIX)).map((key) => [key.slice(BUILDER_PREFIX.length), t(lang, key)]),
);
const copy = gatheringsCopy(lang);
const heading = t(lang, 'admin.reg.title');
const h2 = 'font-display text-heading-sm font-bold';
---

<Admin title={`${eventTitle} · ${heading}`}>
  <GatheringSurface>
  <div class="gathering-heading">
    <div><p class="gathering-eyebrow">{copy.eyebrow}</p><h1>{eventTitle}{isTemplate && <span class="ml-3 align-middle rounded-full bg-surface-sunken px-3 py-1 text-xs font-medium text-ink-muted">{t(lang, 'admin.reg.templateBadge')}</span>}</h1><p class="gathering-intro">{isTemplate ? t(lang, 'admin.reg.templateIntroDetail') : copy.rosterIntro}</p></div>
    <a href="/admin/registration" class="text-sm text-primary hover:underline">{t(lang, 'admin.reg.backToList')}</a>
  </div>
  {saved && <p class={`mt-4 ${noticeOk}`}>{t(lang, 'admin.form.saved')}</p>}
  {cancelled && <p class={`mt-4 ${noticeOk}`}>{t(lang, 'admin.reg.cancelled')}</p>}

  {!isTemplate && (
  <>
  <div class="gathering-section-heading">
    <div class="gathering-actions"><DateBadge date={event.starts_at} locale={lang} /><div><h2 class={h2}>{t(lang, 'admin.reg.registrations')}</h2><p class="mt-1 text-xs text-ink-muted">{roster.length} {copy.recordsShown}</p></div></div>
    <a href={`/admin/registration/${eventId}/export.csv`} class={btnSecondary}>{t(lang, 'admin.reg.exportCsv')}</a>
  </div>
  <div class="gathering-table-wrap mt-4">
    <table class="gathering-table">
      <thead class="bg-surface-sunken">
        <tr>
          <th class={th}>{t(lang, 'admin.reg.confirmation')}</th>
          <th class={th}>{t(lang, 'admin.reg.name')}</th>
          <th class={th}>{t(lang, 'admin.reg.email')}</th>
          <th class={th}>{t(lang, 'admin.reg.partySize')}</th>
          <th class={th}>{t(lang, 'admin.reg.people')}</th>
          <th class={th}>{t(lang, 'admin.reg.phone')}</th>
          <th class={th}>{t(lang, 'admin.reg.status')}</th>
          <th class={th}>{t(lang, 'admin.reg.amount')}</th>
          <th class={th}>{t(lang, 'admin.reg.registered')}</th>
          {rosterQuestions.map((q) => <th class={th}>{q.label}</th>)}
          <th class={th}>{t(lang, 'admin.reg.actions')}</th>
        </tr>
      </thead>
      <tbody>
        {
          roster.length === 0 ? (
            <tr>
              <td class={`${td} text-ink-muted`} colspan={10 + rosterQuestions.length}>
                {t(lang, 'admin.reg.rosterEmpty')}
              </td>
            </tr>
          ) : (
            roster.map((r) => {
              const byLabel = new Map(r.answers.map((a) => [a.label, a.value]));
              return (
                <tr class="border-t border-border align-top">
                  <td class={`${td} font-medium tabular-nums`} data-confirmation>{r.confirmation_no ?? '—'}</td>
                  <td class={`${td} font-medium`}><div class="gathering-identity"><AvatarInitials name={r.name} sizeClass="h-8 w-8 text-xs" />{r.name}</div></td>
                  <td class={`${td} break-all`}>{r.email}</td>
                  <td class={`${td} tabular-nums`}>{r.party_size}</td>
                  <td class={td} data-people>
                    {r.attendees.length > 1 || r.attendees.some((p) => p.ticket || p.answers.length > 0 || p.name !== r.name) ? (
                      <ul class="space-y-1">
                        {r.attendees.map((p) => (
                          <li>
                            <span class="font-medium">{p.name}</span>{p.ticket && <span class="text-ink-muted" data-ticket> · {p.ticket}</span>}
                            {p.answers.length > 0 && <p class="text-xs text-ink-muted" data-person-answers>{p.answers.map((a) => `${a.label}: ${a.value}`).join('; ')}</p>}
                          </li>
                        ))}
                      </ul>
                    ) : ''}
                  </td>
                  <td class={`${td} whitespace-nowrap`}>{r.phone ?? ''}</td>
                  <td class={td}><span class="gathering-roster-status" data-status={r.status}>{t(lang, `admin.reg.status.${r.status}`)}</span></td>
                  <td class={`${td} tabular-nums`}>{formatCents(r.amount_cents, event.currency)}</td>
                  <td class={`${td} text-ink-muted tabular-nums`}>{r.created_at.slice(0, 16)}</td>
                  {rosterQuestions.map((q) => (
                    <td class={td}>{byLabel.get(q.label) ?? ''}</td>
                  ))}
                  <td class={td}>
                    <form method="post" onsubmit={`return confirm(${JSON.stringify(t(lang, 'admin.reg.cancelConfirm'))})`}>
                      <input type="hidden" name="action" value="cancel" />
                      <input type="hidden" name="registration_id" value={r.id} />
                      <button type="submit" class={rowBtn} disabled={r.status === 'cancelled' || r.status === 'declined'}>
                        {t(lang, 'admin.reg.cancel')}
                      </button>
                    </form>
                  </td>
                </tr>
              );
            })
          )
        }
      </tbody>
    </table>
  </div>
  </>
  )}

  <section class={isTemplate ? 'mt-6' : 'mt-10'} aria-labelledby="reg-form-heading">
    <h2 id="reg-form-heading" class={h2}>{t(lang, 'admin.regBuilder.title')}</h2>
    <p class="mt-1 max-w-2xl text-sm text-ink-muted">{t(lang, isTemplate ? 'admin.reg.templateBuilderIntro' : 'admin.regBuilder.intro')}</p>
    <RegFormBuilder
      client:only="react"
      questions={questions}
      tickets={tickets}
      locales={builderLocales}
      defaultLocale={defaultLocale}
      isD1={Astro.locals.dbBackend === 'd1'}
      strings={builderStrings}
    />
  </section>
  {
    hasPortal && !isTemplate && (
      <section class={`mt-10 ${card} max-w-2xl`}>
        <h2 class="font-semibold">{t(lang, 'admin.reg.eventAdmins.title')}</h2>
        <p class="mt-1 text-sm text-ink-muted">{t(lang, 'admin.reg.eventAdmins.hint')}</p>
        {eventAdmins.length === 0 ? (
          <p class="mt-3 text-sm text-ink-muted">{t(lang, 'admin.reg.eventAdmins.empty')}</p>
        ) : (
          <div class="mt-4 overflow-x-auto rounded-xl border border-border">
            <table class="w-full border-collapse text-sm">
              <tbody>
                {eventAdmins.map((a) => (
                  <tr class="border-t border-border first:border-t-0">
                    <td class={td}>{a.display_name}</td>
                    <td class={`${td} text-right whitespace-nowrap`}>
                      <form method="post" class="inline">
                        <input type="hidden" name="action" value="removeEventAdmin" />
                        <input type="hidden" name="person_id" value={a.person_id} />
                        <button type="submit" class="text-xs font-semibold text-danger hover:underline">
                          {t(lang, 'admin.reg.eventAdmins.remove')}
                        </button>
                      </form>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        {adminCandidates.length > 0 && (
          <form method="post" class="mt-4 flex flex-wrap items-end gap-3">
            <input type="hidden" name="action" value="addEventAdmin" />
            <label class="flex-1 min-w-48">
              <span class={lab}>{t(lang, 'admin.reg.eventAdmins.selectPerson')}</span>
              <select name="person_id" class={tin}>
                {adminCandidates.map((p) => (
                  <option value={p.id}>{p.display_name}</option>
                ))}
              </select>
            </label>
            <button type="submit" class={btnSecondary}>{t(lang, 'admin.reg.eventAdmins.add')}</button>
          </form>
        )}
      </section>
    )
  }
  {!hasPortal && !isTemplate && <p class="mt-10 max-w-2xl text-sm text-ink-muted">{t(lang, 'admin.reg.eventAdmins.portalOff')}</p>}
  </GatheringSurface>
</Admin>
