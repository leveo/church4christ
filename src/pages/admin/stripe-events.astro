---
import Admin from '../../layouts/Admin.astro';
import FinanceSurface from '../../components/finance/FinanceSurface.astro';
import FinanceHeader from '../../components/finance/FinanceHeader.astro';
import { financeCopy } from '../../i18n/designFinance';
import { env } from 'cloudflare:workers';
import { t } from '../../lib/i18n';
import { paymentOperationsEnabled } from '../../lib/modules';
import type { Locale } from '../../lib/locales';
import type { DbEnv } from '../../lib/dbProvider';
import { stripeAdminActionAllowed, type StripeEnv } from '../../lib/stripe';
import {
  listStripeWebhookEvents,
  stripeWebhookReplayAvailability,
  type StripeWebhookStatus,
} from '../../lib/stripeWebhookInbox';
import {
  dismissStripeWebhookEvent,
  replayStripeWebhookEvent,
} from '../../lib/stripeWebhookProcessor';
import {
  listRegistrationCheckoutRequests,
  type RegistrationCheckoutAdminRow,
} from '../../lib/stripeCheckoutRequests';
import {
  attachVerifiedCheckoutSession,
  cancelPendingCheckoutRequest,
  reconcileCheckoutRequestNow,
} from '../../lib/stripeCheckoutRecovery';
import { badge, badgeActive, badgeInactive, badgeScheduled, btnDanger, btnSecondary, lab, noticeErr, noticeOk, tin } from '../../lib/adminUi';

const user = Astro.locals.user;
if (!user || !(user.isAdmin || user.finance === 1)) return new Response(null, { status: 403 });
if (!paymentOperationsEnabled(Astro.locals.modules)) return new Response(null, { status: 404 });
const lang: Locale = user.lang ?? 'en';
const heading = t(lang, 'admin.stripe.title');
const db = Astro.locals.db;
const stripeEnv = env as unknown as StripeEnv & DbEnv;
const PAGE_SIZE = 25;
const EVENT_STATUSES = ['pending', 'processing', 'processed', 'ignored', 'failed', 'dismissed'] as const;
const REQUEST_STATES = ['creating', 'attached', 'manual_review'] as const;
const numberParam = (value: string | null) => value && /^\d+$/.test(value) ? Math.min(400, Math.max(1, Number(value))) : 1;
const eventStatusRaw = Astro.url.searchParams.get('eventStatus') ?? '';
const eventStatus = EVENT_STATUSES.find((status) => status === eventStatusRaw);
const requestStateRaw = Astro.url.searchParams.get('requestState') ?? '';
const requestState = REQUEST_STATES.find((state) => state === requestStateRaw);
const eventPage = numberParam(Astro.url.searchParams.get('eventPage'));
const requestPage = numberParam(Astro.url.searchParams.get('requestPage'));
const testMode = t(lang, 'admin.stripe.testMode');
const copy = financeCopy(lang);

if (Astro.request.method === 'POST') {
  // Middleware enforces same-origin/CSRF first; repeat finance + module
  // authorization here before invoking any audited service-layer mutation.
  if (!(user.isAdmin || user.finance === 1) || !paymentOperationsEnabled(Astro.locals.modules)) {
    return new Response(null, { status: 403 });
  }
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  if (!stripeAdminActionAllowed(action, stripeEnv)) {
    return Astro.redirect('/admin/stripe-events?result=error', 303);
  }
  let success = false;
  try {
    if (action === 'replay') {
      const result = await replayStripeWebhookEvent(String(form.get('eventId') ?? ''), user.id, { env: stripeEnv });
      success = !['failed', 'not_claimed'].includes(result.state);
    } else if (action === 'dismiss') {
      const eventId = String(form.get('eventId') ?? '');
      if (String(form.get('confirmation') ?? '') === `dismiss-${eventId}`) {
        success = (await dismissStripeWebhookEvent(eventId, user.id, { env: stripeEnv })).state === 'dismissed';
      }
    } else if (action === 'reconcile' && Astro.locals.modules.has('registration')) {
      success = (await reconcileCheckoutRequestNow({ env: stripeEnv }, String(form.get('requestId') ?? ''), user.id)).state !== 'not_claimed';
    } else if (action === 'attach' && Astro.locals.modules.has('registration')) {
      success = (await attachVerifiedCheckoutSession(
        { env: stripeEnv },
        String(form.get('requestId') ?? ''),
        String(form.get('sessionId') ?? ''),
        user.id,
      )).state === 'applied';
    } else if (action === 'cancel' && Astro.locals.modules.has('registration')) {
      success = (await cancelPendingCheckoutRequest(
        { env: stripeEnv },
        String(form.get('requestId') ?? ''),
        user.id,
        String(form.get('confirmation') ?? ''),
      )).state === 'applied';
    }
  } catch {
    success = false;
  }
  return Astro.redirect(`/admin/stripe-events?result=${success ? 'ok' : 'error'}`, 303);
}

const [events, requests] = await Promise.all([
  listStripeWebhookEvents(db, {
    status: eventStatus,
    limit: PAGE_SIZE,
    offset: (eventPage - 1) * PAGE_SIZE,
  }),
  Astro.locals.modules.has('registration')
    ? listRegistrationCheckoutRequests(db, {
        state: requestState,
        limit: PAGE_SIZE,
        offset: (requestPage - 1) * PAGE_SIZE,
      })
    : Promise.resolve([] as RegistrationCheckoutAdminRow[]),
]);
const result = Astro.url.searchParams.get('result');
const renderedAt = Date.now();
const ageDays = (value: string) => {
  const parsed = new Date(/[zZ]|[+-]\d\d:\d\d$/.test(value) ? value : `${value.replace(' ', 'T')}Z`).getTime();
  return Number.isFinite(parsed) ? Math.max(0, Math.floor((renderedAt - parsed) / (24 * 60 * 60_000))) : 0;
};
const statusClass = (status: StripeWebhookStatus) => status === 'processed'
  ? badgeActive
  : status === 'pending' || status === 'processing'
    ? badgeScheduled
    : badgeInactive;
const queryHref = (overrides: Record<string, string | number | undefined>) => {
  const query = new URLSearchParams();
  if (eventStatus) query.set('eventStatus', eventStatus);
  if (requestState) query.set('requestState', requestState);
  if (eventPage > 1) query.set('eventPage', String(eventPage));
  if (requestPage > 1) query.set('requestPage', String(requestPage));
  for (const [key, value] of Object.entries(overrides)) {
    if (value === undefined || value === '') query.delete(key); else query.set(key, String(value));
  }
  const rendered = query.toString();
  return `/admin/stripe-events${rendered ? `?${rendered}` : ''}`;
};
---

<Admin title={heading}>
<FinanceSurface>
  <FinanceHeader locale={lang} title={heading} description={copy.operationsIntro}>
    <strong class="finance-test-badge">{testMode}</strong>
    {Astro.locals.modules.has('giving') && <a href="/admin/giving/reconcile" class="text-primary hover:underline">{t(lang, 'admin.giving.reconcile')}</a>}
  </FinanceHeader>
  <p class="finance-scope">{t(lang, 'admin.stripe.rawHidden')}</p>
  {result === 'ok' && <p class={`mt-4 ${noticeOk}`} role="status">{testMode}: {t(lang, 'admin.stripe.resultSuccess')}</p>}
  {result === 'error' && <p class={`mt-4 ${noticeErr}`} role="alert">{testMode}: {t(lang, 'admin.stripe.resultError')}</p>}
  <nav class="finance-operations-nav" aria-label={heading}>
    <a href="#finance-events">{t(lang, 'admin.stripe.events')} <span class="ml-2 tabular-nums">{events.length}</span></a>
    {Astro.locals.modules.has('registration') && <a href="#finance-requests">{t(lang, 'admin.stripe.requests')} <span class="ml-2 tabular-nums">{requests.length}</span></a>}
  </nav>
  <section id="finance-events" class="finance-operations-section" aria-labelledby="finance-events-heading">
    <h2 id="finance-events-heading">{t(lang, 'admin.stripe.events')}</h2>
    <p class="finance-scope">{t(lang, 'admin.stripe.replayHelp')}</p>
    <form method="get" class="finance-filter mt-4">
      <label>
        <span class={lab}>{t(lang, 'admin.stripe.status')}</span>
        <select name="eventStatus" class={tin}>
          <option value="">{t(lang, 'admin.stripe.allStatuses')}</option>
          {EVENT_STATUSES.map((status) => <option value={status} selected={eventStatus === status}>{t(lang, `admin.stripe.status.${status}`)}</option>)}
        </select>
      </label>
      {requestState && <input type="hidden" name="requestState" value={requestState} />}
      <button type="submit" class={btnSecondary}>{t(lang, 'admin.stripe.filter')}</button>
    </form>
    <p class="finance-scope">{copy.eventsShown}: {events.length}</p>
    <div class="finance-investigation-list">
      {events.length === 0 ? <p class="finance-empty">{t(lang, 'admin.stripe.emptyEvents')}</p> : events.map((row) => {
        const replay = stripeWebhookReplayAvailability(row, new Date());
        return <article class="finance-investigation">
          <header>
            <div><h3>{row.eventType}</h3><p class="finance-investigation-code"><span>{t(lang, 'admin.stripe.eventId')}: </span>{row.eventId}</p></div>
            <div class="flex flex-wrap items-center gap-2"><span class={`${badge} ${statusClass(row.status)}`}>{t(lang, `admin.stripe.status.${row.status}`)}</span><span class="text-xs text-ink-muted">{testMode}</span></div>
          </header>
          <div class="finance-investigation-body">
            <dl aria-label={copy.eventDetails}>
              <div><dt>{t(lang, 'admin.stripe.outcome')}</dt><dd>{row.outcome ?? '—'}</dd></div>
              <div><dt>{t(lang, 'admin.stripe.attempts')}</dt><dd class="tabular-nums">{row.attemptCount}</dd></div>
              <div><dt>{t(lang, 'admin.stripe.updatedAt')}</dt><dd>{row.updatedAt}</dd></div>
              <div><dt>{t(lang, 'admin.stripe.completedAt')}</dt><dd>{row.completedAt ?? '—'}<span class="block mt-1 text-xs text-ink-muted">{t(lang, 'admin.stripe.ageDays', { count: ageDays(row.completedAt ?? row.receivedAt) })}</span></dd></div>
              <div class="finance-investigation-error"><dt>{t(lang, 'admin.stripe.lastError')}</dt><dd>{row.lastError ?? '—'}</dd></div>
            </dl>
            <details class="finance-investigation-actions" open>
              <summary>{copy.recovery}</summary>
              {replay === 'warning' && <p class="mb-3 text-xs text-danger">{t(lang, 'admin.stripe.replayWarning')}</p>}
              {replay === 'expired' && <p class="mb-3 text-xs text-ink-muted">{t(lang, 'admin.stripe.replayExpired')}</p>}
              {(replay === 'available' || replay === 'warning') && <form method="post">
                <input type="hidden" name="action" value="replay" /><input type="hidden" name="eventId" value={row.eventId} />
                <button class={btnSecondary}>{testMode} · {t(lang, 'admin.stripe.replay')}</button>
              </form>}
              {row.status === 'failed' && <form method="post" class="space-y-2">
                <input type="hidden" name="action" value="dismiss" /><input type="hidden" name="eventId" value={row.eventId} />
                <label class="block"><span class={lab}>{t(lang, 'admin.stripe.confirmDismiss')}</span><code class="block mb-2 text-xs break-all">dismiss-{row.eventId}</code><input name="confirmation" required placeholder={`dismiss-${row.eventId}`} class={tin} /></label>
                <button class={btnDanger}>{testMode} · {t(lang, 'admin.stripe.dismiss')}</button>
              </form>}
              {replay !== 'available' && replay !== 'warning' && replay !== 'expired' && row.status !== 'failed' && <p class="finance-scope">{copy.noRecovery}</p>}
            </details>
          </div>
        </article>;
      })}
    </div>
    <nav class="finance-operations-nav" aria-label={copy.eventsPage}>
      {eventPage > 1 && <a class="text-primary hover:underline" href={queryHref({ eventPage: eventPage - 1 })}>{t(lang, 'admin.stripe.previous')}</a>}
      {events.length === PAGE_SIZE && <a class="text-primary hover:underline" href={queryHref({ eventPage: eventPage + 1 })}>{t(lang, 'admin.stripe.next')}</a>}
    </nav>
  </section>
  {Astro.locals.modules.has('registration') && <section id="finance-requests" class="finance-operations-section" aria-labelledby="finance-requests-heading">
    <h2 id="finance-requests-heading">{t(lang, 'admin.stripe.requests')}</h2>
    <form method="get" class="finance-filter mt-4">
      <label><span class={lab}>{t(lang, 'admin.stripe.status')}</span><select name="requestState" class={tin}>
        <option value="">{t(lang, 'admin.stripe.allRequestStates')}</option>
        {REQUEST_STATES.map((state) => <option value={state} selected={requestState === state}>{t(lang, `admin.stripe.request.${state}`)}</option>)}
      </select></label>
      {eventStatus && <input type="hidden" name="eventStatus" value={eventStatus} />}
      <button type="submit" class={btnSecondary}>{t(lang, 'admin.stripe.filter')}</button>
    </form>
    <p class="finance-scope">{copy.requestsShown}: {requests.length}</p>
    <div class="finance-investigation-list">
      {requests.length === 0 ? <p class="finance-empty">{t(lang, 'admin.stripe.emptyRequests')}</p> : requests.map((row) => <article class="finance-investigation">
        <header>
          <div><h3>{t(lang, 'admin.stripe.registrationId')} {row.registrationId}</h3><p class="finance-investigation-code"><span>{t(lang, 'admin.stripe.requestId')}: </span>{row.requestId}</p></div>
          <div class="flex flex-wrap items-center gap-2"><span class={`${badge} ${badgeScheduled}`}>{t(lang, `admin.stripe.request.${row.state}`)}</span><span class="text-xs text-ink-muted">{testMode}</span></div>
        </header>
        <div class="finance-investigation-body">
          <dl aria-label={copy.requestDetails}>
            <div><dt>{t(lang, 'admin.stripe.attempts')}</dt><dd class="tabular-nums">{row.reconcileAttempts}</dd></div>
            <div><dt>{t(lang, 'admin.stripe.updatedAt')}</dt><dd>{row.updatedAt}</dd></div>
            <div class="finance-investigation-error"><dt>{t(lang, 'admin.stripe.lastError')}</dt><dd>{row.lastError ?? '—'}</dd></div>
          </dl>
          <details class="finance-investigation-actions" open>
            <summary>{copy.recovery}</summary>
            {(row.state === 'creating' || row.state === 'attached') && <form method="post"><input type="hidden" name="action" value="reconcile" /><input type="hidden" name="requestId" value={row.requestId} /><button class={btnSecondary}>{testMode} · {t(lang, 'admin.stripe.reconcile')}</button></form>}
            {row.state === 'manual_review' && <form method="post" class="space-y-2"><input type="hidden" name="action" value="attach" /><input type="hidden" name="requestId" value={row.requestId} /><label class="block"><span class={lab}>{t(lang, 'admin.stripe.sessionId')}</span><input name="sessionId" required pattern="cs_test_[A-Za-z0-9_]+" class={tin} /></label><button class={btnSecondary}>{testMode} · {t(lang, 'admin.stripe.attach')}</button></form>}
            {row.state === 'manual_review' && <form method="post" class="space-y-2"><input type="hidden" name="action" value="cancel" /><input type="hidden" name="requestId" value={row.requestId} /><label class="block"><span class={lab}>{t(lang, 'admin.stripe.confirmCancel', { id: row.registrationId })}</span><code class="block mb-2 text-xs break-all">cancel-registration-{row.registrationId}</code><input name="confirmation" required placeholder={`cancel-registration-${row.registrationId}`} class={tin} /></label><button class={btnDanger}>{testMode} · {t(lang, 'admin.stripe.cancel')}</button></form>}
          </details>
        </div>
      </article>)}
    </div>
    <nav class="finance-operations-nav" aria-label={copy.requestsPage}>
      {requestPage > 1 && <a class="text-primary hover:underline" href={queryHref({ requestPage: requestPage - 1 })}>{t(lang, 'admin.stripe.previous')}</a>}
      {requests.length === PAGE_SIZE && <a class="text-primary hover:underline" href={queryHref({ requestPage: requestPage + 1 })}>{t(lang, 'admin.stripe.next')}</a>}
    </nav>
  </section>}
</FinanceSurface>
</Admin>
