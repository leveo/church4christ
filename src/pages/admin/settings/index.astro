---
// Site settings (adminOnly — the route policy covers /admin/settings; this page
// re-checks isSuperAdmin and 403s anyone else — super admin only, grant
// management lives here). A grouped form over the site.* / theme.*
// / locale.* settings: identity (per-locale name/tagline/service times), contact,
// links, and appearance (theme radio cards with generated swatches, default color
// mode, default language, homepage hero image). Save → parseSettingsForm
// (fixed allowlist, URL/email/enum validated) → optional hero upload →
// setSettings batch → clearThemeCache() so a theme change takes effect on the
// very next render → 303 ?saved=1. The Admin shell reads the active theme, so
// this page (and the whole site) restyles immediately after a save.
import MemberPageHeader from '../../../components/ui/MemberPageHeader.astro';
import DesignImage from '../../../components/ui/DesignImage.astro';
import { operationsCopy } from '../../../i18n/designOperations';
import Admin from '../../../layouts/Admin.astro';
import { env } from 'cloudflare:workers';
import { t } from '../../../lib/i18n';
import { getSettings, setSettings } from '../../../lib/settings';
import { parseSettingsForm } from '../../../lib/validate';
import { clearThemeCache } from '../../../lib/theme';
import {
  MODULE_GROUPS,
  MODULE_KEYS,
  MODULES,
  SCHEDULABLE_MODULE_KEYS,
  clearModuleCache,
  clearModuleWindowCache,
  getModuleWindows,
  moduleBackendRequirementKey,
  moduleWindowKeys,
  moduleWindowState,
  parseModuleWindow,
  type ModuleKey,
  type ModuleWindow,
} from '../../../lib/modules';
import { todayInTz } from '../../../lib/dates';
import {
  APP_ENABLED_KEY,
  APP_TABS,
  APP_TAB_MODULE,
  appTabKey,
  getAppSettings,
  parseAppSettingsForm,
  tabModuleAvailable,
  type AppSettings,
} from '../../../lib/memberApp';
import { THEME_META } from '../../../lib/themeMeta.generated';
import { saveImageUpload, uploadErrorKey, type MediaBucket } from '../../../lib/mediaUpload';
import { mediaPath } from '../../../lib/mediaRef';
import { tin, lab, card, errorText, btn, noticeOk, noticeErr } from '../../../lib/adminUi';
import { SUPPORTED_LOCALES, isSupportedLocale, localeMeta, localePath, type Locale } from '../../../lib/locales';
import { LOCALE_DEFAULT_KEY, LOCALE_ENABLED_KEY, getLocaleSettings, saveLocaleSettings } from '../../../lib/localeSettings';

export const prerender = false;

const user = Astro.locals.user;
if (!user || !user.isSuperAdmin) return new Response(null, { status: 403 });
const lang: Locale = user.lang ?? 'en';
const db = Astro.locals.db;
const media = (env as unknown as { MEDIA: MediaBucket }).MEDIA;

const KEYS = [
  ...SUPPORTED_LOCALES.flatMap((code) => [`site.name.${code}`, `site.tagline.${code}`, `site.service_times.${code}`]),
  'site.address', 'site.email', 'site.phone', 'site.map_url', 'site.giving_url', 'site.youtube_url', 'site.hero_image_key',
  'site.logo_image_key',
  'theme.name', 'theme.default_mode',
];

let errors: Record<string, string> = {};
let fd: FormData | null = null;

if (Astro.request.method === 'POST') {
  try {
    fd = await Astro.request.formData();
  } catch {
    return Astro.redirect('/admin/settings?err=1', 303);
  }
  // Member app panel: its own form and its own keys (app.enabled, app.tab.<tab>),
  // written in full like the Modules panel so an unchecked box really turns off.
  if (fd.get('action') === 'app') {
    const app = parseAppSettingsForm(fd);
    if (!app.ok) return Astro.redirect('/admin/settings?appErr=noTabs#settings-app', 303);
    await setSettings(db, app.data);
    return Astro.redirect('/admin/settings?saved=1#settings-app', 303);
  }
  const isModules = fd.get('action') === 'modules';
  const parsed = parseSettingsForm(fd);
  if (parsed.ok) {
    if (isModules) {
      // The Modules panel is its OWN form: it writes ALL 21 module.<key> rows
      // explicitly — a checked box posts '1' (in parsed.data), an unchecked box
      // is absent → we write '0'. This deliberate full write does NOT rely on the
      // parser's partial-update semantics, so unchecking truly disables a module.
      const data: Record<string, string> = {};
      for (const key of MODULE_KEYS) data[`module.${key}`] = parsed.data[`module.${key}`] === '1' ? '1' : '0';
      // Public date windows of schedulable modules: two optional dates each. One
      // invalid window rejects the whole save, so toggles and dates never half-apply.
      // Windows are installation-wide (the middleware reads them before campus
      // scoping), so they go to the unscoped database, like languages.
      const windowData: Record<string, string> = {};
      for (const key of SCHEDULABLE_MODULE_KEYS) {
        const k = moduleWindowKeys(key);
        const win = parseModuleWindow(String(fd.get(k.start) ?? ''), String(fd.get(k.end) ?? ''));
        if (!win.ok) return Astro.redirect(`/admin/settings?windowErr=${key}-${win.error}#settings-modules`, 303);
        windowData[k.start] = win.window.start ?? '';
        windowData[k.end] = win.window.end ?? '';
      }
      await setSettings(db, data);
      await setSettings(Astro.locals.rawDb, windowData);
      // Drop the per-isolate enabled-set cache so the toggle takes effect on the
      // next request in this isolate (this redirect's GET already reflects it).
      clearModuleCache();
      clearModuleWindowCache();
      return Astro.redirect('/admin/settings?saved=1', 303);
    } else {
      // Server-side hardening: module.* keys are ONLY writable through the
      // modules form above — a general save that smuggled them in would flip
      // toggles while busting the wrong (theme) cache, so strip them here.
      const data = Object.fromEntries(
        Object.entries(parsed.data).filter(
          ([k]) => !k.startsWith('module.') && k !== 'site.hero_image_key' && k !== 'site.logo_image_key'
            && k !== LOCALE_ENABLED_KEY && k !== LOCALE_DEFAULT_KEY,
        ),
      );
      // Languages are installation-wide, so they go to the unscoped database. A
      // bare default (no checkbox group) is checked against the stored enabled set.
      const localeEnabled = parsed.data[LOCALE_ENABLED_KEY];
      const localeDefault = parsed.data[LOCALE_DEFAULT_KEY];
      if (localeDefault !== undefined) {
        const enabledList: string[] = localeEnabled !== undefined
          ? JSON.parse(localeEnabled)
          : [...(await getLocaleSettings(Astro.locals.rawDb)).enabled];
        const saveResult = await saveLocaleSettings(Astro.locals.rawDb, enabledList, localeDefault);
        if (!saveResult.ok) errors['locale.default'] = 'admin.settings.localeDefaultNotEnabled';
      }
      const heroFile = fd.get('hero_image');
      if (heroFile instanceof File && heroFile.size > 0) {
        try {
          data['site.hero_image_key'] = await saveImageUpload({
            db,
            media,
            file: heroFile,
            uploadedBy: user.email,
          });
        } catch (e) {
          errors['site.hero_image_key'] = uploadErrorKey(e);
        }
      } else if (fd.get('remove_hero_image')) {
        data['site.hero_image_key'] = '';
      }
      const logoFile = fd.get('logo_image');
      if (logoFile instanceof File && logoFile.size > 0) {
        try {
          data['site.logo_image_key'] = await saveImageUpload({
            db,
            media,
            file: logoFile,
            uploadedBy: user.email,
          });
        } catch (e) {
          errors['site.logo_image_key'] = uploadErrorKey(e);
        }
      } else if (fd.get('logo_image_remove')) {
        data['site.logo_image_key'] = '';
      }
      if (Object.keys(errors).length === 0) {
        await setSettings(db, data);
        // The theme may have changed — drop the per-isolate cache so the next render
        // (this redirect's GET) already reflects the new theme.name / default_mode.
        clearThemeCache();
        return Astro.redirect('/admin/settings?saved=1', 303);
      }
    }
  } else {
    errors = parsed.errors;
  }
}

const cur = await getSettings(db, KEYS);
const localeSettings = await getLocaleSettings(Astro.locals.rawDb);
const localeLabel = (code: string): string => {
  const key = `admin.settings.locale${code[0].toUpperCase()}${code.slice(1)}`;
  const label = t(lang, key);
  return label === key ? localeMeta(code).nativeName : label;
};
const postedEnabled = fd?.has('locale.enabled_form') ? fd.getAll('locale.enabled').map(String) : null;
const enabledNow: string[] = postedEnabled ?? [...localeSettings.enabled];
const saved = Astro.url.searchParams.get('saved') === '1';
const badRequest = Astro.url.searchParams.get('err') === '1';

// Echo submitted values on a failed save, else the stored settings.
const g = (key: string): string => (fd ? String(fd.get(key) ?? '') : (cur[key] ?? ''));
const selectedTheme = g('theme.name') || 'sanctuary';
const selectedMode = g('theme.default_mode') || 'light';
const selectedLocale = (fd ? String(fd.get('locale.default') ?? '') : '') || localeSettings.default;
// Identity fields: one input per ENABLED language (default first). A disabled language's stored
// text is simply not posted, and a settings save only writes the keys it receives.
const stripSuffix = (label: string): string => label.replace(/\s*[（(][^）)]*[）)]\s*$/u, '');
const identityFields = [
  { key: 'name', label: stripSuffix(t(lang, 'admin.settings.nameEn')), wide: false },
  { key: 'tagline', label: stripSuffix(t(lang, 'admin.settings.taglineEn')), wide: false },
  { key: 'service_times', label: stripSuffix(t(lang, 'admin.settings.serviceTimesEn')), wide: true },
];
const localeOrder = [selectedLocale, ...enabledNow.filter((code) => code !== selectedLocale)].filter(isSupportedLocale);
const heroImageKey = cur['site.hero_image_key'] ?? '';
const heroImage = mediaPath(heroImageKey);
const logoImageKey = cur['site.logo_image_key'] ?? '';
const logoImage = mediaPath(logoImageKey);
const themeLabel = (name: string) => t(lang, `admin.settings.themeName.${name}`);
const hasErrors = Object.keys(errors).length > 0;
const h2 = 'font-display text-heading-sm font-bold';

// Modules panel: grouped checkboxes over the `module.<key>` toggles. Current
// state comes from locals.modules (the middleware's enabled set); absent = on.
// `giving`/`registration`/`portal` are backend-gated: on any backend other than the one
// they require, their row renders disabled with a note (dbBackend drives that).
const enabledModules = Astro.locals.modules;
const dbBackend = Astro.locals.dbBackend;
const moduleGroups = MODULE_GROUPS;
// Schedulable modules also show their public date window and where today falls in it.
let moduleWindows: Partial<Record<ModuleKey, ModuleWindow>> = {};
try {
  moduleWindows = await getModuleWindows(Astro.locals.rawDb);
} catch {
  moduleWindows = {};
}
const today = todayInTz();
const schedulable = new Set<string>(SCHEDULABLE_MODULE_KEYS);
const windowErr = Astro.url.searchParams.get('windowErr') ?? '';
const windowErrKey = windowErr.replace(/-(date|order)$/, '');
const windowErrCode = windowErr.endsWith('-order') ? 'admin.settings.moduleWindowOrder' : 'admin.settings.moduleWindowDate';

// Member app panel: stored choices (absent = on) next to the website modules each tab needs.
let appSettings: AppSettings = { enabled: true, tabs: { home: true, events: true, groups: true, giving: true } };
try {
  appSettings = await getAppSettings(db);
} catch {
  /* keep the defaults */
}
const appErr = Astro.url.searchParams.get('appErr') === 'noTabs';
const appTabLabel = (tab: string): string => (tab === 'home' ? t(lang, 'app.tab.home') : t(lang, `modules.${APP_TAB_MODULE[tab as keyof typeof APP_TAB_MODULE]}.label`));
---

<Admin title={t(lang, 'admin.settings.title')}>
  <MemberPageHeader title={t(lang, 'admin.settings.title')} eyebrow={operationsCopy(lang).settings} description={operationsCopy(lang).settingsIntro} />
  {saved && <p class={`mt-4 ${noticeOk}`}>{t(lang, 'admin.settings.saved')}</p>}
  {badRequest && <p class={`mt-4 ${noticeErr}`}>{t(lang, 'admin.form.badRequest')}</p>}
  {hasErrors && <p class={`mt-4 max-w-2xl ${errorText}`}>{t(lang, 'admin.form.fixErrors')}</p>}

  <div class="settings-workspace">
  <nav class="settings-sections" aria-label={t(lang, 'admin.settings.title')}>{['identity','contact','links','appearance','languages','modules','app'].map(key => <a href={`#settings-${key}`}>{t(lang, `admin.settings.${key}Title`)}</a>)}</nav>
  <div><form method="post" enctype="multipart/form-data" class="space-y-6">

    <section id="settings-identity" class={`${card} space-y-4`}>
      <h2 class={h2}>{t(lang, 'admin.settings.identityTitle')}</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {identityFields.map((field) => (
          localeOrder.map((code) => (
            <label class={`block${field.wide ? ' sm:col-span-2' : ''}`}>
              <span class={lab}>{field.label} · {localeMeta(code).nativeName}</span>
              <input name={`site.${field.key}.${code}`} value={g(`site.${field.key}.${code}`)} lang={localeMeta(code).bcp47} class={tin} />
            </label>
          ))
        ))}
      </div>
    </section>

    <section id="settings-contact" class={`${card} space-y-4`}>
      <h2 class={h2}>{t(lang, 'admin.settings.contactTitle')}</h2>
      <label class="block">
        <span class={lab}>{t(lang, 'admin.settings.address')}</span>
        <input name="site.address" value={g('site.address')} class={tin} />
      </label>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class={lab}>{t(lang, 'admin.settings.email')}</span>
          <input name="site.email" value={g('site.email')} class={tin} />
          {errors['site.email'] && <span class={errorText}>{t(lang, errors['site.email'])}</span>}
        </label>
        <label class="block">
          <span class={lab}>{t(lang, 'admin.settings.phone')}</span>
          <input name="site.phone" value={g('site.phone')} class={tin} />
        </label>
      </div>
      <label class="block">
        <span class={lab}>{t(lang, 'admin.settings.mapUrl')}</span>
        <input name="site.map_url" value={g('site.map_url')} class={tin} />
        {errors['site.map_url'] && <span class={errorText}>{t(lang, errors['site.map_url'])}</span>}
      </label>
    </section>

    <section id="settings-links" class={`${card} space-y-4`}>
      <h2 class={h2}>{t(lang, 'admin.settings.linksTitle')}</h2>
      <label class="block">
        <span class={lab}>{t(lang, 'admin.settings.givingUrl')}</span>
        <input name="site.giving_url" value={g('site.giving_url')} class={tin} />
        {errors['site.giving_url'] && <span class={errorText}>{t(lang, errors['site.giving_url'])}</span>}
      </label>
      <label class="block">
        <span class={lab}>{t(lang, 'admin.settings.youtubeUrl')}</span>
        <input name="site.youtube_url" value={g('site.youtube_url')} class={tin} />
        {errors['site.youtube_url'] && <span class={errorText}>{t(lang, errors['site.youtube_url'])}</span>}
      </label>
    </section>

    <section id="settings-appearance" class={`${card} space-y-4`}>
      <h2 class={h2}>{t(lang, 'admin.settings.appearanceTitle')}</h2>
      <p class="text-sm text-ink-muted">{t(lang, 'admin.settings.currentTheme', { theme: themeLabel(selectedTheme) })}</p>
      <DesignImage image="welcome" src={heroImage} class="settings-hero-preview" />
      <p class="text-xs text-ink-muted">{operationsCopy(lang).appearanceDefault}</p>
      <div class="space-y-2">
        {
          heroImage && (
            <div class="space-y-1">
              <span class={lab}>{t(lang, 'admin.settings.currentHeroImage')}</span>

              <label class="flex items-center gap-2 text-sm">
                <input type="checkbox" name="remove_hero_image" /> {t(lang, 'admin.settings.removeHeroImage')}
              </label>
            </div>
          )
        }
        <label class="block">
          <span class={lab}>{heroImage ? t(lang, 'admin.settings.changeHeroImage') : t(lang, 'admin.settings.heroImage')}</span>
          <input type="file" name="hero_image" accept="image/jpeg,image/png,image/webp,image/gif" class="text-sm" />
        </label>
        {errors['site.hero_image_key'] && <span class={errorText}>{t(lang, errors['site.hero_image_key'])}</span>}
      </div>
      <div class="space-y-2">
        {
          logoImage && (
            <div class="space-y-1">
              <span class={lab}>{t(lang, 'admin.settings.currentLogoImage')}</span>
              <img src={logoImage} alt="" class="h-16 w-auto rounded border border-border" loading="lazy" />
              <label class="flex items-center gap-2 text-sm">
                <input type="checkbox" name="logo_image_remove" /> {t(lang, 'admin.settings.removeLogoImage')}
              </label>
            </div>
          )
        }
        <label class="block">
          <span class={lab}>{logoImage ? t(lang, 'admin.settings.changeLogoImage') : t(lang, 'admin.settings.logoImage')}</span>
          <input type="file" name="logo_image" accept="image/jpeg,image/png,image/webp,image/gif" class="text-sm" />
        </label>
        {errors['site.logo_image_key'] && <span class={errorText}>{t(lang, errors['site.logo_image_key'])}</span>}
      </div>
      <fieldset>
        <legend class={lab}>{t(lang, 'admin.settings.theme')}</legend>
        <div class="theme-options">
          {
            THEME_META.map((m) => (
              <label class={`flex cursor-pointer items-center gap-3 rounded-lg border p-3 ${selectedTheme === m.name ? 'border-primary ring-2 ring-primary' : 'border-border'}`}>
                <input type="radio" name="theme.name" value={m.name} checked={selectedTheme === m.name} />
                <span class="flex gap-1" aria-hidden="true">
                  <span class="h-5 w-5 rounded-full border border-border" style={`background:${m.swatches.primary}`} />
                  <span class="h-5 w-5 rounded-full border border-border" style={`background:${m.swatches.accent}`} />
                  <span class="h-5 w-5 rounded-full border border-border" style={`background:${m.swatches.surface}`} />
                </span>
                <span class="text-sm font-semibold text-ink">{themeLabel(m.name)}</span>
              </label>
            ))
          }
        </div>
        {errors['theme.name'] && <span class={errorText}>{t(lang, errors['theme.name'])}</span>}
      </fieldset>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class={lab}>{t(lang, 'admin.settings.defaultMode')}</span>
          <select name="theme.default_mode" class={tin}>
            <option value="light" selected={selectedMode === 'light'}>{t(lang, 'admin.settings.modeLight')}</option>
            <option value="dark" selected={selectedMode === 'dark'}>{t(lang, 'admin.settings.modeDark')}</option>
          </select>
          {errors['theme.default_mode'] && <span class={errorText}>{t(lang, errors['theme.default_mode'])}</span>}
        </label>
      </div>
    </section>

    <section id="settings-languages" class={`${card} space-y-4`}>
      <h2 class={h2}>{t(lang, 'admin.settings.languagesTitle')}</h2>
      <p class="text-sm text-ink-muted">{t(lang, 'admin.settings.languagesIntro')}</p>
      <input type="hidden" name="locale.enabled_form" value="1" />
      <fieldset>
        <legend class={lab}>{t(lang, 'admin.settings.localeEnabled')}</legend>
        <div class="grid gap-2 sm:grid-cols-2">
          {SUPPORTED_LOCALES.map((code) => (
            <label class="flex min-h-11 cursor-pointer items-center gap-3 rounded-lg border border-border p-3">
              <input type="checkbox" name="locale.enabled" value={code} checked={enabledNow.includes(code)} class="h-4 w-4 shrink-0" />
              <span class="text-sm font-semibold text-ink">{localeLabel(code)}</span>
            </label>
          ))}
        </div>
        {errors['locale.enabled'] && <span class={errorText}>{t(lang, errors['locale.enabled'])}</span>}
      </fieldset>
      <label class="block sm:max-w-xs">
        <span class={lab}>{t(lang, 'admin.settings.localeDefault')}</span>
        <select name="locale.default" class={tin}>
          {SUPPORTED_LOCALES.map((code) => (
            <option value={code} selected={selectedLocale === code}>{localeLabel(code)}</option>
          ))}
        </select>
        {errors['locale.default'] && <span class={errorText}>{t(lang, errors['locale.default'])}</span>}
      </label>
    </section>

    <div class="settings-save flex items-center gap-4">
      <button type="submit" class={btn}>{t(lang, 'admin.form.save')}</button>
    </div>
  </form>

  <form method="post" class="mt-8">
    <input type="hidden" name="action" value="modules" />
    <section id="settings-modules" class={`${card} space-y-4`}>
      <div>
        <h2 class={h2}>{t(lang, 'admin.settings.modulesTitle')}</h2>
        <p class="mt-1 text-sm text-ink-muted">{t(lang, 'admin.settings.modulesIntro')}</p>
      </div>
      {
        moduleGroups.map((group) => (
          <fieldset class="space-y-3">
            <legend class={lab}>{t(lang, group.titleKey)}</legend>
            {group.keys.map((key) => {
              const req = MODULES[key].requiresBackend;
              const gated = req !== undefined && req !== dbBackend;
              const toggle = (
                <label class={`flex items-start gap-3 rounded-lg border border-border p-3 ${gated ? 'opacity-60' : 'cursor-pointer'}`}>
                  <input
                    type="checkbox"
                    name={`module.${key}`}
                    value="1"
                    checked={enabledModules.has(key)}
                    disabled={gated}
                    class="mt-1 h-4 w-4 shrink-0"
                  />
                  <span>
                    <span class="block text-sm font-semibold text-ink">{t(lang, `modules.${key}.label`)}</span>
                    <span class="block text-sm text-ink-muted">{t(lang, `modules.${key}.desc`)}</span>
                    {gated && req && <span class="block text-sm text-ink-muted">{t(lang, moduleBackendRequirementKey(req))}</span>}
                  </span>
                </label>
              );
              if (!schedulable.has(key)) return toggle;
              const k = moduleWindowKeys(key);
              const win = moduleWindows[key];
              const state = moduleWindowState(win, today);
              return (
                <div class="module-window rounded-lg border border-border" data-module-window={key}>
                  {toggle}
                  <div class="space-y-2 px-3 pb-3">
                    <p class="text-sm font-semibold text-ink">{t(lang, 'admin.settings.moduleWindowTitle')}</p>
                    <p class="text-sm text-ink-muted">{t(lang, 'admin.settings.moduleWindowHelp')}</p>
                    <div class="grid gap-2 sm:grid-cols-2">
                      <label class="block text-sm">
                        <span class={lab}>{t(lang, 'admin.settings.moduleWindowStart')}</span>
                        <input type="date" name={k.start} value={win?.start ?? ''} class={tin} />
                      </label>
                      <label class="block text-sm">
                        <span class={lab}>{t(lang, 'admin.settings.moduleWindowEnd')}</span>
                        <input type="date" name={k.end} value={win?.end ?? ''} class={tin} />
                      </label>
                    </div>
                    <p class="text-sm text-ink-muted" data-window-state={state}>
                      {enabledModules.has(key) ? t(lang, `admin.settings.moduleWindowState.${state}`) : t(lang, 'admin.settings.moduleWindowState.off')}
                    </p>
                    {windowErrKey === key && <p class={errorText}>{t(lang, windowErrCode)}</p>}
                  </div>
                </div>
              );
            })}
          </fieldset>
        ))
      }
      <div class="flex items-center gap-4">
        <button type="submit" class={btn}>{t(lang, 'admin.settings.saveModules')}</button>
      </div>
    </section>
  </form>

  <form method="post" class="mt-8">
    <input type="hidden" name="action" value="app" />
    <section id="settings-app" class={`${card} space-y-4`}>
      <div>
        <h2 class={h2}>{t(lang, 'admin.settings.appTitle')}</h2>
        <p class="mt-1 text-sm text-ink-muted">{t(lang, 'admin.settings.appIntro')}</p>
        <a href={localePath(lang, '/app')} class="mt-2 inline-block text-sm font-semibold text-primary hover:underline">{t(lang, 'admin.settings.appOpen')} →</a>
      </div>
      <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-border p-3">
        <input type="checkbox" name={APP_ENABLED_KEY} value="1" checked={appSettings.enabled} class="mt-1 h-4 w-4 shrink-0" />
        <span class="text-sm font-semibold text-ink">{t(lang, 'admin.settings.appEnabled')}</span>
      </label>
      <fieldset class="space-y-3">
        <legend class={lab}>{t(lang, 'admin.settings.appTabs')}</legend>
        {APP_TABS.map((tab) => {
          const available = tabModuleAvailable(tab, enabledModules);
          return (
            <label class={`flex items-start gap-3 rounded-lg border border-border p-3 ${available ? 'cursor-pointer' : 'opacity-60'}`}>
              <input type="checkbox" name={appTabKey(tab)} value="1" checked={appSettings.tabs[tab]} class="mt-1 h-4 w-4 shrink-0" data-app-tab-toggle={tab} />
              <span>
                <span class="block text-sm font-semibold text-ink">{appTabLabel(tab)}</span>
                <span class="block text-sm text-ink-muted">{t(lang, `admin.settings.appTabDesc.${tab}`)}</span>
                {!available && <span class="block text-sm text-ink-muted">{t(lang, 'admin.settings.appTabNeedsModule')}</span>}
              </span>
            </label>
          );
        })}
        {appErr && <p class={errorText}>{t(lang, 'admin.settings.appNoTabs')}</p>}
      </fieldset>
      <div class="flex items-center gap-4">
        <button type="submit" class={btn}>{t(lang, 'admin.settings.saveApp')}</button>
      </div>
    </section>
  </form>
  </div></div>
</Admin>

