---
import Admin from '../../../layouts/Admin.astro';
import CareWorkspace from '../../../components/admin/care/CareWorkspace.astro';
import { careToolsCopy } from '../../../i18n/designCareTools';
import { appendAuditEvent } from '../../../lib/auditDb';
import { todayInTz } from '../../../lib/dates';
import { t } from '../../../lib/i18n';
import { loadPastoralNotesExport } from '../../../lib/peopleExportDb';
import {
  PEOPLE_NOTES_ACKNOWLEDGEMENT,
  canExportPastoralNotes,
  handlePastoralNotesExport,
  peopleExportJson,
  type PastoralNotesExportRuntime,
} from '../../../lib/peopleExportHttp';
import { buildPastoralNotesExport } from '../../../lib/pastoralNotesExport';
import { btn, btnSecondary } from '../../../lib/adminUi';
import type { Locale } from '../../../lib/locales';

export const prerender = false;

const access = canExportPastoralNotes(Astro.locals.user, Astro.locals.modules);
if (access === 'not_found') return peopleExportJson(404, { ok: false, code: 'not_found' });
if (access === 'forbidden') return peopleExportJson(403, { ok: false, code: 'forbidden' });

const method = Astro.request.method;
if (method !== 'GET' && method !== 'POST') {
  return peopleExportJson(
    405,
    { ok: false, code: 'method_not_allowed' },
    { Allow: 'GET, POST' },
  );
}

if (method === 'POST') {
  const runtime: PastoralNotesExportRuntime = {
    loadNotes: loadPastoralNotesExport,
    buildNotes: buildPastoralNotesExport,
    appendAudit: appendAuditEvent,
  };
  return handlePastoralNotesExport({
    request: Astro.request,
    user: Astro.locals.user,
    modules: Astro.locals.modules,
    db: Astro.locals.db,
    backend: Astro.locals.dbBackend,
    today: todayInTz(),
  }, runtime);
}

const user = Astro.locals.user!;
const lang: Locale = user.lang ?? 'en';
const title = t(lang, 'admin.peopleExport.notesTitle');
const copy = careToolsCopy(lang);
---

<Admin title={title}>
  <CareWorkspace variant="notes-export">
    <main data-pastoral-notes-export>
      <div class="care-heading"><div><p class="care-eyebrow">{copy.notes}</p><h1>{title}</h1><p class="care-intro">{t(lang, 'admin.peopleExport.notesBody')}</p></div><a href="/admin/people" class={btnSecondary}>&larr; {t(lang, 'admin.peopleExport.back')}</a></div>
      <div class="care-tools-layout">
        <section class="care-panel care-notes-confirm" aria-labelledby="notes-export-warning">
          <p class="care-eyebrow">{copy.notesConfirm}</p><h2 id="notes-export-warning" class="text-danger">{t(lang, 'admin.peopleExport.notesWarning')}</h2>
          <form method="post" enctype="application/x-www-form-urlencoded">
            <label class="care-notes-ack"><input type="checkbox" name="acknowledgement" value={PEOPLE_NOTES_ACKNOWLEDGEMENT} required /><span>{t(lang, 'admin.peopleExport.notesAcknowledge')}</span></label>
            <div class="care-form-actions"><button type="submit" class={btn}>{t(lang, 'admin.peopleExport.notesDownload')}</button></div>
          </form>
        </section>
        <aside class="care-panel care-tools-aside"><h2>{copy.notesNext}</h2><p>{t(lang, 'admin.peopleExport.notesAudit')}</p></aside>
      </div>
    </main>
  </CareWorkspace>
</Admin>
