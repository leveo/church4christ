---
import Admin from '../../../layouts/Admin.astro';
import CareWorkspace from '../../../components/admin/care/CareWorkspace.astro';
import { careToolsCopy } from '../../../i18n/designCareTools';
import Icon from '../../../components/ui/Icon.astro';
import { btnSecondary } from '../../../lib/adminUi';
import { todayInTz } from '../../../lib/dates';
import { t } from '../../../lib/i18n';
import type { Locale } from '../../../lib/locales';
import { buildCanonicalExportParts } from '../../../lib/peopleExport';
import { loadCanonicalPeopleExport } from '../../../lib/peopleExportDb';
import {
  canManagePeopleExport,
  loadPeopleExportDiscovery,
  peopleExportJson,
  type StandardPeopleExportRuntime,
} from '../../../lib/peopleExportHttp';

export const prerender = false;

const access = canManagePeopleExport(Astro.locals.user, Astro.locals.modules);
if (access === 'not_found') return peopleExportJson(404, { ok: false, code: 'not_found' });
if (access === 'forbidden') return peopleExportJson(403, { ok: false, code: 'forbidden' });

const method = Astro.request.method;
if (method !== 'GET') {
  return peopleExportJson(
    405,
    { ok: false, code: 'method_not_allowed' },
    { Allow: 'GET' },
  );
}

Astro.response.headers.set('cache-control', 'private, no-store');
Astro.response.headers.set('pragma', 'no-cache');
Astro.response.headers.set('x-content-type-options', 'nosniff');

const runtime: StandardPeopleExportRuntime = {
  loadCanonical: loadCanonicalPeopleExport,
  buildCanonical: buildCanonicalExportParts,
};
const result = await loadPeopleExportDiscovery({
  request: Astro.request,
  user: Astro.locals.user,
  modules: Astro.locals.modules,
  db: Astro.locals.db,
  backend: Astro.locals.dbBackend,
  today: todayInTz(),
}, runtime);
if (result.status === 'response') return result.response;

const user = Astro.locals.user!;
const lang: Locale = user.lang ?? 'en';
const title = t(lang, 'admin.peopleExport.standardTitle');
const copy = careToolsCopy(lang);
---

<Admin title={title}>
  <CareWorkspace variant="people-export">
    <main data-people-export-discovery>
      <div class="care-heading"><div><p class="care-eyebrow">{copy.export}</p><h1>{title}</h1><p class="care-intro">{t(lang, 'admin.peopleExport.standardBody')}</p></div><a href="/admin/people" class={btnSecondary}>&larr; {t(lang, 'admin.peopleExport.back')}</a></div>
      {result.status === 'success' && <>
        <section class="care-panel care-export-summary" aria-labelledby="people-export-summary">
          <h2 id="people-export-summary">{t(lang, 'admin.peopleExport.discoverySummary')}</h2>
          <dl class="care-export-totals"><div><dt>{t(lang, 'admin.peopleExport.discoveryParts')}</dt><dd>{result.partCount}</dd></div><div><dt>{t(lang, 'admin.peopleExport.discoveryRows')}</dt><dd>{result.totalRows}</dd></div><div><dt>{t(lang, 'admin.peopleExport.discoveryHouseholds')}</dt><dd>{result.totalHouseholds}</dd></div></dl>
        </section>
        <section class="care-export-downloads" aria-labelledby="export-download-heading">
          <div class="care-panel-heading"><div><h2 id="export-download-heading">{copy.exportParts}</h2><p class="care-intro">{copy.exportPartsIntro}</p></div></div>
          <ol class="care-export-parts">{result.parts.map((part) => <li>
            <article><span class="care-export-file" aria-hidden="true"><Icon name="book" /></span><div class="care-export-part-copy"><h3>{t(lang, 'admin.peopleExport.discoveryPart')} {part.number} / {result.partCount}</h3><p>{t(lang, 'admin.peopleExport.discoveryRows')}: {part.rowCount}{' · '}{t(lang, 'admin.peopleExport.discoveryHouseholds')}: {part.householdCount}</p></div><a href={part.href} class={btnSecondary}>{t(lang, 'admin.peopleExport.discoveryDownload')} {part.number} <Icon name="arrow" size={16} /></a></article>
          </li>)}</ol>
        </section>
      </>}
      {result.status === 'repair_required' && <section class="care-panel care-export-repair" aria-labelledby="people-export-repair">
        <h2 id="people-export-repair" class="text-danger">{t(lang, 'admin.peopleExport.discoveryRepairTitle')}</h2><p class="care-intro">{t(lang, 'admin.peopleExport.discoveryRepairBody')}</p>
        <dl class="care-export-totals"><div><dt>{t(lang, 'admin.peopleImport.summary.people')}</dt><dd>{result.counts.people}</dd></div><div><dt>{t(lang, 'admin.peopleImport.summary.dependents')}</dt><dd>{result.counts.dependents}</dd></div><div><dt>{t(lang, 'admin.peopleImport.summary.households')}</dt><dd>{result.counts.households}</dd></div><div><dt>{t(lang, 'admin.peopleExport.discoveryIssues')}</dt><dd>{result.counts.issues}</dd></div></dl>
      </section>}
      {result.status === 'error' && <section class="care-panel care-export-repair" aria-labelledby="people-export-error" role="alert"><h2 id="people-export-error" class="text-danger">{t(lang, 'admin.peopleExport.discoveryErrorTitle')}</h2><p class="care-intro">{t(lang, 'admin.peopleExport.discoveryErrorBody')}</p></section>}
    </main>
  </CareWorkspace>
</Admin>
