---
import Admin from '../../../layouts/Admin.astro';
import { btnSecondary, card } from '../../../lib/adminUi';
import { todayInTz } from '../../../lib/dates';
import { t } from '../../../lib/i18n';
import type { Locale } from '../../../lib/locales';
import { buildCanonicalExportParts } from '../../../lib/peopleExport';
import { loadCanonicalPeopleExport } from '../../../lib/peopleExportDb';
import {
  canManagePeopleExport,
  loadPeopleExportDiscovery,
  peopleExportJson,
  type StandardPeopleExportRuntime,
} from '../../../lib/peopleExportHttp';

export const prerender = false;

const access = canManagePeopleExport(Astro.locals.user, Astro.locals.modules);
if (access === 'not_found') return peopleExportJson(404, { ok: false, code: 'not_found' });
if (access === 'forbidden') return peopleExportJson(403, { ok: false, code: 'forbidden' });

const method = Astro.request.method;
if (method !== 'GET') {
  return peopleExportJson(
    405,
    { ok: false, code: 'method_not_allowed' },
    { Allow: 'GET' },
  );
}

Astro.response.headers.set('cache-control', 'private, no-store');
Astro.response.headers.set('pragma', 'no-cache');
Astro.response.headers.set('x-content-type-options', 'nosniff');

const runtime: StandardPeopleExportRuntime = {
  loadCanonical: loadCanonicalPeopleExport,
  buildCanonical: buildCanonicalExportParts,
};
const result = await loadPeopleExportDiscovery({
  request: Astro.request,
  user: Astro.locals.user,
  modules: Astro.locals.modules,
  db: Astro.locals.db,
  backend: Astro.locals.dbBackend,
  today: todayInTz(),
}, runtime);
if (result.status === 'response') return result.response;

const user = Astro.locals.user!;
const lang: Locale = user.lang ?? 'en';
const title = t(lang, 'admin.peopleExport.standardTitle');
---

<Admin title={title}>
  <main data-people-export-discovery class="mx-auto max-w-4xl">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="font-display text-heading-md font-bold">{title}</h1>
        <p class="mt-2 max-w-3xl text-sm text-ink-muted">
          {t(lang, 'admin.peopleExport.standardBody')}
        </p>
      </div>
      <a href="/admin/people" class={btnSecondary}>{t(lang, 'admin.peopleExport.back')}</a>
    </div>

    {
      result.status === 'success' && (
        <>
          <section class={`mt-6 ${card}`} aria-labelledby="people-export-summary">
            <h2 id="people-export-summary" class="font-display text-heading-sm font-bold">
              {t(lang, 'admin.peopleExport.discoverySummary')}
            </h2>
            <dl class="mt-4 grid gap-3 sm:grid-cols-3">
              <div class="rounded-md border border-border bg-surface-sunken px-3 py-2">
                <dt class="text-xs font-semibold uppercase tracking-caps text-ink-subtle">
                  {t(lang, 'admin.peopleExport.discoveryParts')}
                </dt>
                <dd class="mt-1 text-xl font-bold">{result.partCount}</dd>
              </div>
              <div class="rounded-md border border-border bg-surface-sunken px-3 py-2">
                <dt class="text-xs font-semibold uppercase tracking-caps text-ink-subtle">
                  {t(lang, 'admin.peopleExport.discoveryRows')}
                </dt>
                <dd class="mt-1 text-xl font-bold">{result.totalRows}</dd>
              </div>
              <div class="rounded-md border border-border bg-surface-sunken px-3 py-2">
                <dt class="text-xs font-semibold uppercase tracking-caps text-ink-subtle">
                  {t(lang, 'admin.peopleExport.discoveryHouseholds')}
                </dt>
                <dd class="mt-1 text-xl font-bold">{result.totalHouseholds}</dd>
              </div>
            </dl>
          </section>

          <section class="mt-4 space-y-3" aria-label={t(lang, 'admin.peopleExport.discoveryParts')}>
            {result.parts.map((part) => (
              <article class={`${card} flex flex-wrap items-center justify-between gap-4`}>
                <div>
                  <h2 class="font-display text-heading-sm font-bold">
                    {t(lang, 'admin.peopleExport.discoveryPart')} {part.number} / {result.partCount}
                  </h2>
                  <p class="mt-1 text-sm text-ink-muted">
                    {t(lang, 'admin.peopleExport.discoveryRows')}: {part.rowCount}
                    {' · '}
                    {t(lang, 'admin.peopleExport.discoveryHouseholds')}: {part.householdCount}
                  </p>
                </div>
                <a href={part.href} class={btnSecondary}>
                  {t(lang, 'admin.peopleExport.discoveryDownload')} {part.number}
                </a>
              </article>
            ))}
          </section>
        </>
      )
    }

    {
      result.status === 'repair_required' && (
        <section class={`mt-6 ${card}`} aria-labelledby="people-export-repair">
          <h2 id="people-export-repair" class="font-display text-heading-sm font-bold text-danger">
            {t(lang, 'admin.peopleExport.discoveryRepairTitle')}
          </h2>
          <p class="mt-2 text-sm text-ink-muted">{t(lang, 'admin.peopleExport.discoveryRepairBody')}</p>
          <dl class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            <div><dt class="text-xs text-ink-subtle">{t(lang, 'admin.peopleImport.summary.people')}</dt><dd class="font-bold">{result.counts.people}</dd></div>
            <div><dt class="text-xs text-ink-subtle">{t(lang, 'admin.peopleImport.summary.dependents')}</dt><dd class="font-bold">{result.counts.dependents}</dd></div>
            <div><dt class="text-xs text-ink-subtle">{t(lang, 'admin.peopleImport.summary.households')}</dt><dd class="font-bold">{result.counts.households}</dd></div>
            <div><dt class="text-xs text-ink-subtle">{t(lang, 'admin.peopleExport.discoveryIssues')}</dt><dd class="font-bold">{result.counts.issues}</dd></div>
          </dl>
        </section>
      )
    }

    {
      result.status === 'error' && (
        <section class={`mt-6 ${card}`} aria-labelledby="people-export-error">
          <h2 id="people-export-error" class="font-display text-heading-sm font-bold text-danger">
            {t(lang, 'admin.peopleExport.discoveryErrorTitle')}
          </h2>
          <p class="mt-2 text-sm text-ink-muted">{t(lang, 'admin.peopleExport.discoveryErrorBody')}</p>
        </section>
      )
    }
  </main>
</Admin>
