---
import Base from '../../layouts/Base.astro';
import ConfirmationPanel from '../../components/ui/ConfirmationPanel.astro';
import { tokenPagePresentation } from '../../lib/tokenPagePresentation';
// The 0030 identity-security cutover permanently retires legacy email-change
// tokens. This locale-free endpoint stays mutation-free so stale messages
// cannot reveal or alter a member record; presentation follows request locale.
const presentation = tokenPagePresentation(Astro.request, 'emailChange', 'error');
---
<Base title={presentation.title} locale={presentation.locale} noindex privateMetadata>
  <ConfirmationPanel title={presentation.title} body={presentation.body}>
    <a href={presentation.retryHref}>{presentation.action}</a>
  </ConfirmationPanel>
</Base>
