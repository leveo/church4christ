---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import { consumeToken, peekToken } from '../../lib/auth';
import { getPersonById } from '../../lib/db';
import { loadSessionUser } from '../../lib/currentUser';
import { completeSigninLink } from '../../lib/identityAccount';
import { peekEmailLinkChallenge, type IdentityAuthEnv } from '../../lib/identityAuth';
import ConfirmationPanel from '../../components/ui/ConfirmationPanel.astro';
import { tokenPagePresentation } from '../../lib/tokenPagePresentation';
import { DEFAULT_LOCALE } from '../../lib/locales';
import { getEnabledModules } from '../../lib/modules';
import { mintSession, sessionCookie } from '../../lib/session';

const raw = Astro.params.token ?? '';
Astro.response.headers.set('cache-control', 'no-store');
Astro.response.headers.set('referrer-policy', 'no-referrer');
Astro.response.headers.set('x-content-type-options', 'nosniff');
const requestedCampus = Astro.url.searchParams.get('campus');
const match = raw.match(/^([0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})\.([A-Za-z0-9_-]{20,200})$/u);
const campus = requestedCampus && Astro.locals.campusMode === 'campus' && Astro.locals.campus?.slug === requestedCampus
  ? Astro.locals.campus
  : null;
const modern = match && campus ? { publicId: match[1], token: match[2], campus } : null;
const vars = env as unknown as IdentityAuthEnv & { SESSION_SECRET?: string };
const db = Astro.locals.rawDb;
let state: 'confirm' | 'error' = 'error';

async function authenticatedResponse(personId: number, sessionEpoch: number): Promise<Response | null> {
  if (!vars.SESSION_SECRET) return null;
  const person = await getPersonById(db, personId);
  if (!person || person.active !== 1) return null;
  const user = await loadSessionUser(db, person.id, sessionEpoch);
  if (!user) return null;
  const jwt = await mintSession(vars.SESSION_SECRET, {
    id: person.id,
    sessionEpoch,
  }, { authMethod: 'magic_link' });
  const target = user.lang ?? DEFAULT_LOCALE;
  const modules = Astro.locals.modules ?? (await getEnabledModules(Astro.locals.db, Astro.locals.dbBackend));
  const landing = modules.has('portal') ? 'my/opportunities' : modules.has('serve') ? 'my' : 'profile';
  return new Response(null, {
    status: 303,
    headers: {
      location: `/${target}/${landing}`,
      'set-cookie': sessionCookie(jwt, import.meta.env.PROD),
    },
  });
}

if (Astro.request.method === 'POST') {
  if (modern && vars.SESSION_SECRET) {
    const result = await completeSigninLink(db, vars, {
      campusId: modern.campus.id,
      publicId: modern.publicId,
      token: modern.token,
      source: 'web',
    });
    if (result.status === 'authenticated') {
      const response = await authenticatedResponse(result.personId, result.sessionEpoch);
      if (response) return response;
    }
  } else if (!match) {
    // Legacy raw-token grace path: old emails remain usable until their normal
    // expiry, but successful consumption still mints the opaque v2 session.
    const consumed = vars.SESSION_SECRET ? await consumeToken(db, raw, 'login') : null;
    if (consumed) {
      const epoch = consumed.expected_session_epoch;
      if (typeof epoch !== 'number' || !Number.isSafeInteger(epoch) || epoch < 0) return Astro.redirect('/en/signin', 303);
      const response = await authenticatedResponse(consumed.person_id, epoch);
      if (response) return response;
    }
  }
} else if (modern) {
  try {
    const peeked = await peekEmailLinkChallenge(db, vars, {
      campusId: modern.campus.id,
      publicId: modern.publicId,
      token: modern.token,
      purpose: 'login',
      source: 'web',
    });
    state = peeked.ok ? 'confirm' : 'error';
  } catch {
    state = 'error';
  }
} else if (!match) {
  state = (await peekToken(db, raw, 'login')) !== null ? 'confirm' : 'error';
}

const presentation = tokenPagePresentation(Astro.request, 'auth', state);
---
<Base title={presentation.title} locale={presentation.locale} noindex privateMetadata>
  <ConfirmationPanel title={presentation.title} body={presentation.body}>
    {state === 'confirm' ? (
      <form method="post"><button type="submit">{presentation.action}</button></form>
    ) : (
      <a href={presentation.retryHref}>{presentation.action}</a>
    )}
  </ConfirmationPanel>
</Base>
