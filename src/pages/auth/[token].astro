---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import ConfirmationPanel from '../../components/ui/ConfirmationPanel.astro';
import { tokenPagePresentation } from '../../lib/tokenPagePresentation';
import { DEFAULT_LOCALE } from '../../lib/locales';
import { consumeToken, peekToken } from '../../lib/auth';
import { getPersonById } from '../../lib/db';
import { getEnabledModules } from '../../lib/modules';
import { mintSession, sessionCookie } from '../../lib/session';

// Two-step consumption: GET only *peeks* (mail scanners prefetch links and would
// otherwise burn a single-use token); the explicit POST consumes and signs in.
// This locale-free page follows the request language; successful redirects use the person's saved language.
const raw = Astro.params.token ?? '';
const vars = env as unknown as { SESSION_SECRET?: string };
const db = Astro.locals.db;
let state: 'confirm' | 'error' = 'error';

if (Astro.request.method === 'POST') {
  const consumed = vars.SESSION_SECRET ? await consumeToken(db, raw, 'login') : null;
  const person = consumed ? await getPersonById(db, consumed.person_id) : null;
  if (person && person.active === 1 && vars.SESSION_SECRET) {
    const jwt = await mintSession(vars.SESSION_SECRET, {
      id: person.id,
      email: person.email,
      sessionEpoch: person.session_epoch,
    });
    const target = person.lang === 'en' || person.lang === 'zh' ? person.lang : DEFAULT_LOCALE;
    // Module-aware landing: the portal opportunity hub is the member landing
    // page when Portal is enabled. `/my` remains serve-owned, so fall back to
    // profile when neither module is available. The middleware sets
    // locals.modules on every request; fall back to the lib if it is absent.
    const modules = Astro.locals.modules ?? (await getEnabledModules(db, Astro.locals.dbBackend));
    const landing = modules.has('portal') ? 'my/opportunities' : modules.has('serve') ? 'my' : 'profile';
    return new Response(null, {
      status: 303,
      headers: {
        location: `/${target}/${landing}`,
        'set-cookie': sessionCookie(jwt, import.meta.env.PROD),
      },
    });
  }
  // fall through to the error state
} else {
  state = (await peekToken(db, raw, 'login')) !== null ? 'confirm' : 'error';
}

const presentation = tokenPagePresentation(Astro.request, 'auth', state);
---
<Base title={presentation.title} locale={presentation.locale} noindex>
  <ConfirmationPanel title={presentation.title} body={presentation.body}>
    {state === 'confirm' ? (
      <form method="post"><button type="submit">{presentation.action}</button></form>
    ) : (
      <a href={presentation.retryHref}>{presentation.action}</a>
    )}
  </ConfirmationPanel>
</Base>
