---
// Apply to serve — PUBLIC. Anonymous identity-affecting writes are durably
// staged and require mailbox proof before a person/application is created.
import { env } from 'cloudflare:workers';
import Base from '../../../layouts/Base.astro';
import MinistryWorkspace from '../../../components/ministry/MinistryWorkspace.astro';
import MinistryHeader from '../../../components/ministry/MinistryHeader.astro';
import { ministryCopy } from '../../../i18n/designMinistry';
import { localePath, parseLocale } from '../../../lib/locales';
import { t } from '../../../lib/i18n';
import {
  listTeamPositions,
  listTeamSummaries,
} from '../../../lib/teamDb';
import { sendApplicationReceived } from '../../../lib/notify';
import type { EmailEnv } from '../../../lib/email';
import type { IdentityAuthEnv } from '../../../lib/identityAuth';
import { identityTrustedRequestContext } from '../../../lib/identityAuth';
import { IDENTITY_DEVICE_COOKIE, resolveIdentityDeviceCookie } from '../../../lib/identityDeviceCookie';
import { scheduleIdentityDelivery } from '../../../lib/identityDelivery';
import {
  beginTeamApplicationIntent,
  claimTeamApplicationSessionDelivery,
  completeTeamApplicationIntent,
  consumeSignedInTeamApplicationIntent,
} from '../../../lib/identityBusinessIntent';
import { identityGatewaySessionContext, type IdentitySourceKeyEnv } from '../../../lib/identityGateway';
import { sendIdentitySignupOtp } from '../../../lib/identityNotify';
import { mintSession, sessionCookie } from '../../../lib/session';
import { parseApplicationForm } from '../../../lib/validate';
import { btn, lab, noticeErr, tin } from '../../../lib/adminUi';

const locale = parseLocale(Astro.params.locale ?? '');
if (!locale) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
const user = Astro.locals.user;
type ApplyEnv = EmailEnv & IdentityAuthEnv & IdentitySourceKeyEnv & { SESSION_SECRET?: string };
const vars = env as unknown as ApplyEnv;
const db = Astro.locals.db;
const identityDb = Astro.locals.rawDb;
const campus = Astro.locals.campusMode === 'campus' ? Astro.locals.campus : null;

const idOf = (v: string | FormDataEntryValue | null): number | null =>
  /^\d+$/.test(String(v ?? '')) ? Number(v) : null;

const teams = await listTeamSummaries(db, locale);

let errorKeys: string[] = [];
let postedTeamId: number | null = null;
let intentId: string = crypto.randomUUID();
let publicId = '';
let verificationState: 'none' | 'code' | 'invalid' | 'review' | 'neutral' = 'none';

async function identityDeviceId(): Promise<string> {
  const resolved = await resolveIdentityDeviceCookie(vars, Astro.cookies.get(IDENTITY_DEVICE_COOKIE)?.value);
  if (resolved.replaced) Astro.cookies.set(IDENTITY_DEVICE_COOKIE, resolved.cookieValue, {
    path: '/', httpOnly: true, secure: import.meta.env.PROD, sameSite: 'lax', maxAge: 365 * 24 * 60 * 60,
  });
  return resolved.deviceId;
}

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = String(fd.get('action') ?? 'begin');
  intentId = String(fd.get('intent_id') ?? '');
  // Honeypot: bots fill the hidden "website" field; pretend success, do
  // nothing — landing on the same anonymous handoff state.
  if (String(fd.get('website') ?? '') !== '') {
    verificationState = 'neutral';
  } else if (!campus) {
    verificationState = 'neutral';
  } else if (action === 'verify') {
    publicId = String(fd.get('public_id') ?? '');
    const code = String(fd.get('code') ?? '').trim();
    try {
      const result = await completeTeamApplicationIntent(identityDb, vars, {
        campusId: campus.id, intentId, publicId, code,
      });
      if (result.status === 'review') verificationState = 'review';
      else if (result.status === 'consumed' && vars.SESSION_SECRET) {
        const delivery = await claimTeamApplicationSessionDelivery(identityDb, vars, {
          campusId: campus.id, intentId, publicId, code,
        });
        if (!delivery) verificationState = 'invalid';
        else {
          await sendApplicationReceived(vars, identityDb, result.applicationId);
          const jwt = await mintSession(vars.SESSION_SECRET, {
            id: delivery.personId, sessionEpoch: delivery.sessionEpoch,
          }, { authMethod: 'email_otp' });
          return new Response(null, { status: 303, headers: {
            location: localePath(locale, '/serve/apply?sent=1'),
            'set-cookie': sessionCookie(jwt, import.meta.env.PROD),
            'cache-control': 'no-store',
            'referrer-policy': 'no-referrer',
          } });
        }
      } else verificationState = 'invalid';
    } catch {
      verificationState = 'invalid';
    }
  } else {
    const parsed = parseApplicationForm(fd, !!user);
    postedTeamId = idOf(fd.get('team_id'));
    if (!parsed.ok) {
      errorKeys = [...new Set(Object.values(parsed.errors))];
    } else if (!teams.some((tm) => tm.id === parsed.data.teamId)) {
      errorKeys = ['errors.invalidOption'];
    } else {
      const input = parsed.data;
      const teamPositions = await listTeamPositions(db, input.teamId, locale);
      const positionId = teamPositions.some((p) => p.id === input.positionId) ? input.positionId : null;
      try {
        if (user) {
          const sessionEpoch = await identityDb.prepare('SELECT session_epoch FROM people WHERE id=?1')
            .bind(user.id).first<number>('session_epoch');
          if (sessionEpoch === null) throw new Error('identity_business_intent_invalid_session');
          const result = await consumeSignedInTeamApplicationIntent(identityDb, vars, {
            campusId: campus.id, intentId, teamId: input.teamId, positionId, message: input.message,
            session: identityGatewaySessionContext({ personId: user.id, campusId: campus.id, sessionEpoch }),
          });
          await sendApplicationReceived(vars, identityDb, result.applicationId);
          return new Response(null, { status: 303, headers: {
            location: localePath(locale, '/serve/apply?sent=1'),
            'cache-control': 'no-store',
            'referrer-policy': 'no-referrer',
          } });
        }
        const begun = await beginTeamApplicationIntent(identityDb, vars, {
          campusId: campus.id, intentId, teamId: input.teamId, positionId, message: input.message,
          name: input.name, email: input.email, phone: input.phone,
          requestContext: identityTrustedRequestContext(Astro.request.headers, await identityDeviceId()),
        });
        if (begun.status === 'verification_required') {
          scheduleIdentityDelivery(Astro.locals.cfContext,
            () => sendIdentitySignupOtp(vars, identityDb, begun.delivery, locale));
          publicId = begun.delivery.publicId;
          verificationState = 'code';
        } else verificationState = 'neutral';
      } catch {
        verificationState = 'neutral';
      }
    }
  }
}

const sent = Astro.url.searchParams.has('sent');
// dup is only ever set for signed-in submitters; gate the render on the
// session too so hand-typing ?dup=1 anonymously still shows the neutral state.
const isDup = Astro.url.searchParams.has('dup') && !!user;

const selectedTeamId = postedTeamId ?? idOf(Astro.url.searchParams.get('team'));
const selectedTeam = teams.find((tm) => tm.id === selectedTeamId) ?? null;
const positions = selectedTeam ? await listTeamPositions(db, selectedTeam.id, locale) : [];
const copy = ministryCopy(locale);
---

<Base title={t(locale, 'apply.title')} locale={locale}>
<MinistryWorkspace locale={locale} audience="public" variant="work">
  <MinistryHeader title={t(locale, 'apply.title')} eyebrow={copy.scheduleEyebrow} description={copy.applicationIntro} />
  {!sent && verificationState === 'none' && <ol class="mw-steps" aria-label={t(locale, 'apply.title')}>
    <li aria-current={!selectedTeam ? 'step' : undefined}><span>1</span>{copy.chooseTeam}</li>
    <li aria-current={selectedTeam ? 'step' : undefined}><span>2</span>{copy.introduceYourself}</li>
  </ol>}
  <div class="mw-split">
  <div class="mw-panel">

    {
      verificationState === 'review' ? (
        <div class="mt-6 space-y-2 rounded-lg border border-border bg-surface-raised p-6 text-ink">
          <p class="font-semibold">{t(locale, 'signup.reviewTitle')}</p>
          <p>{t(locale, 'signup.reviewBody')}</p>
        </div>
      ) : verificationState === 'code' || verificationState === 'invalid' ? (
        <div class="mt-6 rounded-lg border border-border bg-surface-raised p-6">
          <p class="font-semibold">{t(locale, 'signup.codeSentTitle')}</p>
          <p class="mt-2 text-ink-muted">{t(locale, 'signup.codeSentBody')}</p>
          {verificationState === 'invalid' && <p class="mt-3 text-sm text-danger" role="alert">{t(locale, 'signup.invalidCode')}</p>}
          <form method="post" class="mt-6 space-y-4">
            <input type="hidden" name="action" value="verify" />
            <input type="hidden" name="intent_id" value={intentId} />
            <input type="hidden" name="public_id" value={publicId} />
            <label class="block"><span class={lab}>{t(locale, 'signup.codeLabel')}</span>
              <input name="code" required inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" class={tin} />
            </label>
            <button type="submit" class={btn}>{t(locale, 'signup.verify')}</button>
          </form>
        </div>
      ) : verificationState === 'neutral' ? (
        <div class="mt-6 space-y-2 rounded-lg border border-border bg-surface-raised p-6 text-ink">
          <p class="font-semibold">{t(locale, 'signup.codeSentTitle')}</p>
          <p>{t(locale, 'signup.codeSentBody')}</p>
        </div>
      ) : sent ? (
        <div class="mt-6 space-y-2 rounded-lg border border-success bg-success-soft p-6 text-success">
          <p class="font-semibold">{isDup ? t(locale, 'apply.alreadyPending') : t(locale, 'apply.sent')}</p>
          <p class="pt-2">
            <a href={localePath(locale, '/serve')} class="font-bold underline">
              {t(locale, 'apply.backToServe')}
            </a>
          </p>
        </div>
      ) : (
        <>
          <p class="mt-3 text-ink-muted">{t(locale, 'apply.intro')}</p>

          {!selectedTeam ? (
            <form method="get" class="mt-6 space-y-4">
              <label class="block">
                <span class={lab}>{t(locale, 'apply.team')}</span>
                <select name="team" required class={tin}>
                  <option value="">{t(locale, 'apply.selectTeam')}</option>
                  {teams.map((tm) => (
                    <option value={tm.id}>
                      {tm.ministry_name ? `${tm.ministry_name} — ` : ''}
                      {tm.name}
                    </option>
                  ))}
                </select>
              </label>
              <button type="submit" class={btn}>{t(locale, 'apply.continue')}</button>
            </form>
          ) : (
            <form method="post" class="mt-6 space-y-4">
              <input type="hidden" name="action" value="begin" />
              <input type="hidden" name="intent_id" value={intentId} />
              <input type="hidden" name="team_id" value={selectedTeam.id} />
              {/* Honeypot: hidden from humans, tempting for bots. */}
              <div aria-hidden="true" style="position:absolute;left:-9999px" tabindex="-1">
                <label>
                  Website
                  <input type="text" name="website" tabindex="-1" autocomplete="off" />
                </label>
              </div>

              {errorKeys.map((key) => (
                <p class={noticeErr}>{t(locale, key)}</p>
              ))}

              <p class="rounded-md border border-border bg-primary-soft px-4 py-2.5 font-semibold text-on-primary-soft">
                {selectedTeam.ministry_name ? `${selectedTeam.ministry_name} — ` : ''}
                {selectedTeam.name}
                <a href={localePath(locale, '/serve/apply')} class="ml-2 text-sm font-normal underline">
                  {t(locale, 'apply.changeTeam')}
                </a>
              </p>

              {positions.length > 0 && (
                <label class="block">
                  <span class={lab}>{t(locale, 'apply.position')} ({t(locale, 'my.optional')})</span>
                  <select name="position_id" class={tin}>
                    <option value="">{t(locale, 'apply.anyPosition')}</option>
                    {positions.map((p) => (
                      <option value={p.id}>{p.name}</option>
                    ))}
                  </select>
                </label>
              )}

              {!user && (
                <>
                  <label class="block">
                    <span class={lab}>{t(locale, 'apply.name')} *</span>
                    <input name="name" required class={tin} />
                  </label>
                  <label class="block">
                    <span class={lab}>{t(locale, 'apply.email')} *</span>
                    <input type="email" name="email" required class={tin} />
                  </label>
                  <label class="block">
                    <span class={lab}>{t(locale, 'apply.phone')} ({t(locale, 'my.optional')})</span>
                    <input name="phone" class={tin} />
                  </label>
                </>
              )}

              <label class="block">
                <span class={lab}>{t(locale, 'apply.message')} ({t(locale, 'my.optional')})</span>
                <textarea name="message" rows="3" class={tin} />
              </label>

              <button type="submit" class={btn}>{t(locale, 'apply.submit')}</button>
            </form>
          )}
        </>
      )
    }
  </div>
  <aside class="mw-panel mw-aside"><p class="mw-eyebrow">{copy.nextStep}</p><h2>{copy.applicationNext}</h2><p>{copy.applicationNextBody}</p>
    {selectedTeam && <div class="mt-5 border-t border-border pt-5"><strong>{selectedTeam.name}</strong>{selectedTeam.ministry_name && <p>{selectedTeam.ministry_name}</p>}</div>}
  </aside>
  </div>
</MinistryWorkspace>
</Base>
