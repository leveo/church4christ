---
// Events page: every currently-active, in-window event as a card grid. Uses the
// same windowing query as the home strip but without a limit. Reads fail soft to
// empty so a database hiccup degrades to the "nothing yet" state.
import Base from '../../../layouts/Base.astro';
import EventGrid from '../../../components/gatherings/EventCards.astro';
import GatheringHero from '../../../components/gatherings/GatheringHero.astro';
import { gatheringsCopy } from '../../../i18n/designGatherings';
import { DESIGN_IMAGES } from '../../../lib/designAssets';
import { localePath } from '../../../lib/locales';
import { btnSecondary } from '../../../lib/adminUi';
import { parseLocale } from '../../../lib/locales';
import { t } from '../../../lib/i18n';
import { todayInTz } from '../../../lib/dates';
import { listActiveEvents, type EventCardRow } from '../../../lib/publicDb';

const locale = parseLocale(Astro.params.locale ?? '');
if (!locale) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const copy = gatheringsCopy(locale);
let events: EventCardRow[] = [];
try {
  const db = Astro.locals.db;
  events = await listActiveEvents(db, locale, todayInTz());
} catch (err) {
  console.error('events index: load failed', err);
}
---

<Base title={t(locale, 'events.title')} locale={locale}>
  <GatheringHero title={t(locale, 'events.title')} intro={copy.eventsIntro} eyebrow={copy.eyebrow} image={DESIGN_IMAGES.events}>
    {Astro.locals.modules.has('registration') && <a href={localePath(locale, '/register')} class={btnSecondary}>{copy.exploreRegistration} →</a>}
  </GatheringHero>

  <div class="container-content pb-16 pt-4">
    <h2 class="mb-6 border-b border-border pb-4 text-sm font-semibold text-ink-muted">{copy.happening}</h2>
    {
      events.length > 0 ? (
        <EventGrid events={events} locale={locale} />
      ) : (
        <p class="rounded-md border border-border bg-surface-raised px-4 py-8 text-center text-ink-muted">
          {t(locale, 'events.empty')}
        </p>
      )
    }
  </div>
</Base>
