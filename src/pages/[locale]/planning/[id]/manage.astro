---
// Coordinator page for one planning event: details, status, the run-sheet editor
// (add / edit / delete / move up and down / copy from another event), and the
// event coordinators. Every write carries the revision the editor loaded, so a
// concurrent edit is rejected instead of silently overwritten. In-page
// authorization: planning admins and this event's coordinators; others get 404.
import { env } from 'cloudflare:workers';
import Member from '../../../../layouts/Member.astro';
import PlanningHeader from '../../../../components/planning/PlanningHeader.astro';
import { localePath, parseLocale, pickPair } from '../../../../lib/locales';
import { t } from '../../../../lib/i18n';
import { btn, btnDanger, btnSecondary, lab, noticeErr, noticeOk, rowBtn, tin } from '../../../../lib/adminUi';
import {
  addCoordinator,
  addItem,
  deleteItem,
  getEvent,
  getLinkedPlan,
  ITEM_KINDS,
  listCoordinators,
  listEvents,
  listItems,
  listPeopleByIds,
  listLinkablePlans,
  listPeopleLite,
  listTeams,
  moveItem,
  removeCoordinator,
  setEventStatus,
  updateEvent,
  updateItem,
  type EventStatus,
} from '../../../../lib/planningDb';
import { callableScope, canManage, copyRunSheetChecked, manageableEventIds, planningRole, restrictOwners, teamAllowed } from '../../../../lib/planningAccess';
import { parseEventForm, parseItemForm } from '../../../../lib/planningForms';
import { cancelEventSessions } from '../../../../lib/planningService';
import { loadRunSheetView } from '../../../../lib/planningView';
import { todayInTz } from '../../../../lib/dates';
import type { EmailEnv } from '../../../../lib/email';

const locale = parseLocale(Astro.params.locale ?? '');
if (!locale) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
const user = Astro.locals.user!;
const db = Astro.locals.db;
const id = /^\d+$/.test(Astro.params.id ?? '') ? Number(Astro.params.id) : null;
const event0 = id !== null ? await getEvent(db, id) : null;
const role = event0 ? await planningRole(db, user, event0) : null;
if (!event0 || !canManage(role)) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
const eventId = event0.id;
// Non-admin coordinators may only attach people and teams from teams they lead
// or that already own items; adding people and coordinators is admin-only.
const scope = await callableScope(db, user, eventId);
const isAdminRole = role === 'admin';
const idOf = (v: FormDataEntryValue | null): number | null => (/^\d+$/.test(String(v ?? '')) ? Number(v) : null);
const here = (query = '') => localePath(locale, `/planning/${eventId}/manage${query}`);

let errors: Record<string, string> = {};
let echo: Record<string, string> = {};
let editingItem: number | null = null;
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = String(fd.get('_action') ?? '');
  const rev = Number(fd.get('rev'));
  const outcome = (r: { ok: boolean; reason?: string }) =>
    Astro.redirect(here(r.ok ? '?saved=1' : r.reason === 'conflict' ? '?error=conflict' : '?error=missing'), 303);

  if (action === 'event') {
    const parsed = parseEventForm(fd);
    if (parsed.ok) return outcome(await updateEvent(db, eventId, rev, parsed.data));
    errors = parsed.errors;
  } else if (action === 'status') {
    const status = String(fd.get('status')) as EventStatus;
    if (status === 'draft' || status === 'published' || status === 'cancelled') {
      const result = await setEventStatus(db, eventId, rev, status);
      if (result.ok && status === 'cancelled') await cancelEventSessions(env as unknown as EmailEnv, db, eventId);
      return outcome(result);
    }
  } else if (action === 'add_item') {
    const parsed = parseItemForm(fd);
    if (parsed.ok) return outcome(await addItem(db, eventId, rev, restrictOwners(scope, parsed.data)));
    errors = parsed.errors;
    echo = Object.fromEntries([...fd.entries()].map(([k, v]) => [k, String(v)]));
  } else if (action === 'edit_item') {
    const itemId = idOf(fd.get('item_id'));
    const parsed = parseItemForm(fd);
    if (itemId && parsed.ok) {
      const existing = (await listItems(db, eventId)).find((i) => i.id === itemId) ?? null;
      return outcome(await updateItem(db, eventId, itemId, rev, restrictOwners(scope, parsed.data, existing)));
    }
    if (!parsed.ok) errors = parsed.errors;
    editingItem = itemId;
  } else if (action === 'delete_item') {
    const itemId = idOf(fd.get('item_id'));
    if (itemId) return outcome(await deleteItem(db, eventId, itemId, rev));
  } else if (action === 'move_item') {
    const itemId = idOf(fd.get('item_id'));
    const dir = fd.get('dir') === 'up' ? 'up' : 'down';
    if (itemId) return outcome(await moveItem(db, eventId, itemId, rev, dir));
  } else if (action === 'copy') {
    const sourceId = idOf(fd.get('source_id'));
    if (sourceId) {
      const result = await copyRunSheetChecked(db, user, eventId, sourceId, rev);
      return Astro.redirect(here(result.ok ? `?copied=${result.copied ?? 0}` : result.reason === 'conflict' ? '?error=conflict' : '?error=missing'), 303);
    }
  } else if (action === 'add_coordinator' && isAdminRole) {
    const personId = idOf(fd.get('person_id'));
    if (personId) await addCoordinator(db, eventId, personId);
    return Astro.redirect(here('?saved=1#coordinators'), 303);
  } else if (action === 'remove_coordinator' && isAdminRole) {
    const personId = idOf(fd.get('person_id'));
    if (personId) await removeCoordinator(db, eventId, personId);
    return Astro.redirect(here('?saved=1#coordinators'), 303);
  }
}

const event = (await getEvent(db, eventId))!;
const [view, allTeams, allPeople, coordinators, plan, plans, candidateEvents] = await Promise.all([
  loadRunSheetView(db, eventId, locale, null),
  listTeams(db, locale),
  listPeopleLite(db),
  listCoordinators(db, eventId),
  getLinkedPlan(db, event.plan_id),
  listLinkablePlans(db, todayInTz()),
  listEvents(db, { limit: 60 }),
]);
const rows = view?.rows ?? [];
const teams = allTeams.filter((tm) => teamAllowed(scope, tm.id) || rows.some((r) => r.item.owner_team_id === tm.id));
const currentOwners = rows.map((r) => r.item.owner_person_id).filter((x): x is number => x !== null);
const people = scope.people === null
  ? allPeople
  : await listPeopleByIds(db, [...new Set([...scope.people, ...currentOwners])]);
const manageable = await manageableEventIds(db, user, candidateEvents.map((e) => e.id));
const otherEvents = candidateEvents.filter((e) => manageable.has(e.id));
const summary = view!.summary;
const saved = Astro.url.searchParams.has('saved');
const copied = Astro.url.searchParams.get('copied');
const errorFlag = Astro.url.searchParams.get('error');
const errMsg = (field: string) => (errors[field] ? t(locale, errors[field]) : null);
const val = (key: string, fallback: string | number | null) => echo[key] ?? (fallback ?? '');
const kindLabel = (k: string) => t(locale, `planning.kind.${k}`);
const rev = event.revision;
const confirmAttr = (key: string) => `return confirm(${JSON.stringify(t(locale, key))})`;
---
<Member active="planning" title={pickPair(locale, event.title_en, event.title_zh)} locale={locale} noindex>
  <div class="member-content planning-page">
    <a href={localePath(locale, role === 'admin' ? '/admin/planning' : '/my')} class="inline-flex min-h-11 items-center text-sm text-ink-muted hover:text-primary">← {t(locale, 'planning.title')}</a>
    <PlanningHeader locale={locale} event={event} current="manage" manager={true} />

    {saved && <p class={`mt-4 ${noticeOk}`}>{t(locale, 'planning.saved')}</p>}
    {copied !== null && <p class={`mt-4 ${noticeOk}`}>{t(locale, 'planning.rs.copied', { n: copied })}</p>}
    {errorFlag === 'conflict' && <p class={`mt-4 ${noticeErr}`}>{t(locale, 'planning.conflict')}</p>}
    {errorFlag === 'missing' && <p class={`mt-4 ${noticeErr}`}>{t(locale, 'planning.missing')}</p>}

    <section class="mt-6 rounded-lg border border-border bg-surface-raised p-4">
      <h2 class="font-display font-semibold">{t(locale, 'planning.status.title')}</h2>
      <div class="mt-3 flex flex-wrap gap-2">
        {event.status !== 'published' && event.status !== 'cancelled' && (
          <form method="post"><input type="hidden" name="_action" value="status" /><input type="hidden" name="rev" value={rev} /><input type="hidden" name="status" value="published" /><button class={btn}>{t(locale, 'planning.status.publish')}</button></form>
        )}
        {event.status === 'published' && (
          <form method="post"><input type="hidden" name="_action" value="status" /><input type="hidden" name="rev" value={rev} /><input type="hidden" name="status" value="draft" /><button class={btnSecondary}>{t(locale, 'planning.status.unpublish')}</button></form>
        )}
        {event.status === 'cancelled' && (
          <form method="post"><input type="hidden" name="_action" value="status" /><input type="hidden" name="rev" value={rev} /><input type="hidden" name="status" value="draft" /><button class={btnSecondary}>{t(locale, 'planning.status.reopen')}</button></form>
        )}
        {event.status !== 'cancelled' && (
          <form method="post" onsubmit={confirmAttr('planning.status.confirmCancel')}><input type="hidden" name="_action" value="status" /><input type="hidden" name="rev" value={rev} /><input type="hidden" name="status" value="cancelled" /><button class={btnDanger}>{t(locale, 'planning.status.cancel')}</button></form>
        )}
      </div>
      <p class="mt-2 text-xs text-ink-subtle">{t(locale, 'planning.status.hint')}</p>
    </section>

    <details class="mt-6 rounded-lg border border-border bg-surface-raised p-4" open={Object.keys(errors).length > 0 && editingItem === null && !echo.kind}>
      <summary class="cursor-pointer font-display font-semibold">{t(locale, 'planning.f.details')}</summary>
      <form method="post" class="mt-4 grid gap-3 sm:grid-cols-2">
        <input type="hidden" name="_action" value="event" /><input type="hidden" name="rev" value={rev} />
        <label class="block"><span class={lab}>{t(locale, 'planning.f.titleEn')}</span><input name="title_en" value={event.title_en} class={tin} />{errMsg('title_en') && <p class="mt-1 text-sm text-danger">{errMsg('title_en')}</p>}</label>
        <label class="block"><span class={lab}>{t(locale, 'planning.f.titleZh')}</span><input name="title_zh" value={event.title_zh} class={tin} /></label>
        <label class="block"><span class={lab}>{t(locale, 'planning.f.date')}</span><input type="date" name="event_date" required value={event.event_date} class={tin} />{errMsg('event_date') && <p class="mt-1 text-sm text-danger">{errMsg('event_date')}</p>}</label>
        <div class="grid grid-cols-2 gap-3">
          <label class="block"><span class={lab}>{t(locale, 'planning.f.start')}</span><input type="time" name="start_time" required value={event.start_time} class={tin} /></label>
          <label class="block"><span class={lab}>{t(locale, 'planning.f.end')}</span><input type="time" name="end_time" value={event.end_time ?? ''} class={tin} />{errMsg('end_time') && <p class="mt-1 text-sm text-danger">{errMsg('end_time')}</p>}</label>
        </div>
        <label class="block"><span class={lab}>{t(locale, 'planning.f.locationEn')}</span><input name="location_en" value={event.location_en} class={tin} /></label>
        <label class="block"><span class={lab}>{t(locale, 'planning.f.locationZh')}</span><input name="location_zh" value={event.location_zh} class={tin} /></label>
        <label class="block"><span class={lab}>{t(locale, 'planning.f.notesEn')}</span><textarea name="notes_en" rows="3" class={tin}>{event.notes_en}</textarea></label>
        <label class="block"><span class={lab}>{t(locale, 'planning.f.notesZh')}</span><textarea name="notes_zh" rows="3" class={tin}>{event.notes_zh}</textarea></label>
        <label class="block sm:col-span-2"><span class={lab}>{t(locale, 'planning.f.plan')}</span>
          <select name="plan_id" class={tin}>
            <option value="">{t(locale, 'planning.f.planNone')}</option>
            {plan && !plans.some((p) => p.id === plan.id) && <option value={plan.id} selected>{plan.plan_date} {plan.title ?? ''}</option>}
            {plans.map((p) => <option value={p.id} selected={p.id === event.plan_id}>{p.plan_date} {p.title ?? ''}</option>)}
          </select>
          <span class="mt-1 block text-xs text-ink-subtle">{t(locale, 'planning.f.planHint')}</span>
        </label>
        <div class="sm:col-span-2"><button class={btn}>{t(locale, 'planning.save')}</button></div>
      </form>
    </details>

    <section id="runsheet" class="mt-8">
      <h2 class="font-display text-lg font-semibold">{t(locale, 'planning.rs.title')}</h2>
      <p class="mt-1 text-sm text-ink-muted">{t(locale, 'planning.rs.total', { total: summary.totalMin, end: summary.end })}</p>
      {summary.overrun && <p class={`mt-3 ${noticeErr}`}>{t(locale, 'planning.rs.overrun', { min: summary.overrunMin, end: summary.targetEnd ?? '' })}</p>}
      {summary.overlapCount > 0 && <p class={`mt-3 ${noticeErr}`}>{t(locale, 'planning.rs.overlapSummary', { n: summary.overlapCount })}</p>}

      <ol class="mt-4 grid gap-3">
        {rows.map((r, index) => (
          <li class="rounded-lg border border-border bg-surface-raised p-3">
            <div class="flex flex-wrap items-center gap-2">
              <span class="tabular-nums font-semibold">{r.timing.start}</span>
              <span class="text-sm text-ink-muted tabular-nums">{r.item.duration_min > 0 ? t(locale, 'planning.rs.min', { n: r.item.duration_min }) : ''}</span>
              <span class="rounded-full bg-surface-sunken px-2 py-0.5 text-xs">{kindLabel(r.item.kind)}</span>
              <strong class="min-w-0 flex-1 basis-40">{r.title}</strong>
              {r.timing.overlap && <span class="text-sm text-danger">{t(locale, 'planning.rs.overlap', { min: r.timing.overlapMin })}</span>}
            </div>
            {r.owner && <p class="mt-1 text-sm text-ink-muted">{r.owner}</p>}
            <div class="mt-2 flex flex-wrap gap-2">
              <form method="post"><input type="hidden" name="_action" value="move_item" /><input type="hidden" name="rev" value={rev} /><input type="hidden" name="item_id" value={r.item.id} /><input type="hidden" name="dir" value="up" /><button class={`${rowBtn} planning-touch`} disabled={index === 0} aria-label={t(locale, 'planning.rs.moveUp')}>↑ {t(locale, 'planning.rs.moveUp')}</button></form>
              <form method="post"><input type="hidden" name="_action" value="move_item" /><input type="hidden" name="rev" value={rev} /><input type="hidden" name="item_id" value={r.item.id} /><input type="hidden" name="dir" value="down" /><button class={`${rowBtn} planning-touch`} disabled={index === rows.length - 1} aria-label={t(locale, 'planning.rs.moveDown')}>↓ {t(locale, 'planning.rs.moveDown')}</button></form>
              <form method="post" onsubmit={confirmAttr('planning.rs.confirmDelete')}><input type="hidden" name="_action" value="delete_item" /><input type="hidden" name="rev" value={rev} /><input type="hidden" name="item_id" value={r.item.id} /><button class={`${rowBtn} planning-touch text-danger`}>{t(locale, 'planning.rs.delete')}</button></form>
            </div>
            <details class="mt-2" open={editingItem === r.item.id}>
              <summary class="cursor-pointer text-sm font-semibold text-primary">{t(locale, 'planning.rs.edit')}</summary>
              <form method="post" class="mt-3 grid gap-3 sm:grid-cols-2">
                <input type="hidden" name="_action" value="edit_item" /><input type="hidden" name="rev" value={rev} /><input type="hidden" name="item_id" value={r.item.id} />
                <label class="block"><span class={lab}>{t(locale, 'planning.f.titleEn')}</span><input name="title_en" value={r.item.title_en} class={tin} /></label>
                <label class="block"><span class={lab}>{t(locale, 'planning.f.titleZh')}</span><input name="title_zh" value={r.item.title_zh} class={tin} /></label>
                <label class="block"><span class={lab}>{t(locale, 'planning.rs.kind')}</span><select name="kind" class={tin}>{ITEM_KINDS.map((k) => <option value={k} selected={k === r.item.kind}>{kindLabel(k)}</option>)}</select></label>
                <div class="grid grid-cols-2 gap-3">
                  <label class="block"><span class={lab}>{t(locale, 'planning.rs.durationMin')}</span><input type="number" inputmode="numeric" name="duration_min" min="0" max="720" value={r.item.duration_min} class={tin} /></label>
                  <label class="block"><span class={lab}>{t(locale, 'planning.rs.fixedStart')}</span><input type="time" name="fixed_start_time" value={r.item.fixed_start_time ?? ''} class={tin} /></label>
                </div>
                <label class="block"><span class={lab}>{t(locale, 'planning.rs.ownerTeam')}</span><select name="owner_team_id" class={tin}><option value="">—</option>{teams.map((tm) => <option value={tm.id} selected={tm.id === r.item.owner_team_id}>{tm.name}</option>)}</select></label>
                <label class="block"><span class={lab}>{t(locale, 'planning.rs.ownerPerson')}</span><select name="owner_person_id" class={tin}><option value="">—</option>{people.map((p) => <option value={p.id} selected={p.id === r.item.owner_person_id}>{p.display_name}</option>)}</select></label>
                <label class="block sm:col-span-2"><span class={lab}>{t(locale, 'planning.rs.ownerLabel')}</span><input name="owner_label" value={r.item.owner_label ?? ''} class={tin} /></label>
                <label class="block"><span class={lab}>{t(locale, 'planning.rs.detailsEn')}</span><textarea name="details_en" rows="2" class={tin}>{r.item.details_en}</textarea></label>
                <label class="block"><span class={lab}>{t(locale, 'planning.rs.detailsZh')}</span><textarea name="details_zh" rows="2" class={tin}>{r.item.details_zh}</textarea></label>
                <label class="block sm:col-span-2"><span class={lab}>{t(locale, 'planning.rs.cue')}</span><textarea name="cue_notes" rows="2" class={tin}>{r.item.cue_notes}</textarea><span class="mt-1 block text-xs text-ink-subtle">{t(locale, 'planning.rs.cueHint')}</span></label>
                {editingItem === r.item.id && Object.values(errors).length > 0 && <p class="sm:col-span-2 text-sm text-danger">{[...new Set(Object.values(errors))].map((k) => t(locale, k)).join(' ')}</p>}
                <div class="sm:col-span-2"><button class={btn}>{t(locale, 'planning.save')}</button></div>
              </form>
            </details>
          </li>
        ))}
      </ol>

      <details class="mt-4 rounded-lg border border-border bg-surface-raised p-4" open={Boolean(echo.kind)}>
        <summary class="cursor-pointer font-display font-semibold">{t(locale, 'planning.rs.add')}</summary>
        <form method="post" class="mt-3 grid gap-3 sm:grid-cols-2">
          <input type="hidden" name="_action" value="add_item" /><input type="hidden" name="rev" value={rev} />
          <label class="block"><span class={lab}>{t(locale, 'planning.f.titleEn')}</span><input name="title_en" value={val('title_en', '')} class={tin} />{echo.kind && errMsg('title_en') && <p class="mt-1 text-sm text-danger">{errMsg('title_en')}</p>}</label>
          <label class="block"><span class={lab}>{t(locale, 'planning.f.titleZh')}</span><input name="title_zh" value={val('title_zh', '')} class={tin} /></label>
          <label class="block"><span class={lab}>{t(locale, 'planning.rs.kind')}</span><select name="kind" class={tin}>{ITEM_KINDS.map((k) => <option value={k} selected={k === (echo.kind ?? 'segment')}>{kindLabel(k)}</option>)}</select></label>
          <div class="grid grid-cols-2 gap-3">
            <label class="block"><span class={lab}>{t(locale, 'planning.rs.durationMin')}</span><input type="number" inputmode="numeric" name="duration_min" min="0" max="720" value={val('duration_min', 5)} class={tin} />{echo.kind && errMsg('duration_min') && <p class="mt-1 text-sm text-danger">{errMsg('duration_min')}</p>}</label>
            <label class="block"><span class={lab}>{t(locale, 'planning.rs.fixedStart')}</span><input type="time" name="fixed_start_time" value={val('fixed_start_time', '')} class={tin} /></label>
          </div>
          <label class="block"><span class={lab}>{t(locale, 'planning.rs.ownerTeam')}</span><select name="owner_team_id" class={tin}><option value="">—</option>{teams.map((tm) => <option value={tm.id}>{tm.name}</option>)}</select></label>
          <label class="block"><span class={lab}>{t(locale, 'planning.rs.ownerPerson')}</span><select name="owner_person_id" class={tin}><option value="">—</option>{people.map((p) => <option value={p.id}>{p.display_name}</option>)}</select></label>
          <label class="block sm:col-span-2"><span class={lab}>{t(locale, 'planning.rs.ownerLabel')}</span><input name="owner_label" value={val('owner_label', '')} class={tin} /></label>
          <label class="block"><span class={lab}>{t(locale, 'planning.rs.detailsEn')}</span><textarea name="details_en" rows="2" class={tin}>{val('details_en', '')}</textarea></label>
          <label class="block"><span class={lab}>{t(locale, 'planning.rs.detailsZh')}</span><textarea name="details_zh" rows="2" class={tin}>{val('details_zh', '')}</textarea></label>
          <label class="block sm:col-span-2"><span class={lab}>{t(locale, 'planning.rs.cue')}</span><textarea name="cue_notes" rows="2" class={tin}>{val('cue_notes', '')}</textarea><span class="mt-1 block text-xs text-ink-subtle">{t(locale, 'planning.rs.cueHint')}</span></label>
          <div class="sm:col-span-2"><button class={btn}>{t(locale, 'planning.rs.addButton')}</button></div>
        </form>
      </details>

      <form method="post" class="mt-4 flex flex-wrap items-end gap-3 rounded-lg border border-border bg-surface-raised p-4">
        <input type="hidden" name="_action" value="copy" /><input type="hidden" name="rev" value={rev} />
        <label class="block min-w-48 flex-1"><span class={lab}>{t(locale, 'planning.rs.copyFrom')}</span>
          <select name="source_id" class={tin}>{otherEvents.filter((e) => e.id !== eventId).map((e) => <option value={e.id}>{e.event_date} · {pickPair(locale, e.title_en, e.title_zh)}</option>)}</select>
        </label>
        <button class={btnSecondary} disabled={otherEvents.filter((e) => e.id !== eventId).length === 0}>{t(locale, 'planning.rs.copy')}</button>
      </form>
    </section>

    <section id="coordinators" class="mt-8 rounded-lg border border-border bg-surface-raised p-4">
      <h2 class="font-display font-semibold">{t(locale, 'planning.coord.title')}</h2>
      <p class="mt-1 text-sm text-ink-muted">{t(locale, 'planning.coord.intro')}</p>
      <ul class="mt-3 divide-y divide-border">
        {coordinators.map((p) => (
          <li class="flex items-center justify-between gap-3 py-2 text-sm">
            <span>{p.display_name}</span>
            {isAdminRole && <form method="post"><input type="hidden" name="_action" value="remove_coordinator" /><input type="hidden" name="person_id" value={p.id} /><button class={`${rowBtn} planning-touch text-danger`}>{t(locale, 'planning.coord.remove')}</button></form>}
          </li>
        ))}
        {coordinators.length === 0 && <li class="py-2 text-sm text-ink-muted">{t(locale, 'planning.coord.none')}</li>}
      </ul>
      {isAdminRole && <form method="post" class="mt-3 flex flex-wrap items-end gap-3">
        <input type="hidden" name="_action" value="add_coordinator" />
        <label class="block min-w-48 flex-1"><span class={lab}>{t(locale, 'planning.coord.add')}</span><select name="person_id" class={tin}>{allPeople.map((p) => <option value={p.id}>{p.display_name}</option>)}</select></label>
        <button class={btnSecondary}>{t(locale, 'planning.coord.addButton')}</button>
