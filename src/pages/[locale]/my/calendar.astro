---
// Personal serving calendar (authed via route policy): a server-rendered month
// grid (?month=YYYY-MM navigation) with assignment dots + blockout shading, and
// the iCal subscribe box. Ported from the reference stack's src/pages/my/calendar.astro,
// except the calendar token is an explicit Generate/Regenerate action (32 hex
// chars) instead of create-on-view — regenerating invalidates the old URL.
import Member from '../../../layouts/Member.astro';
import MemberPageHeader from '../../../components/ui/MemberPageHeader.astro';
import { memberCopy } from '../../../i18n/designMember';
import MonthCalendar from '../../../components/MonthCalendar.astro';
import { buildCalendarMarks } from '../../../lib/calendar';
import { localePath, parseLocale } from '../../../lib/locales';
import { t } from '../../../lib/i18n';
import { listBlockouts, listPersonAssignments } from '../../../lib/myDb';
import { generateCalendarToken, getCalendarToken } from '../../../lib/ical';
import { formatDate, formatMonth, monthRange, todayInTz, utcToDatetimeLocal } from '../../../lib/dates';
import { btn, btnSecondary, tin } from '../../../lib/adminUi';
import { listUpcomingOccurrencesForPerson } from '../../../lib/groupEventDb';
import { listRegistrationsForPerson } from '../../../lib/regDb';

const GROUP_TZ = 'America/Chicago';

const locale = parseLocale(Astro.params.locale ?? '');
if (!locale) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
const user = Astro.locals.user!;
const db = Astro.locals.db;

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  if (fd.get('_action') === 'token') {
    // Generate or rotate the person's OWN feed token (session id, never posted).
    await generateCalendarToken(db, user.id);
  }
  const month = String(fd.get('month') ?? '');
  const suffix = /^\d{4}-\d{2}$/.test(month) ? `?month=${month}` : '';
  return Astro.redirect(localePath(locale, `/my/calendar${suffix}`), 303);
}

const today = todayInTz();
const monthParam = Astro.url.searchParams.get('month') ?? '';
const [year, month] = /^\d{4}-\d{2}$/.test(monthParam)
  ? [Number(monthParam.slice(0, 4)), Number(monthParam.slice(5, 7))]
  : [Number(today.slice(0, 4)), Number(today.slice(5, 7))];
if (month < 1 || month > 12) return Astro.redirect(localePath(locale, '/my/calendar'), 303);

const ym = `${year}-${String(month).padStart(2, '0')}`;
const { start: monthStart, end: monthEnd } = monthRange(ym);

// Portal group-event occurrences + (when registration is also on) the viewer's
// own event registrations, gated on the module so the D1 backend (portal always
// off there) never adds those marks. Ported from the reference /my/calendar,
// swapping the occurrence source to this repo's materialized occurrences.
const hasPortal = Astro.locals.modules.has('portal');
const hasRegistration = hasPortal && Astro.locals.modules.has('registration');
const [assignments, blockouts, calToken, occurrences, registrations] = await Promise.all([
  listPersonAssignments(db, user.id, monthStart, locale).then((rows) => rows.filter((a) => a.plan_date <= monthEnd)),
  listBlockouts(db, user.id, monthStart).then((rows) => rows.filter((b) => b.start_date <= monthEnd)),
  getCalendarToken(db, user.id),
  hasPortal ? listUpcomingOccurrencesForPerson(db, user.id, monthStart, monthEnd) : Promise.resolve([]),
  hasRegistration ? listRegistrationsForPerson(db, locale, user.id, user.email) : Promise.resolve([]),
]);
// starts_at/ends_at are UTC 'YYYY-MM-DD HH:MM:SS'; convert to church-local before
// taking the date so a late-evening UTC instant lands on the correct local day.
const meetings = occurrences.map((o) => {
  const local = utcToDatetimeLocal(o.starts_at, GROUP_TZ);
  return { date: local.slice(0, 10), title: [o.group_name, o.title, local.slice(11, 16), o.location].filter(Boolean).join(' · ') };
});
const events = registrations
  .map((r) => ({ date: utcToDatetimeLocal(r.starts_at, GROUP_TZ).slice(0, 10), title: r.event_title }))
  .filter((e) => e.date.slice(0, 7) === ym);
const marks = buildCalendarMarks(assignments, blockouts, ym, { events, meetings });

const prev = month === 1 ? `${year - 1}-12` : `${year}-${String(month - 1).padStart(2, '0')}`;
const next = month === 12 ? `${year + 1}-01` : `${year}-${String(month + 1).padStart(2, '0')}`;

// The feed URL is NOT locale-prefixed (public token route); webcal:// makes a
// click subscribe in Apple/Google Calendar, the https URL is for copy-paste.
const icsPath = calToken ? `/cal/${calToken}.ics` : null;
const webcalUrl = icsPath ? `webcal://${Astro.url.host}${icsPath}` : null;
const httpsUrl = icsPath ? new URL(icsPath, Astro.url.origin).href : null;
---

<Member active="calendar" title={t(locale, 'my.calendar')} locale={locale} noindex>
  <div class="member-content">
<MemberPageHeader title={t(locale, 'my.calendar')} description={memberCopy(locale).calendarIntro} />
    <div class="mt-2 flex items-center gap-4">
      <h2 class="text-xl font-semibold">{formatMonth(ym, locale)}</h2>
      <div class="ml-auto flex gap-2 text-sm">
        <a href={localePath(locale, `/my/calendar?month=${prev}`)} class={btnSecondary}>{t(locale, 'my.cal.prev')}</a>
        <a href={localePath(locale, `/my/calendar?month=${next}`)} class={btnSecondary}>{t(locale, 'my.cal.next')}</a>
      </div>
    </div>

    <div class="member-calendar-grid"><div>
    <div class="mt-6">
      <MonthCalendar locale={locale} year={year} month={month} marks={marks} today={today} />
    </div>

    </div><aside class="calendar-agenda">
      <h2 class="font-semibold">{memberCopy(locale).calendarAgenda}</h2>
      <ul class="mt-4 divide-y divide-border">
        {assignments.map(a => <li class="py-3 text-sm"><time class="block text-xs text-ink-muted" datetime={a.plan_date}>{formatDate(a.plan_date, locale)}</time><p class="mt-1 font-medium">{a.position_name}</p><p class="mt-1 text-xs text-ink-muted">{a.team_name} · {t(locale, `serve.status.${a.status}`)}</p></li>)}
        {[...events, ...meetings].sort((a, b) => a.date.localeCompare(b.date)).map(item => <li class="py-3 text-sm"><time class="block text-xs text-ink-muted" datetime={item.date}>{formatDate(item.date, locale)}</time><p class="mt-1 font-medium">{item.title}</p></li>)}
      </ul>
      {assignments.length === 0 && events.length === 0 && meetings.length === 0 && <p class="mt-3 text-sm text-ink-muted">{t(locale, 'my.noUpcoming')}</p>}
      <a href={localePath(locale, '/my/blockouts')} class={`mt-4 ${btnSecondary}`}>{t(locale, 'my.blockouts')}</a>
    </aside></div>
    <div class="mt-8 rounded-lg border border-border bg-surface-raised p-6">
      <p class="font-display font-semibold">{t(locale, 'my.cal.subscribeTitle')}</p>
      <p class="mt-1 text-sm text-ink-muted">{t(locale, 'my.cal.subscribeIntro')}</p>
      {
        webcalUrl && httpsUrl ? (
          <>
            <div class="mt-3 flex flex-wrap items-center gap-2">
              <a href={webcalUrl} class={btn}>
                {t(locale, 'my.cal.subscribe')}
              </a>
              <input
                readonly
                value={httpsUrl}
                onclick="this.select()"
                aria-label={t(locale, 'my.cal.subscribeTitle')}
                class={`${tin} min-w-52 flex-1 text-xs text-ink-muted`}
              />
            </div>
            <form method="post" class="mt-3">
              <input type="hidden" name="_action" value="token" />
              <input type="hidden" name="month" value={ym} />
              <button type="submit" class={btnSecondary}>{t(locale, 'my.cal.regenerate')}</button>
            </form>
            <p class="mt-2 text-xs text-ink-subtle">{t(locale, 'my.cal.regenerateHint')}</p>
          </>
        ) : (
          <form method="post" class="mt-3">
            <input type="hidden" name="_action" value="token" />
            <input type="hidden" name="month" value={ym} />
            <button type="submit" class={btn}>{t(locale, 'my.cal.generate')}</button>
          </form>
        )
      }
    </div>
  </div>
</Member>

<style>
  .member-calendar-grid { display: grid; grid-template-columns: minmax(0, 1fr) 220px; gap: 1.5rem; }
  .calendar-agenda { margin-top: 1.5rem; padding: 1.2rem; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface-raised); align-self: start; }
  @media (max-width: 1199px) { .member-calendar-grid { grid-template-columns: 1fr; } }
</style>
