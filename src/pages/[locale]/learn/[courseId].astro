---
// The course shell fails non-disclosing while enrollment-scoped persistence is
// not present. Task 9 replaces this response with a person-scoped SQL lookup.
export const prerender = false;

const modules = Astro.locals.modules;
if (!modules.has('learning')) {
  return new Response(null, { status: 404, headers: { 'cache-control': 'no-store' } });
}
const user = Astro.locals.user;
if (!user) {
  return new Response(null, { status: 401, headers: { 'cache-control': 'no-store' } });
}
return new Response(null, { status: 404, headers: { 'cache-control': 'no-store' } });
---
