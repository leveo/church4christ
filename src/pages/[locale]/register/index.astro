---
import GatheringSurface from '../../../components/gatherings/GatheringSurface.astro';
import { gatheringsCopy } from '../../../i18n/designGatherings';
import GatheringHero from '../../../components/gatherings/GatheringHero.astro';
import RegistrationEventCards from '../../../components/gatherings/RegistrationEventCards.astro';
import { DESIGN_IMAGES } from '../../../lib/designAssets';

// Public registration index: every visible upcoming event as a card (poster, title,
// date, location, price-or-Free). Events not open yet show "Registration opens ...";
// a full event shows Full, or "Join the waitlist" when it is free and has a waitlist.
// Reads fail soft to empty so a database hiccup degrades to the "nothing open" state
// rather than 500ing. Owned by the `registration` module — the middleware 404s this
// route when the module is off.
import Base from '../../../layouts/Base.astro';
import { parseLocale } from '../../../lib/locales';
import { t } from '../../../lib/i18n';
import { listPublicEvents, listTicketTypes, type RegPublicEvent } from '../../../lib/regDb';
import { seatState, type SeatState } from '../../../lib/regPublic';

const locale = parseLocale(Astro.params.locale ?? '');
if (!locale) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const copy = gatheringsCopy(locale);
let events: RegPublicEvent[] = [];
// Full = the event's capacity is reached or every active ticket type is at its limit.
const seats = new Map<number, SeatState>();
try {
  events = await listPublicEvents(Astro.locals.db, locale);
  await Promise.all(events.filter((e) => e.phase === 'open').map(async (e) => {
    seats.set(e.id, seatState(e, await listTicketTypes(Astro.locals.db, locale, e.id, { activeOnly: true })));
  }));
} catch (err) {
  console.error('register index: load failed', err);
}

---

<Base title={t(locale, 'register.title')} locale={locale}>
  <GatheringSurface mode="public">
  <GatheringHero title={t(locale, 'register.title')} intro={copy.registrationIntro} eyebrow={copy.eyebrow} image={DESIGN_IMAGES.events} />
  <div class="container-content py-10">
    {
      events.length > 0 ? (
        <RegistrationEventCards locale={locale} events={events} seats={seats} />
      ) : (
        <p class="rounded-md border border-border bg-surface-raised px-4 py-8 text-center text-ink-muted">
          {t(locale, 'register.empty')}
        </p>
      )
    }
  </div>
  </GatheringSurface>
</Base>
