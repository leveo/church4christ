---
import GatheringSurface from '../../../components/gatherings/GatheringSurface.astro';
import { gatheringsCopy } from '../../../i18n/designGatherings';
import GatheringHero from '../../../components/gatherings/GatheringHero.astro';
import DateBadge from '../../../components/gatherings/DateBadge.astro';
import { DESIGN_IMAGES } from '../../../lib/designAssets';

// Public registration index: every visible upcoming event as a card (poster, title,
// date, location, price-or-Free). Events not open yet show "Registration opens ...";
// a full event shows Full, or "Join the waitlist" when it is free and has a waitlist.
// Reads fail soft to empty so a database hiccup degrades to the "nothing open" state
// rather than 500ing. Owned by the `registration` module — the middleware 404s this
// route when the module is off.
import Base from '../../../layouts/Base.astro';
import { localePath, parseLocale } from '../../../lib/locales';
import { t } from '../../../lib/i18n';
import { formatDate, utcToDatetimeLocal } from '../../../lib/dates';
import { listPublicEvents, type RegPublicEvent } from '../../../lib/regDb';
import { isEventFull, offersWaitlist } from '../../../lib/regPhase';
import { mediaPath } from '../../../lib/mediaRef';
import { badge, badgeInactive, badgeScheduled } from '../../../lib/adminUi';

const locale = parseLocale(Astro.params.locale ?? '');
if (!locale) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const copy = gatheringsCopy(locale);
let events: RegPublicEvent[] = [];
try {
  events = await listPublicEvents(Astro.locals.db, locale);
} catch (err) {
  console.error('register index: load failed', err);
}

const priceLabel = (e: RegPublicEvent) =>
  e.price_cents !== null && e.price_cents > 0 ? `$${(e.price_cents / 100).toFixed(2)}` : t(locale, 'register.free');
// Event times are stored in UTC; people read them in the church's time zone.
const stamp = (utc: string) => {
  const [date, time] = utcToDatetimeLocal(utc).split('T');
  return `${formatDate(date, locale)} ${time}`;
};
const when = (e: RegPublicEvent) => stamp(e.starts_at);
---

<Base title={t(locale, 'register.title')} locale={locale}>
  <GatheringSurface mode="public">
  <GatheringHero title={t(locale, 'register.title')} intro={copy.registrationIntro} eyebrow={copy.eyebrow} image={DESIGN_IMAGES.events} />
  <div class="container-content py-10">
    {
      events.length > 0 ? (
        <ul class="gathering-registration-list">
          {events.map((e) => (
            <li class="gathering-registration-card"><DateBadge date={utcToDatetimeLocal(e.starts_at)} locale={locale} /><div>
              {mediaPath(e.poster) && <img src={mediaPath(e.poster)!} alt="" class="gathering-registration-card-poster" loading="lazy" />}
              <div class="flex items-start justify-between gap-3">
                <h2 class="font-display text-lg font-bold">
                  <a href={localePath(locale, `/register/${e.id}`)} class="hover:underline">
                    {e.title}
                  </a>
                </h2>
                {e.phase === 'open' && isEventFull(e) && (
                  offersWaitlist(e)
                    ? <span class={`${badge} ${badgeScheduled}`}>{t(locale, 'register.joinWaitlist')}</span>
                    : <span class={`${badge} ${badgeInactive}`}>{t(locale, 'register.full')}</span>
                )}
              </div>
              <p class="mt-2 text-sm text-ink-muted">{when(e)}</p>
              {e.location && <p class="text-sm text-ink-muted">{e.location}</p>}
              {e.phase === 'preview' && e.opens_at && <p class="mt-1 text-sm font-semibold text-primary">{t(locale, 'register.opensOn', { date: stamp(e.opens_at) })}</p>}
              <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-border pt-3"><p class="text-sm font-semibold">{priceLabel(e)}</p><a href={localePath(locale, `/register/${e.id}`)} class="text-xs font-semibold text-primary hover:underline">{copy.reviewDetails} →</a></div>
            </div></li>
          ))}
        </ul>
      ) : (
        <p class="rounded-md border border-border bg-surface-raised px-4 py-8 text-center text-ink-muted">
          {t(locale, 'register.empty')}
        </p>
      )
    }
  </div>
  </GatheringSurface>
</Base>
