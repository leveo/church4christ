---
// Single article: title band + author/date byline, prose body, back link.
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import DesignImage from '../../../components/ui/DesignImage.astro';
import Icon from '../../../components/ui/Icon.astro';
import { publicCopy } from '../../../i18n/designPublic';
import { localePath, parseLocale } from '../../../lib/locales';
import { t } from '../../../lib/i18n';
import { formatDate } from '../../../lib/dates';
import { getLocalized } from '../../../lib/content';

const locale = parseLocale(Astro.params.locale ?? '');
if (!locale) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const slug = Astro.params.slug ?? '';
const found = await getLocalized('articles', slug, locale, Astro.locals.db);
if (!found) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
const { entry, translated } = found;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.excerpt} locale={locale}>
  <div class="container-wide article-reader">
    <nav class="article-back"><a href={localePath(locale, '/articles')}>{t(locale, 'articles.back')}</a></nav>
    <header class="article-heading">
      <p class="section-eyebrow">{publicCopy(locale).articlesEyebrow}</p>
      <h1>{entry.data.title}</h1>
      {entry.data.excerpt && <p class="article-deck">{entry.data.excerpt}</p>}
      <p class="article-byline">{t(locale, 'articles.byline', { author: entry.data.author, date: formatDate(entry.data.date, locale) })}</p>
    </header>
    <div class="article-reading-grid">
      <aside class="article-note" aria-label={t(locale, 'articles.title')}><Icon name="book" size={24}/><p>{t(locale, 'articles.title')}</p><time datetime={entry.data.date}>{formatDate(entry.data.date, locale)}</time><a href={localePath(locale, '/articles')}>{t(locale, 'articles.back')}</a></aside>
      <div class="article-body">
        {!translated && <p class="translation-note">{t(locale, 'content.notTranslated')}</p>}
        <article class="prose"><Content /></article>
        <nav class="article-end"><a href={localePath(locale, '/articles')}>{t(locale, 'articles.back')}<Icon name="arrow" size={18}/></a></nav>
      </div>
      <div class="article-art" aria-hidden="true"><DesignImage image="sermons" class="h-full w-full object-cover" /></div>
    </div>
  </div>
</Base>
<style>
  .article-reader { padding-block: 2rem 4rem; }
  .article-back a { min-height: 44px; display: inline-flex; align-items: center; font-size: .85rem; color: var(--color-primary); }
  .article-back a:hover { text-decoration: underline; }
  .article-heading { max-width: 52rem; margin: 2.5rem auto 3rem; text-align: center; }
  .article-heading > p:first-child { justify-content: center; }
  h1 { margin-top: 1.25rem; font-family: var(--font-display); font-size: clamp(2.4rem, 5vw, 4.3rem); letter-spacing: -.035em; line-height: 1.1; color: var(--color-primary); overflow-wrap: anywhere; }
  .article-deck { max-width: 44rem; margin: 1.5rem auto 0; font-size: 1.15rem; line-height: 1.8; color: var(--color-ink-muted); }
  .article-byline { margin-top: 1.6rem; font-size: .85rem; color: var(--color-ink-muted); }
  .article-reading-grid { display: grid; grid-template-columns: minmax(130px, .6fr) minmax(0, 3fr) minmax(100px, .55fr); gap: 2.5rem; align-items: start; border-top: 1px solid var(--color-border); padding-top: 2.5rem; }
  .article-note { display: grid; gap: 1rem; color: var(--color-ink-muted); font-size: .8rem; position: sticky; top: 7rem; }
  .article-note > p { color: var(--color-primary); font-weight: 600; }
  .article-note a { padding-block: .5rem; text-decoration: underline; text-underline-offset: .25rem; }
  .article-body { min-width: 0; max-width: 45rem; }
  .article-body :global(.prose) { font-size: 1.08rem; line-height: 1.9; }
  .article-art { height: 250px; overflow: hidden; border-radius: var(--radius-lg); }
  .translation-note { padding: 1rem; margin-bottom: 1.5rem; border-radius: var(--radius-md); background: var(--color-info-soft); color: var(--color-info); font-size: .85rem; }
  .article-end { margin-top: 3rem; border-top: 1px solid var(--color-border); padding-top: 1.5rem; }
  .article-end a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; color: var(--color-primary); font-weight: 600; }
  @media (max-width: 1000px) { .article-reading-grid { grid-template-columns: 150px minmax(0, 1fr); } .article-art { display: none; } }
  @media (max-width: 650px) { .article-reading-grid { grid-template-columns: 1fr; padding-top: 1.75rem; } .article-note { display: none; } .article-heading { margin-block: 1.5rem 2rem; text-align: left; } .article-heading > p:first-child { justify-content: flex-start; } }
  @media print { .article-back, .article-note, .article-art, .article-end { display: none; } .article-reading-grid { display: block; } }
</style>
