---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import { beginStepUp, completeStepUp } from '../../lib/identityAccount';
import { identityTrustedRequestContext, type IdentityAuthEnv } from '../../lib/identityAuth';
import { IDENTITY_DEVICE_COOKIE, resolveIdentityDeviceCookie } from '../../lib/identityDeviceCookie';
import { sendIdentityStepUpOtp } from '../../lib/identityNotify';
import { mintSession } from '../../lib/session';
import type { EmailEnv } from '../../lib/email';
import { localePath, parseLocale } from '../../lib/locales';
import { t } from '../../lib/i18n';

const parsedLocale = parseLocale(Astro.params.locale ?? '');
if (!parsedLocale) { Astro.response.status = 404; return Astro.rewrite('/404'); }
const locale = parsedLocale;
const user = Astro.locals.user!;
const campus = Astro.locals.campusMode === 'campus' ? Astro.locals.campus : null;
type ReauthEnv = EmailEnv & IdentityAuthEnv & { SESSION_SECRET?: string };
const vars = env as unknown as ReauthEnv;

/** Only carry a same-site, locale-prefixed absolute path forward. */
function safeNext(value: string | null): string {
  const fallback = localePath(locale, '/settings/security');
  if (!value || !value.startsWith(`/${locale}/`) || value.startsWith('//') || value.includes('\\')) return fallback;
  try {
    const parsed = new URL(value, Astro.url.origin);
    return parsed.origin === Astro.url.origin && parsed.pathname.startsWith(`/${locale}/`) ? `${parsed.pathname}${parsed.search}` : fallback;
  } catch { return fallback; }
}
async function deviceId(): Promise<string> {
  const resolved = await resolveIdentityDeviceCookie(vars, Astro.cookies.get(IDENTITY_DEVICE_COOKIE)?.value);
  if (resolved.replaced) {
    Astro.cookies.set(IDENTITY_DEVICE_COOKIE, resolved.cookieValue, { path: '/', httpOnly: true, secure: import.meta.env.PROD, sameSite: 'lax', maxAge: 365 * 24 * 60 * 60 });
  }
  return resolved.deviceId;
}

const destination = safeNext(Astro.url.searchParams.get('next'));
let publicId = '';
let state: 'start' | 'sent' | 'invalid' = 'start';
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = String(fd.get('_action') ?? '');
  if (!campus) return Astro.redirect(localePath(locale, '/signin'), 303);
  if (action === 'begin') {
    try {
      const begun = await beginStepUp(Astro.locals.db, vars, { campusId: campus.id, personId: user.id,
        requestContext: identityTrustedRequestContext(Astro.request.headers, await deviceId()), source: 'web' });
      await sendIdentityStepUpOtp(vars, Astro.locals.db, begun.delivery, locale);
      publicId = begun.delivery.publicId; state = 'sent';
    } catch { state = 'sent'; }
  } else if (action === 'complete') {
    publicId = String(fd.get('public_id') ?? '');
    const completed = await completeStepUp(Astro.locals.db, vars, { campusId: campus.id, personId: user.id, publicId,
      code: String(fd.get('code') ?? ''), source: 'web' });
    if (completed.status === 'verified' && vars.SESSION_SECRET) {
      const assurance = Astro.locals.assurance;
      const preserve = assurance?.schemaVersion === 2 && assurance.authTime !== null && assurance.authMethod !== 'legacy' && assurance.authMethod !== 'screenshot';
      const jwt = await mintSession(vars.SESSION_SECRET, { id: user.id, sessionEpoch: completed.sessionEpoch }, {
        authMethod: preserve ? assurance!.authMethod : 'email_otp', authTime: preserve ? assurance!.authTime! : completed.stepUpTime,
        stepUpTime: completed.stepUpTime,
      });
      Astro.cookies.set('c4c_session', jwt, { path: '/', httpOnly: true, secure: import.meta.env.PROD, sameSite: 'lax', maxAge: 30 * 24 * 60 * 60 });
      return Astro.redirect(destination, 303);
    }
    state = 'invalid';
  }
}
---
<Base title={t(locale, 'reauth.title')} locale={locale} noindex>
  <section class="container-narrow py-16">
    <h1 class="font-display text-heading-md font-bold">{t(locale, 'reauth.title')}</h1>
    <p class="mt-3 text-ink-muted">{t(locale, 'reauth.intro')}</p>
    {state === 'invalid' && <p class="mt-5 rounded-lg border border-danger bg-surface-raised p-4 text-sm" role="alert">{t(locale, 'reauth.invalid')}</p>}
    {state === 'sent' ? (
      <form method="post" class="mt-6 space-y-4 rounded-lg border border-border bg-surface-raised p-6">
        <p role="status" class="text-sm text-ink-muted">{t(locale, 'reauth.sent')}</p>
        <input type="hidden" name="_action" value="complete" />
        <input type="hidden" name="public_id" value={publicId} />
        <label class="block"><span class="block text-sm font-semibold">{t(locale, 'security.code')}</span><input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" required class="mt-1 w-full rounded-md border border-border bg-surface px-3 py-2" /></label>
        <button class="rounded-full bg-primary px-4 py-2.5 font-semibold text-on-primary">{t(locale, 'reauth.complete')}</button>
      </form>
    ) : (
      <form method="post" class="mt-6"><input type="hidden" name="_action" value="begin" /><button class="rounded-full bg-primary px-4 py-2.5 font-semibold text-on-primary">{t(locale, 'reauth.begin')}</button></form>
    )}
  </section>
</Base>
