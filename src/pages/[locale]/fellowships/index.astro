---
// Fellowships listing: cards showing name, meeting time, location and leaders,
// ordered by the `order` field. Localized-or-en-fallback per entry.
import LibraryHeading from '../../../components/public/LibraryHeading.astro';
import DesignImage from '../../../components/ui/DesignImage.astro';
import { frontdoorCopy } from '../../../i18n/designFrontdoor';
import Base from '../../../layouts/Base.astro';
import { localePath, parseLocale } from '../../../lib/locales';
import { t } from '../../../lib/i18n';
import { listLocalized } from '../../../lib/content';

const locale = parseLocale(Astro.params.locale ?? '');
if (!locale) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const fellowships = (await listLocalized('fellowships', locale, Astro.locals.db)).sort(
  (a, b) => a.entry.data.order - b.entry.data.order,
);

// Name-list separator is locale-specific: zh uses the enumeration comma 、.
const sep = locale === 'zh' ? '、' : ', ';
---

<Base title={t(locale, 'fellowships.title')} locale={locale}>
<div class="container-content"><LibraryHeading eyebrow={frontdoorCopy(locale).fellowships} title={t(locale, 'fellowships.title')} description={t(locale, 'fellowships.intro')} image="groups" /></div>

  <div class="container-content py-10">
    {
      fellowships.length === 0 ? (
        <p class="text-ink-muted">{t(locale, 'fellowships.empty')}</p>
      ) : (
        <div class="grid gap-6 lg:grid-cols-2">
          {fellowships.map(({ entry, slug }) => (
            <a
              href={localePath(locale, `/fellowships/${slug}`)}
              class="fellowship-card"
            >
              <div class="fellowship-card-art"><DesignImage image={slug === 'family' ? 'family' : slug === 'campus' ? 'learning' : 'groups'} class="h-full w-full object-cover" /></div>
              <div class="fellowship-card-body"><h2 class="font-display text-heading-sm font-semibold">{entry.data.name}</h2>
              {entry.data.audience && <p class="mt-1 text-sm text-ink-subtle">{entry.data.audience}</p>}
              <dl class="mt-4 text-sm flex flex-col gap-1">
                <div class="flex gap-2">
                  <dt class="font-semibold shrink-0">{t(locale, 'fellowships.meets')}:</dt>
                  <dd class="text-ink-muted">{entry.data.meetingTime}</dd>
                </div>
                <div class="flex gap-2">
                  <dt class="font-semibold shrink-0">{t(locale, 'fellowships.location')}:</dt>
                  <dd class="text-ink-muted">{entry.data.location}</dd>
                </div>
                {entry.data.leaders.length > 0 && (
                  <div class="flex gap-2">
                    <dt class="font-semibold shrink-0">{t(locale, 'fellowships.leaders')}:</dt>
                    <dd class="text-ink-muted">{entry.data.leaders.map((l) => l.name).join(sep)}</dd>
                  </div>
                )}
              </dl><p class="mt-5 text-sm font-semibold text-primary">{frontdoorCopy(locale).explore} →</p></div>
            </a>
          ))}
        </div>
      )
    }
  </div>
</Base>

<style>
.fellowship-card { display:grid; grid-template-columns: 130px minmax(0,1fr); overflow:hidden; border:1px solid var(--color-border); border-radius:var(--radius-lg); background:var(--color-surface-raised); }
.fellowship-card:hover { border-color:var(--color-primary); }
.fellowship-card-body { padding:1.5rem; min-width:0; }
.fellowship-card-art { min-height:250px; }
@media(max-width:640px) { .fellowship-card { grid-template-columns:90px minmax(0,1fr); } .fellowship-card-body { padding:1rem; } }
</style>
