---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import { btn, lab, tin } from '../../lib/adminUi';
import type { EmailEnv } from '../../lib/email';
import { getPersonById } from '../../lib/db';
import { beginSignup, claimSignupSessionDelivery, completeVerifiedSignup } from '../../lib/identityAccount';
import { identityTrustedRequestContext, type IdentityAuthEnv } from '../../lib/identityAuth';
import { IDENTITY_DEVICE_COOKIE, resolveIdentityDeviceCookie } from '../../lib/identityDeviceCookie';
import { sendIdentitySignupOtp } from '../../lib/identityNotify';
import { t } from '../../lib/i18n';
import { localePath, parseLocale } from '../../lib/locales';
import { mintSession, sessionCookie } from '../../lib/session';

const locale = parseLocale(Astro.params.locale ?? '');
if (!locale) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

type SignupEnv = EmailEnv & IdentityAuthEnv & { SESSION_SECRET?: string };
const vars = env as unknown as SignupEnv;
const db = Astro.locals.rawDb;
const campus = Astro.locals.campusMode === 'campus' ? Astro.locals.campus : null;
let state: 'form' | 'code' | 'invalid' | 'review' | 'neutral' = 'form';
let operationId = '';
let publicId = '';

async function identityDeviceId(): Promise<string> {
  const resolved = await resolveIdentityDeviceCookie(vars, Astro.cookies.get(IDENTITY_DEVICE_COOKIE)?.value);
  if (resolved.replaced) {
    Astro.cookies.set(IDENTITY_DEVICE_COOKIE, resolved.cookieValue, {
      path: '/', httpOnly: true, secure: import.meta.env.PROD, sameSite: 'lax', maxAge: 365 * 24 * 60 * 60,
    });
  }
  return resolved.deviceId;
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const honeypot = String(form.get('website') ?? '').trim();
  const action = String(form.get('action') ?? 'begin');

  if (honeypot || !campus) {
    state = 'neutral';
  } else if (action === 'verify') {
    operationId = String(form.get('operation_id') ?? '');
    publicId = String(form.get('public_id') ?? '');
    const code = String(form.get('code') ?? '').trim();
    try {
      const result = await completeVerifiedSignup(db, vars, {
        campusId: campus.id, operationId, publicId, code, source: 'web',
      });
      if (result.status === 'review') {
        state = 'review';
      } else if (result.status === 'authenticated' && vars.SESSION_SECRET) {
        const deliveryClaimed = await claimSignupSessionDelivery(db, vars, {
          campusId: campus.id, operationId, publicId, code, source: 'web',
        });
        if (!deliveryClaimed) {
          state = 'invalid';
        } else {
          const person = await getPersonById(db, result.personId);
          if (person?.active === 1) {
            const jwt = await mintSession(vars.SESSION_SECRET, {
              id: person.id, sessionEpoch: deliveryClaimed.sessionEpoch,
            }, { authMethod: 'email_otp' });
            const landing = Astro.locals.modules.has('portal') ? 'my/opportunities' : Astro.locals.modules.has('serve') ? 'my' : 'profile';
            return new Response(null, {
              status: 303,
              headers: {
                location: localePath(locale, `/${landing}`),
                'set-cookie': sessionCookie(jwt, import.meta.env.PROD),
              },
            });
          }
          state = 'invalid';
        }
      } else {
        state = 'invalid';
      }
    } catch (error) {
      console.error('verified signup completion failed', error);
      state = 'invalid';
    }
  } else {
    const firstName = String(form.get('first_name') ?? '').trim();
    const lastName = String(form.get('last_name') ?? '').trim();
    const email = String(form.get('email') ?? '').trim();
    try {
      const begun = await beginSignup(db, vars, {
        campusId: campus.id,
        email,
        displayName: [firstName, lastName].filter(Boolean).join(' '),
        requestContext: identityTrustedRequestContext(Astro.request.headers, await identityDeviceId()),
        source: 'web',
      });
      operationId = begun.public.operationId;
      publicId = begun.delivery.publicId;
      await sendIdentitySignupOtp(vars, db, begun.delivery, locale);
      state = 'code';
    } catch (error) {
      // Keep account existence, throttling, and availability indistinguishable.
      console.error('verified signup start failed', error);
      state = 'neutral';
    }
  }
}
---

<Base title={t(locale, 'signup.title')} locale={locale} noindex>
  <section class="container-narrow py-16">
    {state === 'review' ? (
      <div class="rounded-lg border border-border bg-surface-raised p-6" role="status">
        <h1 class="font-display text-heading-sm font-semibold">{t(locale, 'signup.reviewTitle')}</h1>
        <p class="mt-3 text-ink-muted">{t(locale, 'signup.reviewBody')}</p>
      </div>
    ) : state === 'code' || state === 'invalid' ? (
      <div class="rounded-lg border border-border bg-surface-raised p-6">
        <h1 class="font-display text-heading-sm font-semibold">{t(locale, 'signup.codeSentTitle')}</h1>
        <p class="mt-3 text-ink-muted">{t(locale, 'signup.codeSentBody')}</p>
        {state === 'invalid' && <p class="mt-3 text-sm text-danger" role="alert">{t(locale, 'signup.invalidCode')}</p>}
        <form method="post" class="mt-6 space-y-4">
          <input type="hidden" name="action" value="verify" />
          <input type="hidden" name="operation_id" value={operationId} />
          <input type="hidden" name="public_id" value={publicId} />
          <div aria-hidden="true" style="position:absolute;left:-9999px" tabindex="-1">
            <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>
          <label class="block">
            <span class={lab}>{t(locale, 'signup.codeLabel')}</span>
            <input name="code" required inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" class={tin} />
          </label>
          <button type="submit" class={`${btn} w-full justify-center`}>{t(locale, 'signup.verify')}</button>
        </form>
      </div>
    ) : state === 'neutral' ? (
      <div class="rounded-lg border border-border bg-surface-raised p-6" role="status">
        <h1 class="font-display text-heading-sm font-semibold">{t(locale, 'signup.codeSentTitle')}</h1>
        <p class="mt-3 text-ink-muted">{t(locale, 'signup.codeSentBody')}</p>
      </div>
    ) : (
      <>
        <h1 class="font-display text-heading-md font-bold">{t(locale, 'signup.title')}</h1>
        <p class="mt-3 text-ink-muted">{t(locale, 'signup.intro')}</p>
        <form method="post" class="mt-6 space-y-4">
          <input type="hidden" name="action" value="begin" />
          <div aria-hidden="true" style="position:absolute;left:-9999px" tabindex="-1">
            <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>
          <label class="block"><span class={lab}>{t(locale, 'signup.firstName')}</span><input name="first_name" required autocomplete="given-name" class={tin} /></label>
          <label class="block"><span class={lab}>{t(locale, 'signup.lastName')}</span><input name="last_name" autocomplete="family-name" class={tin} /></label>
          <label class="block">
            <span class={lab}>{t(locale, 'signup.emailLabel')}</span>
            <input type="email" name="email" required autocomplete="email" placeholder={t(locale, 'signup.emailPlaceholder')} class={tin} />
          </label>
          <button type="submit" class={`${btn} w-full justify-center`}>{t(locale, 'signup.submit')}</button>
        </form>
        <p class="mt-4 text-sm text-ink-muted">
          {t(locale, 'signup.haveAccount')}{' '}
          <a href={localePath(locale, '/signin')} class="font-semibold text-primary hover:underline">{t(locale, 'signup.signIn')}</a>
        </p>
      </>
    )}
  </section>
</Base>
