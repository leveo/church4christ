---
// Plan-a-visit page: renders the `pages/visit` content entry (en-fallback aware).
import { render } from 'astro:content';
import ContentPage from '../../components/ContentPage.astro';
import { parseLocale } from '../../lib/locales';
import { getLocalized } from '../../lib/content';
import { getSiteIdentity } from '../../lib/settings';
import { t } from '../../lib/i18n';

const locale = parseLocale(Astro.params.locale ?? '');
if (!locale) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const found = await getLocalized('pages', 'visit', locale, Astro.locals.db);
if (!found) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
const { entry, translated } = found;
const { Content } = await render(entry);
let identity: Awaited<ReturnType<typeof getSiteIdentity>> | undefined;
try {
  identity = await getSiteIdentity(Astro.locals.db, locale);
} catch {
  // The welcome and visit guidance remain available if contact details cannot be read.
}
const mapUrl = identity?.mapUrl && /^https?:\/\//i.test(identity.mapUrl) ? identity.mapUrl : '';
---

<ContentPage
  title={entry.data.title}
  description={entry.data.description}
  locale={locale}
  translated={translated}
>
  {(identity?.serviceTimes || identity?.address || identity?.email || identity?.phone) && (
    <Fragment slot="before">
      <dl class="grid gap-6 rounded-lg border border-border bg-surface-raised p-6 sm:grid-cols-2">
        {identity.serviceTimes && (
          <div>
            <dt class="font-display font-semibold">{t(locale, 'footer.serviceTimes')}</dt>
            <dd class="mt-2 whitespace-pre-line text-ink-muted">{identity.serviceTimes}</dd>
          </div>
        )}
        {identity.address && (
          <div>
            <dt class="font-display font-semibold">{t(locale, 'footer.address')}</dt>
            <dd class="mt-2 whitespace-pre-line text-ink-muted">
              {mapUrl ? <a href={mapUrl} class="underline underline-offset-2" target="_blank" rel="noopener noreferrer">{identity.address}</a> : identity.address}
            </dd>
          </div>
        )}
        {(identity.email || identity.phone) && (
          <div>
            <dt class="font-display font-semibold">{t(locale, 'footer.contact')}</dt>
            <dd class="mt-2 text-ink-muted">
              {identity.phone && <p>{identity.phone}</p>}
              {identity.email && <a href={`mailto:${identity.email}`} class="underline underline-offset-2">{identity.email}</a>}
            </dd>
          </div>
        )}
      </dl>
    </Fragment>
  )}
  <Content />
</ContentPage>
