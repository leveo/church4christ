---
import { env } from 'cloudflare:workers';
import Base from '../../../layouts/Base.astro';
import { btn } from '../../../lib/adminUi';
import type { IdentityRecoveryKeyEnv } from '../../../lib/identityRecoveryKey';
import { peekIdentityRecoveryVeto, vetoIdentityRecovery } from '../../../lib/identityRecovery';
import { t } from '../../../lib/i18n';
import { parseLocale } from '../../../lib/locales';

Astro.response.headers.set('referrer-policy', 'no-referrer');
Astro.response.headers.set('cache-control', 'no-store');
const locale = parseLocale(Astro.params.locale ?? '');
if (!locale) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
const token = Astro.params.token ?? '';
const vars = env as unknown as IdentityRecoveryKeyEnv;
const db = Astro.locals.rawDb;
let state: 'confirm' | 'done' | 'invalid' = 'invalid';
if (Astro.request.method === 'POST') {
  state = (await vetoIdentityRecovery(db, vars, token, new Date().toISOString().slice(0, 19).replace('T', ' '))).vetoed ? 'done' : 'invalid';
} else {
  state = (await peekIdentityRecoveryVeto(db, vars, token, new Date().toISOString().slice(0, 19).replace('T', ' '))).valid ? 'confirm' : 'invalid';
}
---

<Base title={t(locale, 'recovery.veto.title')} locale={locale} noindex privateMetadata>
  <section class="container-narrow py-16">
    <div class="rounded-lg border border-border bg-surface-raised p-6">
      <h1 class="font-display text-heading-sm font-semibold">{t(locale, 'recovery.veto.title')}</h1>
      {state === 'confirm' ? (
        <><p class="mt-3 text-ink-muted">{t(locale, 'recovery.veto.body')}</p><form method="post" class="mt-6"><button type="submit" class={`${btn} w-full justify-center`}>{t(locale, 'recovery.veto.submit')}</button></form></>
      ) : <p class="mt-3 text-ink-muted" role="status">{t(locale, state === 'done' ? 'recovery.veto.done' : 'recovery.veto.invalid')}</p>}
    </div>
  </section>
</Base>
