---
// A specific dated bulletin. The date param must be a real YYYY-MM-DD; anything
// else 404s. An optional ?service=<id> picks which service type's bulletin to
// show when a date has more than one; it defaults to the first (by type sort).
// A no-match date (or DB hiccup) 404s.
import Base from '../../../layouts/Base.astro';
import BulletinView from '../../../components/BulletinView.astro';
import LibraryHeading from '../../../components/public/LibraryHeading.astro';
import PrintableReader from '../../../components/public/PrintableReader.astro';
import { publicCopy } from '../../../i18n/designPublic';
import { localePath, parseLocale } from '../../../lib/locales';
import { t } from '../../../lib/i18n';
import { formatDate, isValidDateStr } from '../../../lib/dates';
import {
  listBulletinServicesForDate,
  getBulletin,
  getBulletinAnnouncements,
  bulletinRoster,
  type BulletinRow,
  type BulletinAnnouncementRow,
  type RosterGroup,
} from '../../../lib/publicDb';

const locale = parseLocale(Astro.params.locale ?? '');
if (!locale) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const date = Astro.params.date ?? '';
if (!isValidDateStr(date)) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const serviceParam = Number(Astro.url.searchParams.get('service')) || null;

let services: { service_type_id: number; serviceTypeName: string }[] = [];
let bulletin: BulletinRow | null = null;
let announcements: BulletinAnnouncementRow[] = [];
let roster: RosterGroup[] = [];
try {
  const db = Astro.locals.db;
  services = await listBulletinServicesForDate(db, date, locale);
  if (services.length > 0) {
    const chosen = services.find((s) => s.service_type_id === serviceParam)?.service_type_id ?? services[0].service_type_id;
    bulletin = await getBulletin(db, chosen, date, locale);
    if (bulletin) {
      [announcements, roster] = await Promise.all([
        getBulletinAnnouncements(db, bulletin.id),
        bulletinRoster(db, bulletin.service_type_id, bulletin.bulletin_date, locale),
      ]);
    }
  }
} catch (err) {
  console.error('bulletin date: load failed', err);
}

if (!bulletin) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
const selectedId = bulletin.service_type_id;

const copy = publicCopy(locale);
---

<Base title={`${t(locale, 'bulletin.title')} · ${formatDate(date, locale)}`} locale={locale}>
  <div class="container-wide dated-bulletin">
    <LibraryHeading eyebrow={copy.bulletinEyebrow} title={t(locale, 'bulletin.title')} description={copy.bulletinDescription} />
    {services.length > 1 && <nav class="dated-service-nav" aria-label={t(locale, 'bulletin.serviceLabel')}>
      {services.map(s => <a href={`${localePath(locale, `/bulletin/${date}`)}?service=${s.service_type_id}`} aria-current={s.service_type_id === selectedId ? 'page' : undefined}>{s.serviceTypeName}</a>)}
    </nav>}
    <PrintableReader locale={locale} title={t(locale, 'bulletin.title')} backHref={localePath(locale, '/bulletin')} backLabel={t(locale, 'bulletin.back')}>
      <BulletinView bulletin={bulletin} announcements={announcements} roster={roster} locale={locale} />
    </PrintableReader>
  </div>
</Base>
<style>
  .dated-bulletin { max-width: 960px; }
  .dated-service-nav { display: flex; flex-wrap: wrap; gap: .5rem; padding-bottom: 1.5rem; }
  .dated-service-nav a { display: inline-flex; align-items: center; min-height: 44px; padding: .65rem 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); font-size: .85rem; }
  .dated-service-nav a[aria-current], .dated-service-nav a:hover { border-color: var(--color-primary); background: var(--color-primary-soft); color: var(--color-on-primary-soft); }
  @media print { .dated-service-nav { display: none; } }
</style>
