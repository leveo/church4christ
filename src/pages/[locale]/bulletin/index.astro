---
// Bulletin landing: the latest published bulletin for each service type, shown
// with a bookmarkable service switcher and a printable reader.
// Year-grouped archive alongside. Reads fail soft to empty.
import Base from '../../../layouts/Base.astro';
import BulletinView from '../../../components/BulletinView.astro';
import LibraryHeading from '../../../components/public/LibraryHeading.astro';
import PrintableReader from '../../../components/public/PrintableReader.astro';
import Icon from '../../../components/ui/Icon.astro';
import { publicCopy } from '../../../i18n/designPublic';
import { localePath, parseLocale } from '../../../lib/locales';
import { t } from '../../../lib/i18n';
import { formatDate } from '../../../lib/dates';
import {
  latestBulletins,
  listBulletinDates,
  getBulletinAnnouncements,
  bulletinRoster,
  type BulletinRow,
  type BulletinAnnouncementRow,
  type BulletinDateRow,
  type RosterGroup,
} from '../../../lib/publicDb';

const locale = parseLocale(Astro.params.locale ?? '');
if (!locale) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

interface Entry {
  bulletin: BulletinRow;
  announcements: BulletinAnnouncementRow[];
  roster: RosterGroup[];
}

let entries: Entry[] = [];
let dates: BulletinDateRow[] = [];
try {
  const db = Astro.locals.db;
  const [bulletins, archive] = await Promise.all([latestBulletins(db, locale), listBulletinDates(db, locale)]);
  dates = archive;
  entries = await Promise.all(
    bulletins.map(async (bulletin) => ({
      bulletin,
      announcements: await getBulletinAnnouncements(db, bulletin.id),
      roster: await bulletinRoster(db, bulletin.service_type_id, bulletin.bulletin_date, locale),
    })),
  );
} catch (err) {
  console.error('bulletin index: load failed', err);
}

// Group the archive by year (newest first) for a collapsible past-bulletins nav.
const byYear = new Map<string, BulletinDateRow[]>();
for (const d of dates) {
  const year = d.bulletin_date.slice(0, 4);
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(d);
}
const currentYear = new Date().getFullYear().toString();

const copy = publicCopy(locale);
const requestedService = Number(Astro.url.searchParams.get('service'));
const selected = entries.find(({ bulletin }) => bulletin.service_type_id === requestedService) ?? entries[0];
---

<Base title={t(locale, 'bulletin.title')} locale={locale}>
  <div class="container-wide bulletin-library">
    <LibraryHeading eyebrow={copy.bulletinEyebrow} title={t(locale, 'bulletin.title')} description={copy.bulletinDescription} image="worship" />
    {entries.length > 1 && <nav class="bulletin-services" aria-label={t(locale, 'bulletin.serviceLabel')}>
      {entries.map(({ bulletin }) => <a href={`${localePath(locale, '/bulletin')}?service=${bulletin.service_type_id}`} aria-current={selected.bulletin.service_type_id === bulletin.service_type_id ? 'page' : undefined}><span>{bulletin.serviceTypeName}</span><time datetime={bulletin.bulletin_date}>{formatDate(bulletin.bulletin_date, locale)}</time></a>)}
    </nav>}
    <PrintableReader locale={locale} title={copy.latestEdition} print={Boolean(selected)} hasArchive={byYear.size > 0}>
      {selected ? <BulletinView bulletin={selected.bulletin} announcements={selected.announcements} roster={selected.roster} locale={locale} /> : <div class="bulletin-empty"><Icon name="book" size={34}/><h2>{copy.bulletinEmptyTitle}</h2><p>{t(locale, 'bulletin.empty')}</p><a class="action-secondary" href={localePath(locale, '/visit')}>{t(locale, 'nav.visit')}<Icon name="arrow" size={16}/></a></div>}
      {byYear.size > 0 && <nav slot="archive" aria-label={t(locale, 'bulletin.archive')}>
        <h2>{t(locale, 'bulletin.archive')}</h2><p>{copy.archiveNote}</p>
        {[...byYear.entries()].map(([year, rows], index) => <details open={year === currentYear || index === 0}>
          <summary>{t(locale, 'sermons.yearLabel', { year })}</summary>
          <ul>{rows.map(d => <li><a href={`${localePath(locale, `/bulletin/${d.bulletin_date}`)}?service=${d.service_type_id}`}><time datetime={d.bulletin_date}>{formatDate(d.bulletin_date, locale)}</time><span class="archive-service">{d.serviceTypeName}</span></a></li>)}</ul>
        </details>)}
      </nav>}
    </PrintableReader>
  </div>
</Base>
<style>
  .bulletin-services { display: flex; flex-wrap: wrap; gap: .75rem; padding-bottom: 1.5rem; }
  .bulletin-services a { min-height: 64px; display: grid; gap: .3rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: .8rem 1.1rem; background: var(--color-surface-raised); }
  .bulletin-services a[aria-current] { border-color: var(--color-primary); background: var(--color-primary-soft); color: var(--color-on-primary-soft); }
  .bulletin-services a:hover { border-color: var(--color-primary); }
  .bulletin-services span { font-size: .9rem; font-weight: 600; }
  .bulletin-services time { font-size: .75rem; color: var(--color-ink-muted); }
  .archive-service { display: block; font-size: .72rem; margin-top: .2rem; }
  .bulletin-empty { min-height: 260px; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 1.25rem; }
  .bulletin-empty h2 { font-family: var(--font-display); font-size: 2rem; }
  .bulletin-empty p { color: var(--color-ink-muted); max-width: 34rem; line-height: 1.8; }
  @media print { .bulletin-services { display: none; } }
</style>
