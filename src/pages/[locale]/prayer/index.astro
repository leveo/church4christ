---
// Prayer & Care landing: a prayer-meeting info card, the latest published
// prayer sheet, and a year-grouped archive. Reads fail soft to empty.
import Base from '../../../layouts/Base.astro';
import PrayerSheetView from '../../../components/PrayerSheetView.astro';
import LibraryHeading from '../../../components/public/LibraryHeading.astro';
import PrintableReader from '../../../components/public/PrintableReader.astro';
import Icon from '../../../components/ui/Icon.astro';
import { publicCopy } from '../../../i18n/designPublic';
import { localePath, parseLocale } from '../../../lib/locales';
import { t } from '../../../lib/i18n';
import { formatDate } from '../../../lib/dates';
import { getSiteIdentity } from '../../../lib/settings';
import { latestPrayerSheet, listPrayerSheetDates, type PrayerSheetRow } from '../../../lib/publicDb';

const locale = parseLocale(Astro.params.locale ?? '');
if (!locale) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

let sheet: PrayerSheetRow | null = null;
let dates: string[] = [];
let email = '';
try {
  const db = Astro.locals.db;
  const [s, d, identity] = await Promise.all([
    latestPrayerSheet(db, locale),
    listPrayerSheetDates(db, locale),
    getSiteIdentity(db, locale),
  ]);
  sheet = s;
  dates = d;
  email = identity.email;
} catch (err) {
  console.error('prayer index: load failed', err);
}

const byYear = new Map<string, string[]>();
for (const d of dates) {
  const year = d.slice(0, 4);
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(d);
}
const currentYear = new Date().getFullYear().toString();

const copy = publicCopy(locale);
---

<Base title={t(locale, 'prayer.title')} locale={locale}>
  <div class="container-wide prayer-library">
    <LibraryHeading eyebrow={copy.prayerEyebrow} title={t(locale, 'prayer.title')} description={copy.prayerDescription} image="kiosk" />
    <section class="prayer-invitation">
      <Icon name="leaf" size={26}/><div><h2>{copy.prayerInvitation}</h2><p>{copy.prayerInvitationBody}</p></div>
      {email && <a href={`mailto:${email}`}><span>{t(locale, 'footer.contact')}</span>{email}</a>}
    </section>
    <PrintableReader locale={locale} title={copy.latestEdition} print={Boolean(sheet)} hasArchive={byYear.size > 0}>
      {sheet ? <PrayerSheetView sheet={sheet} locale={locale} /> : <div class="prayer-empty"><Icon name="serve" size={32}/><h2>{copy.prayerEmptyTitle}</h2><p>{t(locale, 'prayer.empty')}</p><a class="action-secondary" href={localePath(locale, '/visit')}>{t(locale, 'nav.visit')}<Icon name="arrow" size={16}/></a></div>}
      {byYear.size > 0 && <nav slot="archive" aria-label={t(locale, 'prayer.archive')}>
        <h2>{t(locale, 'prayer.archive')}</h2><p>{copy.archiveNote}</p>
        {[...byYear.entries()].map(([year, rows], index) => <details open={year === currentYear || index === 0}>
          <summary>{t(locale, 'sermons.yearLabel', { year })}</summary>
          <ul>{rows.map(d => <li><a href={localePath(locale, `/prayer/${d}`)} aria-current={sheet?.sheet_date === d ? 'page' : undefined}><time datetime={d}>{formatDate(d, locale)}</time></a></li>)}</ul>
        </details>)}
      </nav>}
    </PrintableReader>
  </div>
</Base>
<style>
  .prayer-invitation { display: flex; align-items: flex-start; gap: 1.2rem; margin-bottom: 2rem; padding: 1.5rem; background: var(--color-primary-soft); color: var(--color-on-primary-soft); border-radius: var(--radius-lg); }
  .prayer-invitation > :global(svg) { flex-shrink: 0; margin-top: .2rem; }
  .prayer-invitation > div { flex: 1; }
  .prayer-invitation h2 { font-family: var(--font-display); font-size: 1.4rem; }
  .prayer-invitation p { margin-top: .6rem; line-height: 1.8; font-size: .9rem; max-width: 45rem; }
  .prayer-invitation a { padding-top: .25rem; font-size: .8rem; text-decoration: underline; text-underline-offset: .2rem; overflow-wrap: anywhere; }
  .prayer-invitation a span { display: block; font-weight: 600; margin-bottom: .4rem; }
  .prayer-empty { min-height: 260px; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 1.25rem; }
  .prayer-empty h2 { font-family: var(--font-display); font-size: 2rem; }
  .prayer-empty p { color: var(--color-ink-muted); line-height: 1.8; }
  @media (max-width: 700px) { .prayer-invitation { flex-wrap: wrap; } .prayer-invitation > div { flex-basis: calc(100% - 3rem); } .prayer-invitation a { margin-left: 2.8rem; } }
  @media print { .prayer-invitation { display: none; } }
</style>
