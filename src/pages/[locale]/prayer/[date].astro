---
// A specific dated prayer sheet. The date param must be a real YYYY-MM-DD;
// anything else, or a date with no published sheet, 404s.
import Base from '../../../layouts/Base.astro';
import PrayerSheetView from '../../../components/PrayerSheetView.astro';
import LibraryHeading from '../../../components/public/LibraryHeading.astro';
import PrintableReader from '../../../components/public/PrintableReader.astro';
import { publicCopy } from '../../../i18n/designPublic';
import { localePath, parseLocale } from '../../../lib/locales';
import { t } from '../../../lib/i18n';
import { formatDate, isValidDateStr } from '../../../lib/dates';
import { getPrayerSheet, type PrayerSheetRow } from '../../../lib/publicDb';

const locale = parseLocale(Astro.params.locale ?? '');
if (!locale) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const date = Astro.params.date ?? '';
if (!isValidDateStr(date)) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

let sheet: PrayerSheetRow | null = null;
try {
  const db = Astro.locals.db;
  sheet = await getPrayerSheet(db, date, locale);
} catch (err) {
  console.error('prayer date: load failed', err);
}

if (!sheet) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const copy = publicCopy(locale);
---

<Base title={`${t(locale, 'prayer.sheetTitle')} · ${formatDate(date, locale)}`} locale={locale}>
  <div class="container-wide dated-prayer">
    <LibraryHeading eyebrow={copy.prayerEyebrow} title={t(locale, 'prayer.title')} description={copy.prayerDescription} />
    <PrintableReader locale={locale} title={t(locale, 'prayer.sheetTitle')} backHref={localePath(locale, '/prayer')} backLabel={t(locale, 'prayer.back')}>
      <PrayerSheetView sheet={sheet} locale={locale} />
    </PrintableReader>
  </div>
</Base>
<style>.dated-prayer { max-width: 900px; }</style>
